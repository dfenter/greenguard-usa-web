---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Card from '../components/ui/Card.astro';
import CtaBand from '../components/ui/CtaBand.astro';

// NOTE (content-engine lane): this domain cannot run the cart checkout
// serverless API. Purchase CTAs link to the www shop, which owns checkout.
const ORDER_BASE = 'https://www.greenguard-usa.com/shop';

const products = [
  {
    id: 'biogents-co2-trap',
    name: 'Biogents BG-Mosquitaire CO₂ Trap',
    tagline: 'The scientific standard in outdoor mosquito control',
    badge: 'Best Seller',
    price: 299.99,
    originalPrice: null,
    image: '/images/prod-biogents-co2.jpg',
    desc: 'CO₂-powered attraction captures host-seeking mosquitoes 24/7. No pesticides. Up to quarter-acre coverage.',
    pills: ['Up to 6,500 sq ft coverage', '24/7 silent operation', 'Regulator included'],
  },
  {
    id: 'all-in-one-bundle',
    name: 'All-in-One Starter Bundle',
    tagline: 'Everything you need. Day-one ready.',
    badge: 'Most Complete',
    price: 619.99,
    originalPrice: 649.97,
    image: '/images/prod-all-in-one-bundle.jpg',
    desc: 'CO₂ trap, timer, 20 lb tank, and bait pack in one order. Add a CO₂ fill and start the same day.',
    pills: ['Save $29.98', 'Includes CO₂ tank', 'Timer included'],
    featured: true,
  },
  {
    id: 'mosqitter-grand',
    name: 'Mosqitter Grand CO₂ Trap',
    tagline: 'Stainless steel. App-connected. Built to last.',
    badge: 'Premium',
    price: 1849.99,
    originalPrice: null,
    image: '/images/mosqitterGrand1.webp',
    desc: 'Professional-grade stainless steel with smartphone monitoring and one-acre coverage per unit.',
    pills: ['Up to 2-acre coverage', 'Bluetooth app', 'Stainless steel'],
  },
  {
    id: 'biogents-non-co2-trap',
    name: 'BG-Mosquitaire (No CO₂)',
    tagline: 'Heat and scent. No tank required.',
    badge: 'No Tank Needed',
    price: 199.99,
    originalPrice: null,
    image: '/images/mosquitairenoco2.webp',
    desc: 'Heat and scent-based attraction for indoor spaces, covered patios, and sheltered outdoor areas.',
    pills: ['No CO₂ tank', 'Indoor / outdoor', 'Low maintenance'],
  },
  {
    id: 'biogents-co2-timer',
    name: 'Biogents CO₂ Tank Timer',
    tagline: 'Cut CO₂ use by 50%. Extend your tank life.',
    badge: 'Recommended Add-on',
    price: 109.99,
    originalPrice: null,
    image: '/images/prod-co2-timer.png',
    desc: 'Programmable timer pauses CO₂ during low-activity hours. Reduces tank consumption by up to 50%.',
    pills: ['Up to 75% CO₂ savings', 'Battery-powered', 'Controls up to 5 traps'],
    outOfStock: true,
  },
  {
    id: 'co2-tank-20lb',
    name: 'CO₂ Tank (20 lb Empty Cylinder)',
    tagline: 'DOT-certified. CGA-320 valve. Refill anywhere.',
    badge: 'Accessory',
    price: 239.99,
    originalPrice: null,
    image: '/images/tank.jpeg',
    desc: 'DOT-certified aluminum cylinder. Sold empty for local refill. Lasts 20 to 27 days per trap.',
    pills: ['DOT-certified', 'CGA-320 valve', '20 to 27 day runtime'],
  },
];

const featured = products.find(p => p.featured)!;
const grid = products.filter(p => !p.featured);
---

<Base
  title="Shop Mosquito Control Equipment | GreenGuard USA"
  description="Buy Biogents CO₂ traps, Mosqitter Grand, timers, tanks, and accessories. Professional mosquito control equipment used by GreenGuard USA in Austin, TX."
>

  <!-- ============ HERO ============ -->
  <Section variant="linen" class="hairline-b">
    <div class="max-w-3xl">
      <Eyebrow>Professional Equipment &middot; Austin, TX</Eyebrow>
      <h1 class="mt-5 text-ink" style="font-size: clamp(2.4rem, 5.5vw, 4rem); max-width: 15ch;">
        Serious equipment. <em class="italic" style="color: var(--pine); font-weight: 340;">Zero</em> pesticides.
      </h1>
      <p class="mt-6 text-soft" style="font-size: 1.1rem; max-width: 34rem; line-height: 1.75;">
        The same CO₂ trap systems GreenGuard USA installs and maintains across Austin. Backed by science, built to last, shipped from Texas.
      </p>
      <ul class="flex flex-wrap gap-x-8 gap-y-3 mt-8 list-none m-0 p-0">
        {[
          ['M12 3 4 7v5c0 4.5 3.2 7.9 8 9 4.8-1.1 8-4.5 8-9V7l-8-4Z', 'Secure checkout'],
          ['M3 8h13v8H3zM16 11h4l1 2v3h-5M6 19a1.5 1.5 0 1 0 0-.01M18 19a1.5 1.5 0 1 0 0-.01', 'Ships from Austin, TX'],
          ['M12 3c-4 4-7 6.5-7 10a7 7 0 0 0 14 0c0-3.5-3-6-7-10Z', 'Pesticide-free technology'],
          ['M4 12.5 9.5 18 20 6.5', 'Free assessment included'],
        ].map(([d, label]) => (
          <li class="inline-flex items-center gap-2.5 text-sm font-medium text-ink/80">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--brass)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={d} />
            </svg>
            {label}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- ============ FEATURED PRODUCT ============ -->
  <Section>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center reveal">
      <div class="lg:col-span-6">
        <div class="photo-frame relative bg-linen" style="aspect-ratio: 4 / 3.4;">
          <img
            src={featured.image}
            alt={featured.name}
            class="w-full h-full object-cover"
            loading="eager"
          />
          <span class="absolute top-5 left-5 text-[0.68rem] font-semibold uppercase rounded-full px-3 py-1" style="letter-spacing: 0.12em; background: var(--brass); color: #fff;">
            {featured.badge}
          </span>
        </div>
      </div>
      <div class="lg:col-span-6">
        <Eyebrow>{featured.tagline}</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.6vw, 2.7rem); font-weight: 420;">{featured.name}</h2>
        <p class="mt-4 text-soft" style="max-width: 32rem;">{featured.desc}</p>
        <div class="flex flex-wrap gap-2 mt-5">
          {featured.pills.map(p => (
            <span class="text-xs font-medium rounded-full px-3 py-1.5 text-ink/70" style="border: 1px solid rgba(30,43,35,.16); background: var(--paper-alt);">{p}</span>
          ))}
        </div>
        <p class="mt-6 flex items-baseline gap-3 flex-wrap">
          <span class="font-display" style="font-size: 2.4rem; font-weight: 380; color: var(--pine);">${featured.price.toFixed(2)}</span>
          {featured.originalPrice && (
            <span class="text-soft line-through" style="font-size: 1.1rem;">${featured.originalPrice.toFixed(2)}</span>
          )}
          {featured.originalPrice && (
            <span class="text-xs font-semibold uppercase rounded-full px-2.5 py-1" style="letter-spacing: 0.08em; color: var(--brass-ink); border: 1px solid var(--brass);">
              Save ${(featured.originalPrice - featured.price).toFixed(2)}
            </span>
          )}
        </p>
        <div class="flex flex-wrap items-center gap-4 mt-7">
          <Btn href={`${ORDER_BASE}/${featured.id}`}>Order on greenguard-usa.com</Btn>
          <Btn href={`/shop/${featured.id}`} variant="ghost">View Details</Btn>
        </div>
      </div>
    </div>
  </Section>

  <!-- ============ PRODUCT GRID ============ -->
  <Section variant="linen">
    <div class="max-w-xl reveal">
      <Eyebrow>The Full Collection</Eyebrow>
      <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.8vw, 2.7rem); font-weight: 400;">
        Every tool in the arsenal
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12" data-stagger>
      {grid.map(p => (
        <article class="reveal h-full">
          <Card tone="ivory" class="h-full flex flex-col !p-0 overflow-hidden">
            <a href={`/shop/${p.id}`} class="block relative overflow-hidden group" style="aspect-ratio: 4 / 3; background: var(--paper-alt);">
              <img
                src={p.image}
                alt={p.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                loading="lazy"
              />
              <span class="absolute top-4 left-4 text-[0.65rem] font-semibold uppercase rounded-full px-2.5 py-1 bg-ivory text-ink/70" style="letter-spacing: 0.1em; border: 1px solid rgba(30,43,35,.12);">{p.badge}</span>
            </a>
            <div class="p-6 flex flex-col flex-1">
              <p class="eyebrow eyebrow--plain !text-xs">{p.tagline}</p>
              <h3 class="font-display mt-2" style="font-size: 1.2rem; font-weight: 460; line-height: 1.25;">
                <a href={`/shop/${p.id}`} class="no-underline text-ink hover:text-pine">{p.name}</a>
              </h3>
              <p class="text-sm text-soft mt-2.5 flex-1" style="line-height: 1.6;">{p.desc}</p>
              <div class="flex flex-wrap gap-1.5 mt-4">
                {p.pills.map(pill => (
                  <span class="text-[0.72rem] font-medium rounded-full px-2.5 py-1 text-ink/60" style="border: 1px solid rgba(30,43,35,.14);">{pill}</span>
                ))}
              </div>
              <p class="mt-4 flex items-baseline gap-2">
                <span class="font-display" style="font-size: 1.6rem; font-weight: 400; color: var(--pine);">${p.price.toFixed(2)}</span>
                {p.originalPrice && (
                  <span class="text-sm text-soft line-through">${p.originalPrice.toFixed(2)}</span>
                )}
              </p>
              <div class="flex flex-wrap gap-2.5 mt-4">
                {p.outOfStock ? (
                  <span class="btn btn-ghost flex-1 justify-center !text-sm opacity-50 cursor-not-allowed" aria-disabled="true">Out of Stock</span>
                ) : (
                  <Btn href={`${ORDER_BASE}/${p.id}`} class="flex-1 !text-sm !px-4">Order on greenguard-usa.com</Btn>
                )}
                <Btn href={`/shop/${p.id}`} variant="ghost" class="!text-sm !px-4">Details</Btn>
              </div>
            </div>
          </Card>
        </article>
      ))}
    </div>
  </Section>

  <!-- ============ COMPARISON TABLE ============ -->
  <Section>
    <div class="text-center max-w-2xl mx-auto reveal">
      <Eyebrow class="justify-center">Quick Comparison</Eyebrow>
      <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 400;">
        Trap models side by side
      </h2>
    </div>
    <div class="relative mt-10 reveal">
    <div class="overflow-x-auto rounded-2xl" style="border: 1px solid rgba(30,43,35,.1);">
      <table class="w-full text-sm" style="border-collapse: collapse; min-width: 720px;">
        <thead>
          <tr class="bg-linen">
            <th class="text-left px-5 py-4 font-semibold text-ink/70 text-xs uppercase" style="letter-spacing: 0.08em; width: 20%;">Feature</th>
            <th class="px-4 py-4 text-center font-display text-ink" style="font-size: 0.95rem;">BG-Mosquitaire CO₂</th>
            <th class="px-4 py-4 text-center font-display" style="font-size: 0.95rem; color: var(--brass-ink);">All-in-One Bundle</th>
            <th class="px-4 py-4 text-center font-display text-ink" style="font-size: 0.95rem;">Mosqitter Grand</th>
            <th class="px-4 py-4 text-center font-display text-ink" style="font-size: 0.95rem;">BG No-CO₂</th>
          </tr>
        </thead>
        <tbody>
          {[
            { label: 'Price', bg: '$299.99', bundle: '$619.99', grand: '$1,849.99', noco2: '$199.99' },
            { label: 'Coverage', bg: 'Up to 6,500 sq ft', bundle: 'Up to 6,500 sq ft', grand: 'Up to 2 acres', noco2: 'Indoor/covered areas' },
            { label: 'CO₂ required', bg: 'Yes', bundle: 'Yes (tank included)', grand: 'Yes', noco2: 'No' },
            { label: 'App/Bluetooth', bg: 'No', bundle: 'No', grand: 'Yes', noco2: 'No' },
            { label: 'Best use', bg: 'Standard yard', bundle: 'Complete starter kit', grand: 'Large/premium property', noco2: 'Patio/porch/garage' },
            { label: 'Works with GG delivery', bg: 'Yes', bundle: 'Yes', grand: 'Yes', noco2: 'N/A (no CO₂ needed)' },
          ].map((row) => (
            <tr class="hairline-t">
              <td class="px-5 py-3.5 font-semibold text-ink/70 text-xs">{row.label}</td>
              <td class="px-4 py-3.5 text-center text-soft">{row.bg}</td>
              <td class="px-4 py-3.5 text-center text-ink font-medium bg-linen/50">{row.bundle}</td>
              <td class="px-4 py-3.5 text-center text-soft">{row.grand}</td>
              <td class="px-4 py-3.5 text-center text-soft">{row.noco2}</td>
            </tr>
          ))}
          <tr class="hairline-t bg-linen/60">
            <td class="px-5 py-3.5"></td>
            <td class="px-4 py-3.5 text-center"><a href="/shop/biogents-co2-trap" class="text-xs font-semibold underline" style="color: var(--pine);">View</a></td>
            <td class="px-4 py-3.5 text-center"><a href="/shop/all-in-one-bundle" class="text-xs font-semibold underline" style="color: var(--brass-ink);">View</a></td>
            <td class="px-4 py-3.5 text-center"><a href="/shop/mosqitter-grand" class="text-xs font-semibold underline" style="color: var(--pine);">View</a></td>
            <td class="px-4 py-3.5 text-center"><a href="/shop/biogents-non-co2-trap" class="text-xs font-semibold underline" style="color: var(--pine);">View</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="md:hidden absolute inset-y-0 right-0 w-10 pointer-events-none rounded-r-2xl" style="background: linear-gradient(270deg, var(--paper) 10%, rgba(250,247,241,0) 100%);" aria-hidden="true"></div>
    </div>
    <p class="md:hidden text-xs text-center mt-3" style="color: rgba(30,43,35,.5);">Swipe sideways to compare</p>
  </Section>

  <!-- ============ BUYING GUIDE ============ -->
  <Section variant="linen">
    <div class="text-center max-w-2xl mx-auto reveal">
      <Eyebrow class="justify-center">Buying Guide</Eyebrow>
      <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 400;">
        Which trap is right for you?
      </h2>
      <p class="mt-4 text-soft">Three scenarios. Three answers.</p>
    </div>
    <div class="space-y-5 mt-12 max-w-4xl mx-auto" data-stagger>
      {[
        {
          scenario: 'I want a proven system and I\'m ready to manage CO₂.',
          rec: 'All-in-One Bundle',
          link: '/shop/all-in-one-bundle',
          why: 'The complete starter kit. Everything arrives together: trap, timer, tank, and bait. Add a CO₂ fill and you\'re running the same day.',
          price: '$619.99',
        },
        {
          scenario: 'I have a covered patio, screened porch, or indoor problem.',
          rec: 'BG-Mosquitaire (No CO₂)',
          link: '/shop/biogents-non-co2-trap',
          why: 'No tank, no regulator, no monthly CO₂ cost. Heat and scent attraction works in enclosed spaces where outdoor traps underperform.',
          price: '$199.99',
        },
        {
          scenario: 'I have a large property (½ acre+) and want the best.',
          rec: 'Mosqitter Grand',
          link: '/shop/mosqitter-grand',
          why: 'Stainless steel, Bluetooth app-connected, up to two-acre coverage per unit. Professional installation from GreenGuard USA sets it up perfectly.',
          price: '$1,849.99',
        },
      ].map(s => (
        <div class="reveal">
          <Card tone="ivory" class="!p-7 md:!p-8 flex flex-col sm:flex-row gap-6 sm:items-center">
            <div class="flex-1">
              <p class="eyebrow eyebrow--plain !text-xs">If:</p>
              <p class="font-display mt-2 text-ink" style="font-size: 1.15rem; font-weight: 440; line-height: 1.3;">"{s.scenario}"</p>
              <p class="text-sm text-soft mt-2.5" style="line-height: 1.65;">{s.why}</p>
            </div>
            <div class="sm:text-right flex-none">
              <p class="text-xs font-semibold uppercase" style="letter-spacing: 0.1em; color: var(--brass-ink);">Get:</p>
              <p class="font-display mt-1 text-ink" style="font-size: 1.1rem;">{s.rec}</p>
              <p class="font-display mt-0.5" style="font-size: 1.4rem; color: var(--pine);">{s.price}</p>
              <div class="mt-3"><Btn href={s.link} variant="ghost" class="!text-sm !px-5">View Product</Btn></div>
            </div>
          </Card>
        </div>
      ))}
    </div>
  </Section>

  <!-- ============ QUOTE BUILDER BANNER (light: the one night band on this
       page is the closing CtaBand, keeping the light-to-dark rhythm) ============ -->
  <Section tight>
    <Card tone="linen" class="!p-8 md:!p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <p class="eyebrow eyebrow--plain">Already a GreenGuard customer?</p>
        <h2 class="font-display mt-3" style="font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 400;">See what an upgrade would cost</h2>
        <p class="text-sm text-soft mt-3" style="max-width: 30rem;">Add a second system, expand your coverage, or upgrade to Mosqitter Grand. See the exact monthly and one-time costs before you commit.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 flex-none">
        <a href="https://portal.greenguard-usa.com/quote/new" class="btn btn-primary whitespace-nowrap">Quote Builder</a>
        <a href="https://portal.greenguard-usa.com/dashboard/upgrade" class="btn btn-ghost whitespace-nowrap">Upgrade Calculator</a>
      </div>
    </Card>
  </Section>

  <CtaBand
    title="Not sure which system is right?"
    sub="Every equipment order includes a free property consultation. We visit your yard, map mosquito pressure zones, and confirm your trap placement is optimized before your first tank runs."
    ctaLabel="Book Free Assessment"
  />
</Base>
