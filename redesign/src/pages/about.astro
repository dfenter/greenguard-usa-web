---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Card from '../components/ui/Card.astro';
import CtaBand from '../components/ui/CtaBand.astro';
---

<Base
  title="About GreenGuard USA | Pesticide-Free Mosquito Control Austin TX"
  description="GreenGuard USA is Austin's pesticide-free mosquito control service. CO₂ trap technology, all-electric fleet, safe for kids, pets, and pollinators. Serving Austin and surrounding areas."
>
  <!-- ============ HERO ============ -->
  <Section variant="ivory">
    <div class="max-w-3xl">
      <Eyebrow>About</Eyebrow>
      <h1 class="mt-6 text-ink" style="font-size: clamp(2.6rem, 6vw, 4.5rem); max-width: 16ch;">
        Built on a <em class="italic" style="color: var(--pine); font-weight: 340;">simple conviction</em>
      </h1>
      <p class="mt-7 text-soft" style="font-size: 1.125rem; max-width: 34rem; line-height: 1.75;">
        Mosquito control should target mosquitoes, and nothing else.
      </p>
    </div>
  </Section>

  <!-- ============ FOUNDER STORY ============ -->
  <Section variant="linen">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-5 reveal">
        <figure class="m-0">
          <div class="photo-frame">
            <img
              src="/images/founderPhoto.jpg"
              alt="Lauren Hughes, founder of GreenGuard USA"
              loading="lazy"
              class="w-full h-full object-cover"
              style="aspect-ratio: 4 / 5;"
            />
          </div>
          <figcaption class="mt-3 text-sm text-soft text-center italic font-display">
            Lauren Hughes, founder
          </figcaption>
        </figure>
      </div>
      <div class="lg:col-span-7 reveal">
        <Eyebrow>Why GreenGuard USA Exists</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
          Why GreenGuard USA exists
        </h2>
        <div class="mt-6 space-y-5 text-soft" style="max-width: 36rem;">
          <p>
            Lauren Hughes founded GreenGuard USA in 2025 after years of watching families across Austin
            fight a losing battle against mosquitoes, including her own. Over 25 years in Central Texas
            raising two kids and a dog, she watched summer evenings get harder to enjoy. Mosquitoes took
            over, and being outside after sunset meant constantly getting swarmed.
          </p>
          <p>
            What Lauren noticed was not just more mosquitoes, but fewer of the things families actually
            want around their homes. Bees, butterflies, and fireflies became harder to find. Neighbors
            were spraying more pesticides, but the mosquitoes kept coming back while pollinators disappeared.
          </p>
          <p>
            That search led her to CO₂ mosquito trapping, a system that mimics human breath to specifically
            attract and capture mosquitoes without pesticides, without toxic residue, and without harming
            pollinators or beneficial insects. For the first time, she found something that actually worked
            while protecting the environment instead of damaging it.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- ============ VALUES ============ -->
  <Section variant="ivory">
    <div class="text-center max-w-2xl mx-auto reveal">
      <Eyebrow class="justify-center">Core Values</Eyebrow>
      <h2 class="font-display mt-4" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
        What We Stand For
      </h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-14" data-stagger>
      {[
        ['M12 3c-4 4-7 6.5-7 10a7 7 0 0 0 14 0c0-3.5-3-6-7-10Z', 'Ecosystem stewardship', 'We target only blood-seeking insects. Bees, butterflies, and pollinators are untouched.'],
        ['M12 21a9 9 0 1 1 9-9M21 3l-5.5 5.5M21 3h-4.5M21 3v4.5', 'Honest science', 'Peer-reviewed equipment, transparent efficacy data, no marketing fluff.'],
        ['M4 16 8 8h8l4 8M2 16h20M7 16a2 2 0 1 0 0 .01M17 16a2 2 0 1 0 0 .01', 'Clean operations', 'Zero-emission EV fleet across the Austin metro.'],
        ['M12 3 4 7v5c0 4.5 3.2 7.9 8 9 4.8-1.1 8-4.5 8-9V7l-8-4Z', 'No-pressure service', 'Month-to-month. No contracts, no upsells, no pressure.'],
      ].map(([d, title, body]) => (
        <div class="reveal">
          <Card tone="linen" class="h-full">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--brass)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={d} />
            </svg>
            <h3 class="font-display mt-4" style="font-size: 1.2rem;">{title}</h3>
            <p class="mt-2.5 text-sm text-soft">{body}</p>
          </Card>
        </div>
      ))}
    </div>
  </Section>

  <!-- ============ SERVICE AREA ============ -->
  <Section variant="linen">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-5 reveal">
        <h2 class="font-display" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
          Service area
        </h2>
        <p class="mt-5 text-soft" style="max-width: 28rem;">
          We serve Austin and surrounding areas within 45 miles: Westlake Hills, Rollingwood, Dripping Springs, Cedar Park, Round Rock, Lakeway, Bee Cave, Pflugerville, and more.
        </p>
        <p class="mt-4 text-sm text-soft">
          Not sure if we cover your street? <a href="/book" class="underline" style="color: var(--pine);">Check your ZIP on the booking page</a>.
        </p>
      </div>
      <div class="lg:col-span-7 reveal">
        <div class="photo-frame">
          <iframe
            title="GreenGuard USA service area, Austin, TX"
            width="100%" height="380" style="border:none;display:block;"
            loading="lazy"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d221232.9!2d-97.9!3d30.27!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8644b592d8173b8b%3A0x5a6f2b5a6a8d1e9!2sAustin%2C%20TX!5e0!3m2!1sen!2sus!4v1"
            allowfullscreen referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </div>
  </Section>

  <!-- ============ CTA BAND ============ -->
  <CtaBand
    title="Meet the team in person"
    sub="Free property assessment. Bring your questions."
    ctaLabel="Book Free Assessment"
  />
</Base>
