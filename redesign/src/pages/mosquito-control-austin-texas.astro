---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Card from '../components/ui/Card.astro';
import Faq from '../components/ui/Faq.astro';
import CtaBand from '../components/ui/CtaBand.astro';

const faqs = [
  {
    q: 'What is the best mosquito control for Austin TX?',
    a: 'CO₂ trap-based mosquito control is the most effective long-term solution for Austin properties. Unlike spray treatments that kill on contact and require re-application every 21 days, CO₂ traps work continuously to capture and eliminate breeding female mosquitoes around the clock. The Biogents BG-Mosquitaire, the trap GreenGuard USA uses, has been validated in peer-reviewed studies showing up to 93% bite reduction. For Austin homeowners dealing with tiger mosquitoes (which spray programs frequently miss), CO₂ trapping is the only method that targets daytime-biting species effectively.',
  },
  {
    q: 'How long is mosquito season in Austin TX?',
    a: 'Austin\'s mosquito season typically runs from late February or early March through mid-November, approximately 9 months per year. The Asian tiger mosquito (Aedes albopictus) can remain active any time temperatures are above 50°F, which in Austin\'s climate means activity is possible in every month of the year. Peak season is May through October, with the worst weeks typically following tropical moisture events in late summer.',
  },
  {
    q: 'How much does mosquito control cost in Austin?',
    a: 'GreenGuard USA\'s mosquito control service starts at $159.99/month for a full-service trap rental (trap, CO₂, maintenance included) or $89.99/month for CO₂ delivery to your existing trap. There are no setup fees, no contracts, and no pesticide application costs. Compared to spray treatments averaging $100–$150 per application every 3 weeks, CO₂ trapping is competitively priced and provides 24/7 protection rather than 3-week windows.',
  },
  {
    q: 'What mosquito species are in Austin TX?',
    a: 'Austin has three primary mosquito species. The Asian tiger mosquito (Aedes albopictus) is the dominant backyard nuisance: it bites during daylight hours, breeds in tiny containers, and is the primary driver of resident complaints. The southern house mosquito (Culex quinquefasciatus) is active at dusk and dawn, breeds in standing water, and can travel up to two miles from its breeding site. The yellow fever mosquito (Aedes aegypti) is concentrated in older central Austin neighborhoods and is a potential vector for dengue and Zika. CO₂ trapping is effective against all three species.',
  },
  {
    q: 'Is CO₂ mosquito control safe for bees and pets?',
    a: 'Yes. CO₂ mosquito traps use no pesticides, insecticides, or chemicals of any kind. They attract and capture mosquitoes using CO₂ and heat, the same signals mosquitoes use to find human hosts, and retain them in a catch net until they dehydrate. Bees, butterflies, pets, and children are completely unaffected. The trap presents no hazard to beneficial insects, pollinators, or any animal that does not respond to the CO₂ + heat attractant combination.',
  },
  {
    q: 'Do CO₂ mosquito traps work in Texas heat?',
    a: 'Yes. GreenGuard USA\'s Biogents traps are tested and validated for operation in temperatures up to 104°F and are specifically designed for use in hot climates. Austin\'s summer heat does not reduce trap performance. CO₂ gas also remains effective as an attractant throughout the season: heat actually increases mosquito flight activity, which improves catch rates during peak summer months.',
  },
];

const species = [
  {
    latin: 'Asian Tiger Mosquito · Aedes albopictus',
    title: 'The dominant backyard problem',
    body: 'Black-and-white striped, aggressive daytime biter. Breeds in containers as small as a bottle cap. Rarely travels more than 200 feet from its breeding site, which means the problem is in your yard, not coming from elsewhere. Spray programs designed for night-active mosquitoes miss this species almost entirely. CO₂ trapping is the most effective control method validated in peer-reviewed research.',
  },
  {
    latin: 'Southern House Mosquito · Culex quinquefasciatus',
    title: 'The dusk-and-dawn attacker',
    body: 'Brown, medium-sized, active from dusk through dawn. Breeds in standing water: birdbaths, clogged gutters, stormwater features. Can travel up to two miles from breeding sites. The species most targeted by conventional spray programs, though resistance to pyrethroids is now documented in Texas populations. Strong CO₂ responder: high trap catch rates throughout the season.',
  },
  {
    latin: 'Yellow Fever Mosquito · Aedes aegypti',
    title: "Central Austin's urban species",
    body: 'Dark with white markings, concentrated in older central Austin neighborhoods with dense vegetation. Potential vector for dengue, Zika, and chikungunya. Like the tiger mosquito, it bites during daylight and breeds in containers. Rarely found in newer suburban neighborhoods but common in Hyde Park, Travis Heights, Brentwood, and similar areas.',
  },
];

const seasonPhases = [
  ['Early Season', 'March – April', 'First tiger mosquito activity. Populations building. Best time to start trapping to reduce founding population.', false],
  ['Peak Season', 'May – October', 'Maximum pressure. All three species active. Late summer tropical events cause population spikes.', true],
  ['Late Season', 'October – November', "Populations declining but still active on warm days. Tiger mosquito eggs overwinter for next year's population.", false],
];

const treatmentRows = [
  ['CO₂ Trapping', '✓ Excellent', '✓ Yes', '✓ Yes', '$90–$165/mo', true],
  ['Spray Treatment', '✗ Poor', '✗ No', '✗ 3-week window', '$150–$200/mo', false],
  ['Barrier Spray', '✗ Poor', '✗ No', '✗ 3-week window', '$120–$180/mo', false],
  ['Mosquito Misting System', '~ Partial', '✗ No', '~ Scheduled only', '$200–$350/mo', false],
  ['Repellents / DIY', '~ Partial', '~ Varies', '✗ While applied', '$20–$60/mo', false],
];

const cities = [
  // (no Austin self-chip: this page IS the Austin page, and /mosquito-control-austin has no route)
  { city: 'Cedar Park', slug: 'cedar-park' },
  { city: 'Round Rock', slug: 'round-rock' },
  { city: 'Westlake Hills', slug: 'westlake-hills' },
  { city: 'Lakeway', slug: 'lakeway' },
  { city: 'Bee Cave', slug: 'bee-cave' },
  { city: 'Dripping Springs', slug: 'dripping-springs' },
  { city: 'Steiner Ranch', slug: 'steiner-ranch' },
  { city: 'Georgetown', slug: 'georgetown' },
  { city: 'Pflugerville', slug: 'pflugerville' },
  { city: 'Leander', slug: 'leander' },
  { city: 'Liberty Hill', slug: 'liberty-hill' },
  { city: 'Kyle', slug: 'kyle' },
  { city: 'Buda', slug: 'buda' },
];
---

<Base
  title="Mosquito Control Austin TX: Complete Guide 2026 | GreenGuard USA"
  description="Austin mosquito control guide: species, season length, costs, and treatment options. GreenGuard USA serves all Austin neighborhoods pesticide-free with CO₂ trap technology."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Mosquito Control in Austin TX: The Complete Guide",
    "description": "Everything Austin homeowners need to know about mosquito species, season length, treatment options, and costs.",
    "author": { "@type": "Organization", "name": "GreenGuard USA" },
    "publisher": { "@type": "Organization", "name": "GreenGuard USA", "url": "https://www.greenguard-usa.com" },
    "url": "https://www.greenguard-usa.com/mosquito-control-austin-texas",
    "dateModified": new Date().toISOString().split('T')[0]
  })} />

  <!-- ============ HERO ============ -->
  <Section variant="ivory">
    <div class="max-w-3xl">
      <Eyebrow>Complete Guide · Austin, TX</Eyebrow>
      <h1 class="mt-6 text-ink" style="font-size: clamp(2.6rem, 6vw, 4.2rem); max-width: 15ch;">
        Mosquito Control in <em class="italic" style="color: var(--pine); font-weight: 340;">Austin</em>, TX
      </h1>
      <p class="mt-7 text-soft" style="font-size: 1.125rem; max-width: 36rem; line-height: 1.75;">
        Austin has a 9-month mosquito season and three active species, including the daytime-biting tiger mosquito that spray programs miss. Here is everything you need to know to actually solve the problem.
      </p>
      <div class="flex flex-wrap items-center gap-4 mt-9">
        <Btn href="/book">Book Free Assessment</Btn>
      </div>
    </div>
  </Section>

  <!-- ============ INTRO ============ -->
  <Section variant="linen">
    <div class="max-w-3xl mx-auto reveal">
      <h2 class="font-display" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
        Why Austin has a serious mosquito problem
      </h2>
      <div class="mt-6 space-y-5 text-soft">
        <p>
          Austin sits in the heart of one of the longest mosquito seasons in the United States. Mild winters that rarely produce sustained freezes mean tiger mosquito eggs overwinter successfully and populations build rapidly the moment temperatures rise in late winter. The city's position along the Colorado River, Lady Bird Lake, Barton Creek, and dozens of creek tributaries creates miles of natural breeding habitat. Dense residential tree canopy and aggressive irrigation infrastructure layer suburban breeding sites on top of that natural base.
        </p>
        <p>
          The result: Austin homeowners deal with mosquito pressure from early March through mid-November, 9 months per year, and the dominant species (the Asian tiger mosquito) bites during daylight hours when families are actually using their yards.
        </p>
        <p>
          Traditional spray programs were designed for a different mosquito: the dusk-active house mosquito that breeds in large standing water. They are poorly matched to Austin's tiger mosquito problem, which is why many Austin residents have tried spray services and remained unsatisfied. CO₂ trapping was developed specifically to address the tiger mosquito.
        </p>
      </div>
    </div>
  </Section>

  <!-- ============ SPECIES ============ -->
  <Section variant="ivory">
    <div class="max-w-3xl mx-auto">
      <div class="reveal">
        <Eyebrow>Know Your Enemy</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
          3 mosquito species in Austin, TX
        </h2>
      </div>
      <div class="mt-10 space-y-6" data-stagger>
        {species.map((s) => (
          <div class="reveal">
            <Card tone="linen" class="!p-8">
              <p class="text-[0.78rem] font-semibold uppercase" style="letter-spacing: 0.12em; color: var(--brass-ink);">{s.latin}</p>
              <h3 class="font-display mt-2" style="font-size: 1.35rem;">{s.title}</h3>
              <p class="mt-3 text-soft text-[0.97rem]">{s.body}</p>
            </Card>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- ============ SEASON ============ -->
  <Section variant="linen">
    <div class="max-w-3xl mx-auto">
      <div class="reveal">
        <Eyebrow>Mosquito Season</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
          Austin's 9-month mosquito season
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10" data-stagger>
        {seasonPhases.map(([phase, months, note, hot]) => (
          <div class="reveal">
            <Card tone="ivory" class={`h-full text-center ${hot ? 'season-hot' : ''}`}>
              <p class="text-[0.78rem] font-semibold uppercase" style="letter-spacing: 0.12em; color: var(--brass-ink);">{phase}</p>
              <p class="font-display mt-2 text-ink" style="font-size: 1.25rem;">{months}</p>
              <p class="mt-3 text-sm text-soft">{note}</p>
            </Card>
          </div>
        ))}
      </div>
      <p class="mt-8 text-soft text-[0.97rem] reveal">
        Austin averages fewer than 20 hard freeze nights per year, not enough to kill tiger mosquito eggs, which are freeze-tolerant. Populations rebuild from overwintered eggs every spring regardless of how cold the previous winter was.
      </p>
    </div>
  </Section>

  <!-- ============ TREATMENT OPTIONS ============ -->
  <Section variant="ivory">
    <div class="max-w-4xl mx-auto">
      <div class="reveal">
        <Eyebrow>Treatment Comparison</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
          Mosquito control options in Austin, TX
        </h2>
      </div>
      <div class="table-scroll mt-10 rounded-2xl bg-ivory shadow-card reveal" style="border: 1px solid rgba(30,43,35,.08);">
        <div class="overflow-x-auto rounded-2xl">
        <table class="w-full text-[0.92rem]" style="border-collapse: collapse; min-width: 700px;">
          <thead>
            <tr class="hairline-b">
              <th class="text-left px-5 py-4 text-sm font-semibold text-soft" scope="col">Method</th>
              <th class="text-left px-5 py-4 text-sm font-semibold text-soft" scope="col">Tiger Mosquito</th>
              <th class="text-left px-5 py-4 text-sm font-semibold text-soft" scope="col">Pesticide-free</th>
              <th class="text-left px-5 py-4 text-sm font-semibold text-soft" scope="col">24/7 protection</th>
              <th class="text-left px-5 py-4 text-sm font-semibold text-soft" scope="col">Est. monthly cost</th>
            </tr>
          </thead>
          <tbody>
            {treatmentRows.map(([method, tiger, pesticideFree, allDay, cost, hot]) => (
              <tr class="hairline-b" style={hot ? 'background: rgba(46,74,59,.05);' : undefined}>
                <th class="text-left px-5 py-4 align-top font-semibold" scope="row" style={hot ? 'color: var(--pine);' : undefined}>{method}</th>
                <td class="px-5 py-4 align-top" style={hot ? 'color: var(--text);' : 'color: rgba(30,43,35,.55);'}>{tiger}</td>
                <td class="px-5 py-4 align-top" style={hot ? 'color: var(--text);' : 'color: rgba(30,43,35,.55);'}>{pesticideFree}</td>
                <td class="px-5 py-4 align-top" style={hot ? 'color: var(--text);' : 'color: rgba(30,43,35,.55);'}>{allDay}</td>
                <td class="px-5 py-4 align-top text-soft">{cost}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </div>
      <p class="text-sm text-soft mt-3 md:hidden" aria-hidden="true">Swipe to compare &rarr;</p>
    </div>
  </Section>

  <!-- ============ SERVICE AREAS ============ -->
  <Section variant="linen">
    <div class="max-w-3xl mx-auto">
      <div class="reveal">
        <Eyebrow>Service Area</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
          GreenGuard USA serves all of greater Austin
        </h2>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 list-none m-0 p-0 mt-8 reveal">
        {cities.map(({ city, slug }) => (
          <li class="hairline-b">
            <a
              href={`/mosquito-control-${slug}`}
              class="flex items-center justify-between py-3.5 no-underline text-ink/80 hover:text-pine text-[0.95rem] font-medium"
            >
              {city}, TX
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--brass)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- ============ FAQ ============ -->
  <Section variant="ivory">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-4 reveal">
        <Eyebrow>FAQ</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 400;">
          Frequently asked questions
        </h2>
      </div>
      <div class="lg:col-span-8 reveal">
        <Faq items={faqs} />
      </div>
    </div>
  </Section>

  <!-- ============ CTA BAND ============ -->
  <CtaBand
    title="Ready to reclaim your outdoor space?"
    sub="Book a free property assessment. We walk your yard, identify pressure zones, and design a trap placement plan, at no cost and no obligation."
    ctaLabel="Book Free Assessment"
  />

  <style is:global>
    .season-hot { border-color: var(--brass) !important; }
  </style>

  <style>
    /* Right-edge fade signals more columns off-screen on small viewports */
    .table-scroll { position: relative; }
    .table-scroll::after {
      content: '';
      position: absolute;
      top: 0; right: 0; bottom: 0;
      width: 3rem;
      pointer-events: none;
      background: linear-gradient(90deg, rgba(250,247,241,0), var(--paper));
      border-radius: 0 16px 16px 0;
    }
    @media (min-width: 768px) {
      .table-scroll::after { display: none; }
    }
  </style>
</Base>
