---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Card from '../components/ui/Card.astro';
import Faq from '../components/ui/Faq.astro';
import CtaBand from '../components/ui/CtaBand.astro';

const rows = [
  {
    label: 'Monthly cost',
    delivery: '$89 – $190/mo',
    rental: 'From $159.99/mo · multi-system discount',
    own: '$90 – $190/mo (delivery only)',
  },
  {
    label: 'Equipment cost',
    delivery: 'You already own a trap',
    rental: '$0 upfront (we own it)',
    own: '$180 – $1,850 (one-time purchase)',
  },
  {
    label: 'Who owns the trap',
    delivery: 'You',
    rental: 'GreenGuard USA',
    own: 'You',
  },
  {
    label: 'Installation',
    delivery: 'Self-install',
    rental: 'Included, we do it',
    own: 'Included with purchase',
  },
  {
    label: 'CO₂ tank exchange',
    delivery: 'Yes, monthly',
    rental: 'Yes, monthly',
    own: 'Yes, monthly',
  },
  {
    label: 'Repairs',
    delivery: 'We come out and fix it. Parts and labor billed separately.',
    rental: 'Fully covered. No extra charge, ever.',
    own: 'We come out and fix it. Parts and labor billed separately.',
  },
  {
    label: 'Routine maintenance',
    delivery: 'Included with each CO₂ visit',
    rental: 'Included, fully covered',
    own: 'Included with each CO₂ visit',
  },
  {
    label: 'Barrier treatment add-on',
    delivery: '+$49.99/treatment',
    rental: '+$49.99/treatment',
    own: '+$49.99/treatment',
  },
  {
    label: 'Contract required',
    delivery: 'None. Cancel anytime.',
    rental: 'None. Cancel anytime.',
    own: 'None. Cancel anytime.',
  },
  {
    label: 'Best for',
    delivery: 'Existing trap owners who want professional CO₂ service',
    rental: 'Homeowners who want zero hassle',
    own: 'Buyers who want to own their equipment long-term',
  },
];

const faqs = [
  {
    q: 'What happens if my trap needs a repair?',
    a: 'It depends on your plan. Rental customers pay nothing. We own the equipment, so we cover all parts and labor. CO₂ Delivery and Buy customers own their trap, so repairs are handled by us but billed separately for parts and labor.',
  },
  {
    q: 'Can I switch plans later?',
    a: 'Yes. If you start with CO₂ delivery and decide you want to upgrade to a rental, just let us know. We will swap out your equipment at the next scheduled visit.',
  },
  {
    q: 'Does the shop equipment work with your delivery service?',
    a: 'Yes. If you purchase a trap from our shop, we can enroll you in CO₂ Delivery service right away. The traps we sell are the same models we install for rental customers.',
  },
  {
    q: 'Is the barrier treatment available on its own?',
    a: 'No. Barrier treatment is an add-on for active CO₂ trap customers only. It works by masking human scent and redirecting mosquitoes toward your trap, so a running trap is required.',
  },
];
---

<Base
  title="CO₂ Trap vs Spray: Compare Mosquito Control Options Austin TX"
  description="Side-by-side comparison of CO₂ trapping vs pesticide spray vs DIY mosquito control for Austin homeowners. Honest assessment of costs, effectiveness, and safety."
>
  <!-- ============ HERO ============ -->
  <Section variant="ivory">
    <div class="max-w-3xl">
      <Eyebrow>Compare Options</Eyebrow>
      <h1 class="mt-6 text-ink" style="font-size: clamp(2.6rem, 6vw, 4.2rem); max-width: 15ch;">
        Which service is <em class="italic" style="color: var(--pine); font-weight: 340;">right for you?</em>
      </h1>
      <p class="mt-7 text-soft" style="font-size: 1.125rem; max-width: 32rem; line-height: 1.75;">
        Three ways to protect your yard. All pesticide-free. All month-to-month. Here is how they differ.
      </p>
    </div>
  </Section>

  <!-- ============ THREE PLANS ============ -->
  <Section variant="linen">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch" data-stagger>
      <div class="reveal">
        <Card tone="ivory" class="h-full flex flex-col !p-8">
          <p class="eyebrow eyebrow--plain !text-xs">Already own a trap</p>
          <h2 class="font-display mt-3" style="font-size: 1.35rem;">CO₂ Delivery Only</h2>
          <p class="mt-3 text-sm text-soft flex-1">You own the trap. We show up monthly to swap the CO₂ tank, inspect, and clean. Starting at <strong class="text-ink">$89.99/mo.</strong></p>
          <ul class="mt-5 space-y-2.5 list-none m-0 p-0 text-sm">
            {[
              [true, 'Monthly CO₂ tank swap'],
              [true, 'Inspection and cleaning every visit'],
              [false, 'Trap not included'],
              [false, 'Repairs billed separately when needed'],
            ].map(([yes, label]) => (
              <li class="flex gap-2.5 items-start" style={yes ? undefined : 'color: rgba(30,43,35,.5);'}>
                <svg class="flex-none mt-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={yes ? 'var(--pine)' : 'rgba(30,43,35,.35)'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {yes ? <path d="M4 12.5 9.5 18 20 6.5" /> : <path d="M6 6l12 12M18 6L6 18" />}
                </svg>
                {label}
              </li>
            ))}
          </ul>
          <div class="mt-6">
            <Btn href="/co2delivery" variant="ghost" class="w-full">CO₂ Delivery Details</Btn>
          </div>
        </Card>
      </div>
      <div class="reveal">
        <Card tone="ivory" class="h-full flex flex-col relative !p-8 plan-hot">
          <span class="absolute -top-3 left-8 text-[0.68rem] font-semibold uppercase rounded-full px-3 py-1" style="letter-spacing: 0.12em; background: var(--brass); color: #fff;">
            Most Popular
          </span>
          <p class="eyebrow eyebrow--plain !text-xs">Completely hands-off</p>
          <h2 class="font-display mt-3" style="font-size: 1.35rem;">Full-Service Rental</h2>
          <p class="mt-3 text-sm text-soft flex-1">We own the trap. We install it, maintain it, and cover all repairs at no extra charge. You just enjoy your yard. Starting at <strong class="text-ink">$159.99/mo.</strong></p>
          <ul class="mt-5 space-y-2.5 list-none m-0 p-0 text-sm">
            {[
              'Professional trap included',
              'Monthly CO₂ tank swap',
              'All repairs covered, no extra charge',
              'No upfront equipment cost',
            ].map((label) => (
              <li class="flex gap-2.5 items-start">
                <svg class="flex-none mt-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--pine)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 12.5 9.5 18 20 6.5" />
                </svg>
                {label}
              </li>
            ))}
          </ul>
          <div class="mt-6">
            <Btn href="/traprental" class="w-full">Rental Details</Btn>
          </div>
        </Card>
      </div>
      <div class="reveal">
        <Card tone="ivory" class="h-full flex flex-col !p-8">
          <p class="eyebrow eyebrow--plain !text-xs">Want to own your equipment</p>
          <h2 class="font-display mt-3" style="font-size: 1.35rem;">Buy + CO₂ Delivery</h2>
          <p class="mt-3 text-sm text-soft flex-1">Purchase a trap from our shop, then add monthly CO₂ delivery. Higher upfront cost, lower monthly rate. You own the hardware.</p>
          <ul class="mt-5 space-y-2.5 list-none m-0 p-0 text-sm">
            {[
              [true, 'Equipment is yours to keep'],
              [true, 'Monthly CO₂ delivery available'],
              [false, 'One-time equipment cost ($180 – $1,850)'],
              [false, 'Repairs billed separately when needed'],
            ].map(([yes, label]) => (
              <li class="flex gap-2.5 items-start" style={yes ? undefined : 'color: rgba(30,43,35,.5);'}>
                <svg class="flex-none mt-1" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke={yes ? 'var(--pine)' : 'rgba(30,43,35,.35)'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {yes ? <path d="M4 12.5 9.5 18 20 6.5" /> : <path d="M6 6l12 12M18 6L6 18" />}
                </svg>
                {label}
              </li>
            ))}
          </ul>
          <div class="mt-6">
            <Btn href="/shop" variant="ghost" class="w-full">Shop Equipment</Btn>
          </div>
        </Card>
      </div>
    </div>
  </Section>

  <!-- ============ FULL COMPARISON TABLE ============ -->
  <Section variant="ivory">
    <div class="text-center max-w-2xl mx-auto reveal">
      <h2 class="font-display" style="font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 400;">
        Side-by-side breakdown
      </h2>
    </div>
    <div class="table-scroll mt-12 rounded-2xl bg-ivory shadow-card reveal" style="border: 1px solid rgba(30,43,35,.08);">
      <div class="overflow-x-auto rounded-2xl">
      <table class="w-full text-[0.92rem]" style="border-collapse: collapse; min-width: 760px;">
        <thead>
          <tr class="hairline-b">
            <th class="text-left px-5 py-4 text-sm font-semibold text-soft w-[24%]" scope="col">Feature</th>
            <th class="text-left px-5 py-4 font-display text-ink" style="font-size: 1rem;" scope="col">CO₂ Delivery</th>
            <th class="text-left px-5 py-4 font-display" style="font-size: 1rem; color: var(--pine); background: rgba(46,74,59,.05); border-top: 2px solid var(--brass);" scope="col">Full-Service Rental</th>
            <th class="text-left px-5 py-4 font-display text-ink" style="font-size: 1rem;" scope="col">Buy + Delivery</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="hairline-b">
              <th class="text-left px-5 py-4 font-semibold text-ink align-top" scope="row">{row.label}</th>
              <td class="px-5 py-4 text-soft align-top">{row.delivery}</td>
              <td class="px-5 py-4 text-ink align-top" style="background: rgba(46,74,59,.05);">{row.rental}</td>
              <td class="px-5 py-4 text-soft align-top">{row.own}</td>
            </tr>
          ))}
        </tbody>
      </table>
      </div>
    </div>
    <p class="text-sm text-soft mt-3 md:hidden" aria-hidden="true">Swipe to compare &rarr;</p>
    <p class="text-sm text-soft mt-4 text-center reveal">All plans are month-to-month. Texas sales tax (8.25%) added to invoices.</p>
  </Section>

  <!-- ============ STILL UNSURE ============ -->
  <Section variant="linen" tight class="hairline-t hairline-b">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <h2 class="font-display" style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 420;">Still not sure?</h2>
        <p class="mt-2 text-soft text-[0.97rem]" style="max-width: 34rem;">Book a free property assessment. We will walk your yard, tell you which service fits your property and budget, and give you an honest recommendation.</p>
      </div>
      <div class="flex flex-wrap gap-4 flex-none">
        <Btn href="/book">Book Free Assessment</Btn>
        <Btn href="tel:5125604129" variant="ghost">Call 512-560-4129</Btn>
      </div>
    </div>
  </Section>

  <!-- ============ FAQ ============ -->
  <Section variant="ivory">
    <div class="max-w-3xl mx-auto">
      <div class="text-center reveal">
        <h2 class="font-display" style="font-size: clamp(1.7rem, 3.5vw, 2.4rem); font-weight: 400;">
          Common questions
        </h2>
      </div>
      <div class="mt-8 reveal">
        <Faq items={faqs} />
      </div>
    </div>
  </Section>

  <!-- ============ CTA BAND ============ -->
  <CtaBand />

  <style is:global>
    .plan-hot { border-color: var(--brass) !important; }
  </style>

  <style>
    /* Right-edge fade signals more columns off-screen on small viewports */
    .table-scroll { position: relative; }
    .table-scroll::after {
      content: '';
      position: absolute;
      top: 0; right: 0; bottom: 0;
      width: 3rem;
      pointer-events: none;
      background: linear-gradient(90deg, rgba(250,247,241,0), var(--paper));
      border-radius: 0 16px 16px 0;
    }
    @media (min-width: 768px) {
      .table-scroll::after { display: none; }
    }
  </style>
</Base>
