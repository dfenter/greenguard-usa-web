---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Btn from '../components/ui/Btn.astro';
import Card from '../components/ui/Card.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Faq from '../components/ui/Faq.astro';

const steps = [
  ['01', 'Property Inspection', 'Our technician maps mosquito pressure zones across your property, identifies resting areas and vegetation corridors, and confirms your CO₂ trap placement. This determines exactly where to apply the barrier for maximum effect.'],
  ['02', 'Scent Masking Application', 'We apply our plant-based essential oil formula around the perimeter of your property and key resting zones. The formula masks the human scent compounds mosquitoes rely on to locate hosts, effectively cloaking your outdoor living areas.'],
  ['03', 'Mosquitoes Redirected to the Trap', 'With human scent masked across the property, your CO₂ trap becomes the strongest attractant signal in the area. Mosquitoes that would otherwise target people are drawn toward the trap, captured, and removed from the breeding population continuously.'],
];

const faqs = [
  { q: 'Is the treatment safe for kids, pets, and bees?', a: 'Yes. The formula is entirely plant-based and free of synthetic pesticides. Children and pets can access treated areas on the same day as application with no waiting period required. The formula does not affect bees or pollinators. It is specifically designed to target the scent signals mosquitoes use to locate hosts, which bees and other beneficial insects do not respond to.' },
  { q: 'Why is the barrier only available to CO₂ trap customers?', a: 'The barrier masks human scent to redirect mosquitoes toward your CO₂ trap. Without a trap present, the barrier disperses mosquitoes around the property rather than eliminating them. The two systems are designed to work together. The barrier removes the competing signal, and the trap captures the mosquitoes that get redirected. Offering the barrier without a trap in place would not produce meaningful results for the customer.' },
  { q: 'How long does each treatment last?', a: "Each treatment provides up to 28 days of protection under normal conditions. Heavy rain can reduce the effective window. We recommend scheduling recurring treatments every four weeks during Austin's mosquito season, which typically runs from March through November." },
  { q: 'How is this different from a traditional mosquito spray service?', a: 'Traditional spray services apply synthetic insecticides across your entire yard. These leave residue on surfaces, carry re-entry waiting periods, and are harmful to bees and pollinators. Our treatment uses only plant-derived essential oils applied to targeted zones, with no residue, no pollinator risk, and no waiting period before your family can use the yard.' },
  { q: 'Do I need to be home for the treatment?', a: 'No. As long as your yard is accessible, our technician can complete the treatment without you being present. We will notify you when the service is complete. Most customers leave a gate unlocked on treatment day and resume normal use of the yard the same afternoon.' },
  { q: 'Is there a contract for recurring barrier treatment?', a: 'No. Like all GreenGuard USA services, the barrier treatment is month-to-month with no long-term commitment. You can book a single treatment or set up a recurring schedule and cancel or pause at any time with 48 hours notice.' },
];
---

<Base
  title="Plant-Based Barrier Treatment Austin TX | GreenGuard USA"
  description="A plant-based scent-masking treatment that amplifies your CO₂ trap by redirecting mosquitoes away from people and into capture. Available exclusively to GreenGuard USA CO₂ trap customers."
>
  <section class="bg-ivory relative overflow-hidden" style="padding-top:clamp(5rem,10vw,8.5rem);padding-bottom:clamp(4rem,8vw,7rem);"><div class="container-x"><div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"><div class="lg:col-span-7 reveal"><Eyebrow>CO₂ Trap Customers Only · Austin, TX</Eyebrow><h1 class="font-display mt-6" style="font-size:clamp(2.6rem,6vw,4.5rem);max-width:12ch;">The barrier that works <em class="italic" style="color:var(--pine);font-weight:340;">with your trap.</em></h1><p class="mt-7 text-soft" style="font-size:1.125rem;max-width:38rem;">Our plant-based barrier treatment masks the human scent signals mosquitoes use to locate people. With those signals removed, your CO₂ trap becomes the dominant attractant in the area, driving mosquitoes into capture rather than into your yard.</p><p class="mt-5 text-sm text-soft">Available exclusively to GreenGuard USA CO₂ trap customers. $49.99 per treatment. No contracts.</p><div class="flex flex-wrap gap-4 mt-9"><Btn href="/book">Book Free Assessment</Btn><Btn href="/co2delivery" variant="ghost">Explore trap service</Btn></div></div><div class="lg:col-span-5 reveal"><div class="rounded-frame bg-linen p-8" style="min-height:360px;"><svg class="w-full h-full" viewBox="0 0 300 360" fill="none" stroke="var(--sage)" stroke-width="1" aria-hidden="true"><path d="M150 335C150 235 150 135 150 28" /><path d="M150 274C105 263 73 232 68 181" /><path d="M150 274C195 263 227 232 232 181" /><path d="M150 205C115 195 92 170 88 130" /><path d="M150 205C185 195 208 170 212 130" /><path d="M150 135C127 128 112 109 108 81" /><path d="M150 135C173 128 188 109 192 81" /><path d="M68 181C48 171 35 153 34 132" /><path d="M232 181C252 171 265 153 266 132" /></svg></div></div></div></div></section>

  <Section variant="linen"><div class="max-w-2xl mx-auto text-center reveal"><Eyebrow class="justify-center">The Mechanism</Eyebrow><h2 class="font-display mt-4" style="font-size:clamp(2rem,4vw,3rem);">How the barrier and trap work as one system</h2><p class="mt-5 text-soft">The barrier treatment is not a standalone product. It is engineered to amplify the performance of your CO₂ trap by removing the competing signal that draws mosquitoes toward people.</p></div><div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12" data-stagger>{steps.map(([number, title, body]) => <div class="reveal"><span class="display-numeral block">{number}</span><div class="mt-4" style="width:40px;height:1px;background:var(--brass);"></div><h3 class="font-display mt-5" style="font-size:1.3rem;">{title}</h3><p class="mt-3 text-soft text-[0.97rem]">{body}</p></div>)}</div></Section>

  <Section variant="ivory"><div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center"><div class="lg:col-span-5 reveal"><Card tone="linen" class="!p-8"><Eyebrow plain>CO₂ Trap Add-On</Eyebrow><h2 class="font-display mt-4" style="font-size:2rem;">Barrier Treatment</h2><p class="mt-3 text-sm text-soft">Available to GreenGuard USA CO₂ trap customers.</p><p class="mt-7"><span class="font-display" style="font-size:2.7rem;color:var(--pine);">$49.99</span><span class="text-sm text-soft"> per treatment</span></p><div class="hairline-t mt-6 pt-5"><dl class="space-y-3 text-sm"><div class="flex justify-between gap-4"><dt class="text-soft">Protection duration</dt><dd class="font-semibold text-right">Up to 28 days</dd></div><div class="flex justify-between gap-4"><dt class="text-soft">Recurring option</dt><dd class="font-semibold text-right">Every 4 weeks</dd></div><div class="flex justify-between gap-4"><dt class="text-soft">Formula</dt><dd class="font-semibold text-right">Plant-based essential oils</dd></div><div class="flex justify-between gap-4"><dt class="text-soft">Contract required</dt><dd class="font-semibold text-right">None</dd></div><div class="flex justify-between gap-4"><dt class="text-soft">CO₂ trap required</dt><dd class="font-semibold text-right">Yes</dd></div></dl></div><div class="mt-7"><Btn href="/book">Book Free Assessment</Btn></div></Card></div><div class="lg:col-span-7 reveal"><Eyebrow>Why Human Scent Masking Changes Everything</Eyebrow><h2 class="font-display mt-4" style="font-size:clamp(2rem,4vw,3rem);">A CO₂ trap competes with the people in your yard.</h2><p class="mt-5 text-soft">Both you and your trap emit CO₂. Both emit heat and scent compounds. Mosquitoes respond to whichever signal is strongest, and a person standing nearby often wins that competition.</p><p class="mt-4 text-soft">The barrier removes your scent from the equation entirely. Your CO₂ trap is no longer competing. It is the only game in town. Every mosquito that enters your property follows the CO₂ plume directly into capture rather than toward your family.</p><p class="mt-4 text-soft">The result is a measurably higher capture rate from your existing trap, and significantly less biting activity in the areas where you actually spend time.</p></div></div></Section>

  <Section variant="linen"><div class="max-w-3xl mx-auto reveal"><Eyebrow>Why CO₂ Trap Customers Only</Eyebrow><h2 class="font-display mt-4" style="font-size:clamp(2rem,4vw,3rem);">The barrier needs a trap to work</h2><p class="mt-5 text-soft">The barrier treatment works by redirecting mosquitoes. It does not eliminate them on its own. Without a CO₂ trap present, masking human scent simply disperses mosquitoes around the property rather than capturing them. The treatment is only effective as part of a complete system.</p><p class="mt-4 text-soft">If you do not yet have a CO₂ trap installed, the right first step is a free property assessment. We will walk your yard, recommend the right trap for your property size, and discuss how the barrier treatment fits into your complete mosquito control plan.</p><p class="mt-4 text-soft">Existing GreenGuard USA CO₂ trap customers can add the barrier treatment to their service at any time by booking through the assessment link below.</p></div></Section>

  <Section variant="ivory"><div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16"><div class="lg:col-span-4 reveal"><Eyebrow>Common Questions</Eyebrow><h2 class="font-display mt-4" style="font-size:clamp(2rem,4vw,2.8rem);">Barrier treatment FAQ</h2></div><div class="lg:col-span-8 reveal"><Faq items={faqs} /></div></div></Section>

  <CtaBand title="Ready to amplify your trap?" sub="Book a free property assessment and we will walk your yard, confirm your trap placement, and discuss adding the barrier treatment to your service plan." ctaLabel="Book Free Assessment" />

  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map(({ q, a }) => ({ "@type": "Question", "name": q, "acceptedAnswer": { "@type": "Answer", "text": a } })) })} />
</Base>
