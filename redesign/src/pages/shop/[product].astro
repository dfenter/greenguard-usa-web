      { label: 'Runtime (continuous, 1 trap)', value: '~20 days' },
      { label: 'Runtime (with timer, 8hr/day)', value: 'Up to 60 days' },
      { label: 'Sold', value: 'Empty: refill locally or via GreenGuard' },
      { label: 'Refill Cost', value: '~$20 to $35 at local supplier' },
    ],
    faq: [
      {
        q: 'Where do I get it filled?',
        a: 'Any welding supply store, homebrew/homebrew shop, fire extinguisher service, or paintball supplier can fill a CGA-320 cylinder. Cost is typically $20 to $35. Alternatively, GreenGuard USA\'s delivery service handles tank exchange at your door, no trips required.'
      },
      {
        q: 'Can I use GreenGuard\'s delivery service with this tank?',
        a: 'Yes. Once you own a compatible tank, you can subscribe to our monthly CO₂ delivery service. We exchange your empty for a full tank, inspect your trap, and get you running again, all in one visit.'
      },
      {
        q: 'Why is it sold empty?',
        a: 'US carrier regulations prohibit shipping pressurized CO₂ cylinders. Sold empty is standard for all CO₂ cylinder purchases. Your local fill station can have it ready in under 10 minutes.'
      },
    ],
    crossSells: [
      { id: 'biogents-co2-timer', name: 'Biogents CO₂ Tank Timer', price: 109.99, image: '/images/prod-co2-timer.png', tagline: 'Triple your tank runtime' },
      { id: 'biogents-co2-trap', name: 'Biogents BG-Mosquitaire CO₂ Trap', price: 299.99, image: '/images/prod-biogents-co2.jpg', tagline: 'The trap this tank is built for' },
    ],
    rating: 4.8,
    reviewCount: 11,
  },
  ];
  return products.map(p => ({ params: { product: p.id }, props: { product: p } }));
}

const { product: p } = Astro.props;

const savings = p.originalPrice ? (p.originalPrice - p.price) : 0;

// JSON-LD for this product
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.shortDesc,
  image: `https://www.greenguard-usa.com${p.image}`,
  brand: { '@type': 'Brand', name: 'GreenGuard USA' },
  mpn: p.id.toUpperCase(),
  offers: {
    '@type': 'Offer',
    url: `https://www.greenguard-usa.com/shop/${p.id}`,
    priceCurrency: 'USD',
    price: p.price.toFixed(2),
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: 'GreenGuard USA' },
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: p.rating,
    reviewCount: p.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
};
---

<Base
  title={p.seoTitle || `${p.name} | GreenGuard USA`}
  description={p.seoDescription || p.shortDesc}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <div id="product-meta" class="hidden" data-id={p.id} data-name={p.name} data-price={String(p.price)}></div>

  <!-- ============ BREADCRUMB ============ -->
  <div class="bg-ivory hairline-b">
    <nav aria-label="Breadcrumb" class="container-x py-4 text-xs" style="color: rgba(30,43,35,.5);">
      <a href="/shop" class="no-underline hover:text-pine" style="color: rgba(30,43,35,.55);">Shop</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span>{p.name}</span>
    </nav>
  </div>

  <!-- ============ MAIN PRODUCT ============ -->
  <Section class="!pt-10 md:!pt-14">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

      <!-- LEFT: gallery -->
      <div class="lg:sticky lg:top-24">
        <div class="photo-frame relative bg-linen" style="aspect-ratio: 1;">
          <img
            id="main-product-img"
            src={p.image}
            alt={p.name}
            class="w-full h-full object-contain p-6"
            loading="eager"
          />
          {p.badge && (
            <span class="absolute top-5 left-5 text-[0.68rem] font-semibold uppercase rounded-full px-3 py-1" style="letter-spacing: 0.12em; background: var(--brass); color: #fff;">{p.badge}</span>
          )}
        </div>
        {p.altImage && (
          <div class="flex gap-3 mt-4">
            <button
              class="img-thumb is-active flex-1 rounded-2xl overflow-hidden bg-linen"
              style="aspect-ratio: 1; border: 2px solid var(--brass); cursor: pointer; padding: 0;"
              data-src={p.image}
              aria-label="Show product view 1"
            >
              <img src={p.image} alt="" class="w-full h-full object-contain p-2" loading="lazy" />
            </button>
            <button
              class="img-thumb flex-1 rounded-2xl overflow-hidden bg-linen"
              style="aspect-ratio: 1; border: 2px solid transparent; cursor: pointer; padding: 0;"
              data-src={p.altImage}
              aria-label="Show product view 2"
            >
              <img src={p.altImage} alt="" class="w-full h-full object-contain p-2" loading="lazy" />
            </button>
          </div>
        )}
        {p.mainStat && (
          <Card tone="linen" class="mt-5 text-center !p-6">
            <p class="font-display" style="font-size: 2.6rem; font-weight: 380; color: var(--pine); line-height: 1;">{p.mainStat}</p>
            <p class="text-sm text-soft mt-2">{p.mainStatLabel}</p>
          </Card>
        )}
      </div>

      <!-- RIGHT: info -->
      <div>
        <div class="flex flex-wrap gap-2 mb-5">
          {p.targetSpecies && (
            <span class="text-xs font-medium rounded-full px-3 py-1.5 text-ink/70" style="border: 1px solid rgba(30,43,35,.16); background: var(--paper-alt);">{p.targetSpecies}</span>
          )}
          {p.coverageStat && (
            <span class="text-xs font-medium rounded-full px-3 py-1.5" style="border: 1px solid var(--brass); color: var(--brass-ink);">{p.coverageStat}</span>
          )}
        </div>

        <h1 class="text-ink" style="font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 420; line-height: 1.12;">{p.name}</h1>

        <div class="flex items-center gap-2.5 mt-4">
          <Stars rating={p.rating} size={15} />
          <span class="text-sm text-soft"><strong class="text-ink font-semibold">{p.rating}</strong> ({p.reviewCount} verified reviews)</span>
        </div>

        <p class="mt-5 flex items-baseline gap-3 flex-wrap">
          <span class="font-display" style="font-size: 2.5rem; font-weight: 380; color: var(--pine);">${p.price.toFixed(2)}</span>
          {p.originalPrice && (
            <span class="text-soft line-through" style="font-size: 1.15rem;">${p.originalPrice.toFixed(2)}</span>
          )}
          {savings > 0 && (
            <span class="text-xs font-semibold uppercase rounded-full px-2.5 py-1" style="letter-spacing: 0.08em; color: var(--brass-ink); border: 1px solid var(--brass);">Save ${savings.toFixed(2)}</span>
          )}
        </p>

        {p.vsCompetitor && (
          <p class="text-sm font-semibold mt-2" style="color: var(--brass-ink);">
            ${p.vsCompetitor.savings.toFixed(0)} less than buying direct from {p.vsCompetitor.name} (${p.vsCompetitor.price.toFixed(2)})
          </p>
        )}

        <p class="mt-5 text-soft" style="line-height: 1.75;">{p.shortDesc}</p>

        <ul class="mt-6 space-y-2.5 list-none m-0 p-0">
          {p.keyBenefits.map(b => (
            <li class="flex gap-3 text-[0.95rem] text-ink">
              <svg class="flex-none mt-1" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--pine)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12.5 9.5 18 20 6.5" />
              </svg>
              {b}
            </li>
          ))}
        </ul>

        <!-- Purchase CTAs: checkout lives on www.greenguard-usa.com (this
             domain cannot run the cart API), so ordering hands off there. -->
        <div class="flex flex-col gap-3 mt-8">
          {p.outOfStock ? (
            <span class="btn btn-ghost justify-center opacity-50 cursor-not-allowed" aria-disabled="true">Out of Stock. Check back soon.</span>
          ) : (
            <Btn href={`https://www.greenguard-usa.com/shop/${p.id}`} class="justify-center w-full">Order on greenguard-usa.com: ${p.price.toFixed(2)}</Btn>
          )}
          <Btn href="/book" variant="ghost" class="justify-center w-full">Book Free Assessment</Btn>
        </div>

        <div class="grid grid-cols-2 gap-2.5 mt-7">
          {[
            ['M12 3 4 7v5c0 4.5 3.2 7.9 8 9 4.8-1.1 8-4.5 8-9V7l-8-4Z', 'Secure Checkout', 'SSL · Stripe encrypted'],
            ['M3 8h13v8H3zM16 11h4l1 2v3h-5M6 19a1.5 1.5 0 1 0 0-.01M18 19a1.5 1.5 0 1 0 0-.01', p.outOfStock ? 'Out of Stock' : 'In Stock', p.outOfStock ? 'Check back soon' : 'Ships from Austin TX'],
            ['M4 12.5 9.5 18 20 6.5', 'Free Assessment', 'Included with every order'],
            ['M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7A2 2 0 0 1 22 16.9Z', 'Questions?', '512-560-4129'],
          ].map(([d, t, sub]) => (
            <div class="flex items-start gap-2.5 rounded-xl px-3.5 py-3" style="border: 1px solid var(--hairline); background: var(--paper-alt);">
              <svg class="flex-none mt-0.5" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--brass)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={d} />
              </svg>
              <span>
                <span class="block text-xs font-semibold text-ink">{t}</span>
                <span class="block text-xs text-soft mt-0.5">{sub}</span>
              </span>
            </div>
          ))}
        </div>

        <!-- Local service cross-sell: equipment researchers in Austin are the
             highest-margin path to a service customer. -->
        <Card tone="linen" class="mt-6 !p-6">
          <p class="font-display text-ink" style="font-size: 1.05rem; font-weight: 460;">In the Austin area? We install, service &amp; refill this.</p>
          <p class="text-sm text-soft mt-2" style="line-height: 1.65;">
            GreenGuard installs and maintains the equipment we sell, including monthly CO₂ delivery, placement tuning, and full-service plans. Already own a trap? We service those too.
          </p>
          <div class="mt-4"><Btn href="/book?own=1" class="!text-sm">Book a free on-site assessment</Btn></div>
        </Card>

        <p class="text-xs text-center mt-5" style="color: rgba(30,43,35,.5);">
          Not sure this is the right model? <a href="/book" class="underline" style="color: var(--pine);">Book a free consultation</a> and we'll recommend the right system for your property.
        </p>
      </div>
    </div>
  </Section>

  <!-- ============ FEATURES ============ -->
  <Section variant="linen">
    <div class="text-center max-w-2xl mx-auto reveal">
      <Eyebrow class="justify-center">Product Details</Eyebrow>
      <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 400;">Why it works</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12" data-stagger>
      {p.features.map((f, i) => (
        <div class="reveal h-full">
          <Card tone="ivory" class="h-full !p-7">
            <span class="font-display block" style="font-size: 1.9rem; font-weight: 300; color: var(--sage); line-height: 1;" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="mt-3" style="width: 36px; height: 1px; background: var(--brass);"></div>
            <h3 class="font-display mt-4" style="font-size: 1.15rem; font-weight: 480;">{f.title}</h3>
            <p class="text-sm text-soft mt-2.5" style="line-height: 1.65;">{f.desc}</p>
          </Card>
        </div>
      ))}
    </div>
  </Section>

  <!-- ============ WHAT'S INCLUDED ============ -->
  {p.whatsIncluded && (
    <Section>
      <div class="mx-auto" style="max-width: 44rem;">
        <div class="text-center reveal">
          <Eyebrow class="justify-center">In the Box</Eyebrow>
          <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 400;">What's included</h2>
        </div>
        <div class="mt-10 rounded-2xl overflow-hidden reveal" style="border: 1px solid rgba(30,43,35,.1);">
          {p.whatsIncluded.map((item, i) => (
            <div class:list={['flex items-start gap-4 px-6 py-4', i > 0 && 'hairline-t']}>
              {item.includes('NOT') ? (
                <svg class="flex-none mt-1" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="rgba(30,43,35,.35)" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
              ) : (
                <svg class="flex-none mt-1" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--pine)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 12.5 9.5 18 20 6.5" />
                </svg>
              )}
              <span class:list={['text-[0.95rem]', item.includes('NOT') ? 'text-ink/50 italic' : 'text-ink/85']}>{item}</span>
            </div>
          ))}
        </div>
      </div>
    </Section>
  )}

  <!-- ============ SPECS ============ -->
  <Section variant="linen">
    <div class="mx-auto" style="max-width: 44rem;">
      <div class="text-center reveal">
        <Eyebrow class="justify-center">Specifications</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 400;">Technical details</h2>
      </div>
      <div class="mt-10 rounded-2xl overflow-hidden bg-ivory reveal" style="border: 1px solid rgba(30,43,35,.1);">
        {p.specs.map((s, i) => (
          <div class:list={['flex items-start justify-between gap-6 px-6 py-4', i > 0 && 'hairline-t']}>
            <span class="text-sm text-soft flex-none">{s.label}</span>
            <span class="text-sm font-medium text-ink text-right">{s.value}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- ============ COMPARISON (trap only) ============ -->
  {p.vsCompetitor && (
    <Section>
      <div class="text-center max-w-2xl mx-auto reveal">
        <Eyebrow class="justify-center">How It Compares</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.7rem, 3.4vw, 2.4rem); font-weight: 400;">GreenGuard vs. buying direct vs. sprays</h2>
      </div>
      <div class="relative mt-10 max-w-4xl mx-auto reveal">
      <div class="overflow-x-auto rounded-2xl" style="border: 1px solid rgba(30,43,35,.1);">
        <table class="w-full text-sm" style="border-collapse: collapse; min-width: 620px;">
          <thead>
            <tr class="bg-linen">
              <th class="text-left px-5 py-4"></th>
              <th class="px-4 py-4 text-center font-display" style="font-size: 0.95rem; color: var(--pine);">GreenGuard USA</th>
              <th class="px-4 py-4 text-center font-display text-ink/70" style="font-size: 0.95rem;">Biogents (direct)</th>
              <th class="px-4 py-4 text-center font-display text-ink/70" style="font-size: 0.95rem;">Spray service</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Trap price', '$299.99', `$${p.vsCompetitor.price.toFixed(2)}`, 'n/a'],
              ['Ships from', 'Austin, TX', 'Regional warehouse', 'n/a'],
              ['Local install & placement', 'Included, free assessment', 'Self-install', 'n/a'],
              ['CO₂ tank delivery', 'From $89.99/mo', 'Not offered', 'n/a'],
              ['Ongoing service option', 'From $60/mo (own trap)', 'None', '$80 to 120/visit'],
              ['Pesticides', 'None', 'None', 'Yes, sprayed'],
              ['Pollinator-safe', 'Yes', 'Yes', 'No'],
              ['How it works', 'Removes breeding females 24/7', 'Removes breeding females 24/7', 'Kills on contact, wears off 2 to 4 wks'],
            ].map((row) => (
              <tr class="hairline-t">
                <td class="px-5 py-3.5 font-semibold text-ink/70 text-xs">{row[0]}</td>
                <td class="px-4 py-3.5 text-center text-ink font-medium bg-linen/40">{row[1]}</td>
                <td class="px-4 py-3.5 text-center text-soft">{row[2]}</td>
                <td class="px-4 py-3.5 text-center text-soft">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="md:hidden absolute inset-y-0 right-0 w-10 pointer-events-none rounded-r-2xl" style="background: linear-gradient(270deg, var(--paper) 10%, rgba(250,247,241,0) 100%);" aria-hidden="true"></div>
      </div>
      <p class="md:hidden text-xs text-center mt-3" style="color: rgba(30,43,35,.5);">Swipe sideways to compare</p>
      <p class="text-xs text-center mt-4 mx-auto" style="color: rgba(30,43,35,.55); max-width: 40rem;">
        Buy the same Biogents trap for $50 less than the manufacturer's direct price, and add local install, CO₂ delivery, and service only if you want them.
      </p>
    </Section>
  )}

  <!-- ============ CROSS-SELLS ============ -->
  {p.crossSells.length > 0 && (
    <Section variant={p.vsCompetitor ? 'linen' : 'ivory'}>
      <div class="text-center max-w-2xl mx-auto reveal">
        <Eyebrow class="justify-center">Complete Your Setup</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.8rem, 3.6vw, 2.5rem); font-weight: 400;">Frequently paired with</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12 max-w-3xl mx-auto" data-stagger>
        {p.crossSells.map(cs => (
          <div class="reveal h-full">
            <Card tone={p.vsCompetitor ? 'ivory' : 'linen'} class="h-full flex flex-col !p-0 overflow-hidden">
              <a href={`/shop/${cs.id}`} class="block bg-ivory" style="aspect-ratio: 2 / 1;">
                <img src={cs.image} alt={cs.name} class="w-full h-full object-contain p-4" loading="lazy" />
              </a>
              <div class="p-6 flex flex-col flex-1 hairline-t">
                <p class="eyebrow eyebrow--plain !text-xs">{cs.tagline}</p>
                <h3 class="font-display mt-2" style="font-size: 1.15rem; font-weight: 460;">
                  <a href={`/shop/${cs.id}`} class="no-underline text-ink hover:text-pine">{cs.name}</a>
                </h3>
                <p class="font-display mt-2 flex-1" style="font-size: 1.35rem; color: var(--pine);">${cs.price.toFixed(2)}</p>
                <div class="flex flex-wrap gap-2.5 mt-4">
                  <Btn href={`/shop/${cs.id}`} variant="ghost" class="!text-sm !px-5">View Details</Btn>
                </div>
              </div>
            </Card>
          </div>
        ))}
      </div>
    </Section>
  )}

  <!-- ============ FAQ ============ -->
  <Section variant={p.crossSells.length > 0 && !p.vsCompetitor ? 'linen' : 'ivory'}>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-4 reveal">
        <Eyebrow>Questions</Eyebrow>
        <h2 class="font-display mt-4" style="font-size: clamp(1.7rem, 3.2vw, 2.3rem); font-weight: 400;">
          Frequently asked
        </h2>
        <p class="mt-5 text-sm text-soft">
          or call <a href="tel:5125604129" class="underline" style="color: var(--pine);">512-560-4129</a>
        </p>
      </div>
      <div class="lg:col-span-8 reveal">
        <Faq items={p.faq} />
      </div>
    </div>
  </Section>

  <CtaBand
    title="Not sure this is the right system?"
    sub="Every equipment order includes a free property consultation. We visit your yard, confirm your trap placement, and make sure your investment performs at its full potential."
    ctaLabel="Book Free Assessment"
  />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // view_item event (kept from the original page; ecommerce funnel signal)
      const meta = document.getElementById('product-meta') as HTMLElement | null;
      if (meta && typeof window.gtag === 'function') {
        window.gtag('event', 'view_item', {
          currency: 'USD',
          value: parseFloat(meta.dataset.price || '0'),
          items: [{ item_id: meta.dataset.id, item_name: meta.dataset.name, price: parseFloat(meta.dataset.price || '0') }],
        });
      }

      // Image gallery thumbnails
      document.querySelectorAll('.img-thumb').forEach(btn => {
        btn.addEventListener('click', () => {
          const src = (btn as HTMLButtonElement).dataset.src;
          const mainImg = document.getElementById('main-product-img') as HTMLImageElement;
          if (src && mainImg) mainImg.src = src;
          document.querySelectorAll('.img-thumb').forEach(b => {
            (b as HTMLElement).style.borderColor = 'transparent';
          });
          (btn as HTMLElement).style.borderColor = 'var(--brass)';
        });
      });
    });
  </script>
</Base>
