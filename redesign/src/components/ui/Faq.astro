---
/**
 * Accessible accordion built on details/summary.
 * items: [{ q, a }] (a is plain text). Page owns any FAQPage JSON-LD.
 */
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<div class:list={['faq-list', className]}>
  {items.map(({ q, a }) => (
    <details class="faq-item hairline-b">
      <summary class="faq-q">
        <span class="font-display" style="font-size:1.1rem;font-weight:480;">{q}</span>
        <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="var(--brass)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </summary>
      <p class="faq-a">{a}</p>
    </details>
  ))}
</div>

<style>
  .faq-item { padding: 0.35rem 0; }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0.25rem;
    cursor: pointer;
    list-style: none;
    color: var(--text);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-chevron { flex: none; transition: transform 0.25s ease; }
  details[open] .faq-chevron { transform: rotate(180deg); }
  .faq-a {
    padding: 0 0.25rem 1.25rem;
    max-width: 62ch;
    font-size: 0.97rem;
    color: var(--text-soft);
  }
</style>
