---
// Email capture popup. Shown after 30s or 50% scroll. Suppressed once dismissed or submitted.
// Wiring (IDs, storage key, endpoint, events) is unchanged from the original; only restyled.
---

<!-- Overlay -->
<div id="lc-overlay" class="fixed inset-0 z-[70] hidden" style="background: rgba(20,32,26,.45); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);"></div>

<!-- Modal -->
<div
  id="lc-modal"
  class="fixed z-[80] hidden"
  style="top:50%;left:50%;transform:translate(-50%,-50%);width:min(480px,calc(100vw - 2rem));"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lc-title"
>
  <div class="rounded-2xl bg-ivory p-8 md:p-10 relative" style="border: 1px solid rgba(30,43,35,.08); box-shadow: 0 1px 2px rgba(20,32,26,.08), 0 32px 90px -12px rgba(20,32,26,.45);">
    <button id="lc-close" aria-label="Close" class="absolute top-4 right-4 w-11 h-11 flex items-center justify-center text-ink/40 hover:text-ink text-2xl leading-none" style="background:none;border:none;cursor:pointer;">&#x2715;</button>

    <div class="text-center mb-7">
      <svg class="inline-block mb-4" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="var(--brass)" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M12 21c-4 -3.5 -6.5 -6 -6.5 -9.5a6.5 6.5 0 0 1 13 0C18.5 15 16 17.5 12 21Z" />
        <path d="M12 21V8" />
      </svg>
      <h2 id="lc-title" class="font-display mt-2 mb-3" style="font-size: 1.6rem; font-weight: 420; line-height: 1.15; color: var(--text);">
        Free: Austin Mosquito Season Guide
      </h2>
      <p class="text-sm text-soft leading-relaxed" style="max-width: 24rem; margin: 0 auto;">
        When mosquito season actually starts, where to place traps for maximum catch, and what to expect in weeks 1–8.
      </p>
    </div>

    <form id="lc-form" novalidate>
      <div class="flex flex-col sm:flex-row gap-3">
        <label for="lc-email" class="sr-only">Email address</label>
        <input
          id="lc-email"
          type="email"
          placeholder="your@email.com"
          autocomplete="email"
          required
          class="flex-1 rounded-full px-5 text-[0.95rem] outline-none min-w-0"
          style="background: var(--paper-alt); border: 1px solid var(--hairline); color: var(--text); min-height: 48px;"
        />
        <button
          type="submit"
          id="lc-submit"
          class="btn btn-primary whitespace-nowrap !text-sm"
        >
          Send Me the Guide
        </button>
      </div>
      <p id="lc-error" class="text-xs mt-2.5 hidden" style="color: var(--error);">Please enter a valid email address.</p>
    </form>

    <p id="lc-success" class="hidden text-center font-semibold text-sm mt-3" style="color: var(--success);">
      Sent! Check your inbox.
    </p>

    <p class="text-xs text-center mt-5" style="color: rgba(30,43,35,.4);">No spam. Unsubscribe anytime.</p>
  </div>
</div>

<script>
(function() {
  const STORAGE_KEY = 'gg_lead_captured';
  if (localStorage.getItem(STORAGE_KEY)) return;

  let lastFocus = null;

  function trapTab(e) {
    const modal = document.getElementById('lc-modal');
    if (e.key !== 'Tab' || !modal || modal.classList.contains('hidden')) return;
    const items = Array.from(modal.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])'))
      .filter((el) => el.offsetParent !== null);
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;
    if (!modal.contains(active)) { e.preventDefault(); first.focus(); return; }
    if (e.shiftKey && active === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
  }

  function show() {
    lastFocus = document.activeElement;
    document.getElementById('lc-overlay')?.classList.remove('hidden');
    document.getElementById('lc-modal')?.classList.remove('hidden');
    // Move focus into the dialog and keep Tab inside it while open
    document.getElementById('lc-email')?.focus();
    document.addEventListener('keydown', trapTab, true);
  }
  function hide() {
    document.getElementById('lc-overlay')?.classList.add('hidden');
    document.getElementById('lc-modal')?.classList.add('hidden');
    document.removeEventListener('keydown', trapTab, true);
    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
  }

  // Show after 30s or 50% scroll, whichever comes first
  // Set shown = true before calling show() to prevent race between timer and scroll
  let shown = false;
  function trigger() {
    if (shown) return;
    shown = true;  // guard set before show() so concurrent calls from timer + scroll are dropped
    show();
  }

  const timer = setTimeout(trigger, 30000);

  const onScroll = () => {
    const scrolled = window.scrollY + window.innerHeight;
    const total = document.documentElement.scrollHeight;
    if (scrolled / total >= 0.5) {
      clearTimeout(timer);
      window.removeEventListener('scroll', onScroll);
      trigger();
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });

  document.getElementById('lc-close')?.addEventListener('click', () => {
    hide();
    localStorage.setItem(STORAGE_KEY, 'dismissed');
  });
  document.getElementById('lc-overlay')?.addEventListener('click', () => {
    hide();
    localStorage.setItem(STORAGE_KEY, 'dismissed');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && shown && !document.getElementById('lc-modal')?.classList.contains('hidden')) {
      hide();
      localStorage.setItem(STORAGE_KEY, 'dismissed');
    }
  });

  document.getElementById('lc-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailEl = document.getElementById('lc-email') as HTMLInputElement | null;
    const errEl = document.getElementById('lc-error');
    const successEl = document.getElementById('lc-success');
    const submitBtn = document.getElementById('lc-submit') as HTMLButtonElement | null;
    const formEl = document.getElementById('lc-form');

    const email = emailEl?.value?.trim() || '';
    if (!email || !email.includes('@')) {
      errEl?.classList.remove('hidden');
      return;
    }
    errEl?.classList.add('hidden');
    if (submitBtn) { submitBtn.textContent = 'Sending…'; submitBtn.disabled = true; }

    let saved = false;
    try {
      // Static domain: no local serverless routes (same constraint as shop
      // checkout). Per DESIGN_BRIEF, leads go to the portal subscribe endpoint.
      const res = await fetch('https://portal.greenguard-usa.com/api/leads/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, source: 'lead_magnet' }),
      });
      saved = res.ok || res.status === 409;
    } catch (err) {
      console.warn('Lead capture request failed:', err);
    }

    if (!saved) {
      if (submitBtn) { submitBtn.textContent = 'Send Me the Guide'; submitBtn.disabled = false; }
      if (errEl) { errEl.textContent = 'Something went wrong. Try again.'; errEl.classList.remove('hidden'); }
      return;
    }

    localStorage.setItem(STORAGE_KEY, 'submitted');
    if (formEl) (formEl as HTMLElement).style.display = 'none';
    successEl?.classList.remove('hidden');

    if (typeof window.gtag === 'function') {
      window.gtag('event', 'lead_magnet_signup', { event_category: 'lead', event_label: email });
      window.gtag('event', 'generate_lead', { event_category: 'lead_magnet', value: 1 });
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Lead', { content_name: 'Lead Magnet Signup' });
      }
    }

    setTimeout(hide, 2500);
  });
})();
</script>
