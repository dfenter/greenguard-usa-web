---
import { getCustomerCount, formatCount } from '../lib/customers';

const count = await getCustomerCount();
const display = formatCount(count);
---

<div
  class="inline-flex items-center gap-2.5 rounded-full px-4 py-2 bg-ivory"
  style="border: 1px solid var(--hairline); box-shadow: 0 1px 2px rgba(20,32,26,.05);"
>
  <span class="relative flex h-2 w-2" aria-hidden="true">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-60" style="background: var(--sage);"></span>
    <span class="relative inline-flex rounded-full h-2 w-2" style="background: var(--moss);"></span>
  </span>
  <span class="text-sm text-soft">
    Trusted by <strong class="font-semibold" style="color: var(--pine);">{display}</strong> Austin families
  </span>
</div>
