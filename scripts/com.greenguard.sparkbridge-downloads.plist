<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.greenguard.sparkbridge-downloads</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/lucille/greenguard-usa-web/scripts/sparkbridge-downloads.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/lucille/greenguard-usa-web</string>

  <!-- gh lives in /opt/homebrew/bin; launchd's default PATH omits it. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Nightly release download snapshot at 03:30 local time. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/lucille/greenguard-usa-web/scripts/sparkbridge-downloads.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/lucille/greenguard-usa-web/scripts/sparkbridge-downloads.error.log</string>
</dict>
</plist>
