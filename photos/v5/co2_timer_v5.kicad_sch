	(title_block
		(title "GreenGuard CO2 Trap Timer")
		(date "2026-08-11")
		(rev "5.0")
		(company "GreenGuard USA")
		(comment 1 "ATtiny84A + DS3231M(+supercap) + TM1637 + DRV8871 bistable solenoid")
		(comment 2 "HW fail-safe: TPS3700 VM supervisor -> /VM_OK selects two SN74LVC1G3157 muxes for deterministic takeover")
		(comment 3 "All 9V/12V sources OR-ed (SS34) then fused (F1); C1+C19 are 2x1000uF VM reservoir/sag support")
		(comment 4 "Netlist authority: NETLIST.md Rev 2026-08-11")
	)
