		(company "GreenGuard USA")
		(comment 1 "ATtiny84A + DS3231M(+supercap) + TM1637 + DRV8871 bistable solenoid")
		(comment 2 "HW fail-safe: TPS3839 supervisor -> 74LVC1G123 one-shot -> DRV IN2 (CLOSE) diode-OR")
