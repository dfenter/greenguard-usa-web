{
  "buildCommand": "python3 _scripts/build_vercel.py",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sparkbridge/fleetops",
      "destination": "/sparkbridge/#fleetops",
      "permanent": true
    },
    {
      "source": "/sparkbridge/sentinel",
      "destination": "/sparkbridge/#sentinel",
      "permanent": true
    },
    {
      "source": "/sparkbridge/sparklink",
      "destination": "/sparkbridge/#sparklink",
      "permanent": true
    },
    {
      "source": "/sparkbridge/sparkid",
      "destination": "/sparkbridge/#sparkid",
      "permanent": true
    },
    {
      "source": "/sparkbridge/sparkcalc",
      "destination": "/sparkbridge/#sparkcalc",
      "permanent": true
    },
    {
      "source": "/sparkbridge/passage",
      "destination": "/sparkbridge/#passage",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mqtt.greenguard-usa.com"
        }
      ],
      "destination": "/sparkbridge",
      "permanent": true
    },
    {
      "source": "/:path((?!sparkbridge|robots\\.txt|favicon\\.ico|sitemap.+).+)",
      "has": [
        {
          "type": "host",
          "value": "mqtt.greenguard-usa.com"
        }
      ],
      "destination": "https://www.greenguard-usa.com/:path",
      "permanent": true
    },
    {
      "source": "/sparkbridge/lineup",
      "destination": "/sparkbridge/products",
      "permanent": true
    },
    {
      "source": "/sparkbridge/modules",
      "destination": "/sparkbridge/products",
      "permanent": true
    },
    {
      "source": "/sparkbridge/spec",
      "destination": "/sparkbridge/docs#sb-mqtt5",
      "permanent": true
    },
    {
      "source": "/sparkbridge/resources",
      "destination": "/sparkbridge/docs#evidence",
      "permanent": true
    },
    {
      "source": "/sparkbridge-mqtt",
      "destination": "https://mqtt.greenguard-usa.com/sparkbridge",
      "permanent": true
    },
    {
      "source": "/sparkbridge-mqtt/:path*",
      "destination": "https://mqtt.greenguard-usa.com/sparkbridge/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services-v2",
      "destination": "/services",
      "permanent": false
    },
    {
      "source": "/co2-tank-delivery-austin",
      "destination": "/co2delivery",
      "permanent": true
    },
    {
      "source": "/co2-trap-rental-austin",
      "destination": "/traprental",
      "permanent": true
    },
    {
      "source": "/greenguard-barrier-treatment",
      "destination": "/barrier",
      "permanent": true
    },
    {
      "source": "/mosquito-bucket-of-doom-instructions",
      "destination": "/product-bucket-of-doom",
      "permanent": true
    },
    {
      "source": "/co2-mosquito-trap-placement",
      "destination": "/trapplacement",
      "permanent": true
    },
    {
      "source": "/mosquito-control-austin",
      "destination": "/mosquito-control-austin-texas",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "new.greenguard-usa.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/zelda/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/tactics3d/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/reviews.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/products-feed.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=UTF-8"
        }
      ]
    },
    {
      "source": "/:path((?!_next).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/play/:slug/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/play/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path((?!sparkbridge).*)",
      "has": [
        {
          "type": "host",
          "value": "mqtt.greenguard-usa.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/sparkbridge/:file(tck-.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
