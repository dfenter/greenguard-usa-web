<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ops.__TENANT__.winback</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__AGENT__/winback.py</string>
  </array>

  <!-- Run every Monday at 9:30 AM CT -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__AGENT__/logs/winback.log</string>
  <key>StandardErrorPath</key>
  <string>__AGENT__/logs/winback.error.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
		<key>OPS_TENANT</key>
		<string>__TENANT__</string>
  </dict>
</dict>
</plist>
