---
export interface Props {
  title?: string
  description?: string
  canonical?: string
}
const {
  title = 'GreenGuard USA — CO₂ Mosquito Control Austin TX',
  description = 'Science-based CO₂ mosquito trap service for Austin-area homes. No spraying, no chemicals, just results. Free trial available.',
  canonical = 'https://www.greenguard-usa.com',
} = Astro.props
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="google-site-verification" content="6zLnavgU0DQC_Xcp1IVBVmsHQA8-hboNyqe4sNnNMAM" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.ico" />
  <slot name="head" />
  <!-- GA4 + Google Ads -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-K2R5H2Z23X"></script>
  <script>
    window.dataLayer=window.dataLayer||[];
    function gtag(){dataLayer.push(arguments)}
    gtag('js',new Date());
    gtag('config','G-K2R5H2Z23X');
    gtag('config','AW-16913987571');
  </script>
  <!-- Meta Pixel -->
  <script>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
    (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init','2225826221565752');
    fbq('track','PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=2225826221565752&ev=PageView&noscript=1"/></noscript>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green: #7dffaa;
      --green-dim: #a8edc0;
      --gold: #c9a84c;
      --bg: #0d1a10;
      --bg2: #1a2e1f;
      --bg3: #243627;
      --text: #d4e6ca;
      --text-dim: rgba(212,230,202,0.6);
      --text-faint: rgba(212,230,202,0.35);
      --border: rgba(122,171,130,0.18);
      --radius: 12px;
      --font: 'Nunito Sans', system-ui, sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--text); font-family: var(--font); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    img, video { max-width: 100%; display: block; }

    /* Scroll reveal */
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity 0.65s ease, transform 0.65s ease; }
    .reveal.visible { opacity: 1; transform: none; }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }

    /* Utilities */
    .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    .tag { display: inline-block; padding: 4px 12px; border-radius: 100px; background: rgba(125,255,170,0.12); color: var(--green); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
    .btn-primary { display: inline-block; padding: 14px 32px; border-radius: 8px; background: var(--green); color: var(--bg); font-weight: 900; font-size: 1rem; font-family: var(--font); border: none; cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; text-decoration: none; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(125,255,170,0.25); }
    .btn-outline { display: inline-block; padding: 13px 28px; border-radius: 8px; border: 1px solid var(--border); color: var(--text-dim); font-weight: 700; font-size: 0.9rem; font-family: var(--font); transition: border-color 0.15s, color 0.15s; text-decoration: none; }
    .btn-outline:hover { border-color: var(--green); color: var(--green); }
    .divider { width: 100%; height: 1px; background: var(--border); margin: 80px 0; }
    .section { padding: 80px 0; }
    .section-label { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: var(--green); margin-bottom: 12px; }
    .section-title { font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 900; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 16px; }
    .section-sub { font-size: 1.05rem; color: var(--text-dim); line-height: 1.7; max-width: 580px; }
    .card { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; }

    @media (max-width: 768px) {
      .section { padding: 60px 0; }
      .section-title { font-size: 1.8rem; }
    }
  </style>
</head>
<body>
  <slot />
  <script>
    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } })
    }, { threshold: 0.12 })
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el))
  </script>
</body>
</html>
