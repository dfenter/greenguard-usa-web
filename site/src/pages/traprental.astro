---
import Base from '../layouts/Base.astro'
---
<Base title="CO₂ Trap Rental — GreenGuard USA" description="Rent a professional Biogents or Mosqitter CO₂ mosquito trap. Full service included — we handle tanks, maintenance, and seasonal adjustments.">

<nav id="site-nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">Green<span>Guard</span> USA<small>Smart · Safe · Effective</small></a>
    <button class="hamburger" id="hamburger"><span></span><span></span><span></span></button>
    <div class="nav-links" id="nav-links">
      <a href="/services" class="nav-link">Services</a>
      <a href="/traprental" class="nav-link active">Trap Rental</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href="/faq" class="nav-link">FAQ</a>
      <a href="https://portal.greenguard-usa.com/login" class="nav-link">My Account</a>
      <a href="/book" class="btn-gold">Book Consultation</a>
    </div>
  </div>
</nav>

<section class="page-hero">
  <div class="container">
    <div class="tag reveal" style="margin-bottom:16px;">Full Service · All-Inclusive</div>
    <h1 class="reveal">CO₂ Trap <span>Rental Program</span></h1>
    <p class="page-sub reveal">The completely hands-off experience. We own and manage everything — traps, CO₂, maintenance, and seasonal adjustments. You just enjoy your yard.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-label reveal" style="margin-bottom:8px;">Biogents BG-Mosquitaire</div>
    <h2 class="section-title reveal">The gold standard for residential yards</h2>
    <p class="section-sub reveal">Engineered in Germany. IP68 waterproof, low power, pole-mounted. Used in independent studies and government research programs worldwide. Proven in Austin's climate.</p>

    <div class="rental-grid">

      <div class="rental-card reveal">
        <div class="rental-img-wrap">
          <img src="/images/mosquitairesingle.jpg" alt="Biogents CO₂ 1 Trap" />
          <div class="rental-badge">Most Popular</div>
        </div>
        <div class="rental-body">
          <h3>Biogents CO₂ Service — 1 Trap</h3>
          <div class="rental-price">$159.99<span>/mo</span></div>
          <p>Perfect for standard Austin residential lots up to ⅓ acre. One trap placed at the optimal location identified during your property assessment.</p>
          <ul class="feature-list">
            <li>1 Biogents BG-Mosquitaire trap</li>
            <li>Monthly CO₂ tank exchange included</li>
            <li>Attractant bait check & refill</li>
            <li>Full maintenance & adjustments</li>
            <li>No equipment ownership needed</li>
          </ul>
          <a href="https://cal.com/greenguard-usa/biogents-co2-1" class="btn-gold" target="_blank" rel="noopener">Schedule Service →</a>
        </div>
      </div>

      <div class="rental-card reveal reveal-delay-1">
        <div class="rental-img-wrap">
          <img src="/images/mosquitairedouble.webp" alt="Biogents CO₂ 2 Traps" />
          <div class="rental-badge">Recommended for ½+ acre</div>
        </div>
        <div class="rental-body">
          <h3>Biogents CO₂ Service — 2 Traps</h3>
          <div class="rental-price">$266.99<span>/mo</span></div>
          <p>Two strategically placed traps for larger properties, corner lots, or homes with multiple outdoor living areas. Greater coverage, faster population reduction.</p>
          <ul class="feature-list">
            <li>2 Biogents BG-Mosquitaire traps</li>
            <li>Monthly CO₂ tank exchanges included</li>
            <li>Attractant bait check & refill</li>
            <li>Full maintenance & adjustments</li>
            <li>No equipment ownership needed</li>
          </ul>
          <a href="https://cal.com/greenguard-usa/biogents-co2-2" class="btn-gold" target="_blank" rel="noopener">Schedule Service →</a>
        </div>
      </div>

      <div class="rental-card reveal reveal-delay-2">
        <div class="rental-img-wrap">
          <img src="/images/biogentstriple.png" alt="Biogents CO₂ 3 Traps" />
          <div class="rental-badge">Estate Coverage</div>
        </div>
        <div class="rental-body">
          <h3>Biogents CO₂ Service — 3 Traps</h3>
          <div class="rental-price">$399.99<span>/mo</span></div>
          <p>Maximum residential coverage for large estates, acreage, or properties with waterfront access, creek corridors, or heavy tree coverage.</p>
          <ul class="feature-list">
            <li>3 Biogents BG-Mosquitaire traps</li>
            <li>Monthly CO₂ tank exchanges included</li>
            <li>Attractant bait check & refill</li>
            <li>Full maintenance & adjustments</li>
            <li>No equipment ownership needed</li>
          </ul>
          <a href="https://cal.com/greenguard-usa/biogents-co2-3" class="btn-gold" target="_blank" rel="noopener">Schedule Service →</a>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="section section-tinted">
  <div class="container">
    <div class="section-label reveal" style="margin-bottom:8px;">Mosqitter Grand</div>
    <h2 class="section-title reveal">Built for high-pressure environments</h2>
    <p class="section-sub reveal">Stainless steel construction. Stronger airflow, higher catch rate. Ideal for larger properties, waterfront homes, and outdoor entertaining spaces where results need to be immediate.</p>

    <div class="two-col" style="margin-top:40px;">

      <div class="rental-card reveal">
        <div class="rental-img-wrap">
          <img src="/images/trap-mosqitter.webp" alt="Mosqitter Grand Rental" />
          <div class="rental-badge">All-Inclusive</div>
        </div>
        <div class="rental-body">
          <h3>Mosqitter Grand Rental</h3>
          <div class="rental-price">$299.99<span>/mo</span></div>
          <p>Complete management of your Mosqitter Grand. Tank hookup, bait pack, and all maintenance included in one flat monthly rate. No surprises.</p>
          <ul class="feature-list">
            <li>Mosqitter Grand trap included</li>
            <li>CO₂ hookup & bait pack included</li>
            <li>Full maintenance & seasonal adjustments</li>
            <li>No equipment ownership needed</li>
          </ul>
          <a href="https://cal.com/greenguard-usa/mosqitter-rental" class="btn-gold" target="_blank" rel="noopener">Schedule Service →</a>
        </div>
      </div>

      <div class="rental-card reveal reveal-delay-1">
        <div class="rental-img-wrap">
          <img src="/images/trap-mosqitter.webp" alt="Mosqitter Grand Service" style="object-position:center right;" />
          <div class="rental-badge">Own Your Trap</div>
        </div>
        <div class="rental-body">
          <h3>Mosqitter Grand Service</h3>
          <div class="rental-price">$129.99<span>/mo</span></div>
          <p>You own the Mosqitter Grand. We handle everything else — CO₂ hookup, bait, maintenance, and seasonal adjustments. All-inclusive monthly service, no nickel-and-diming.</p>
          <ul class="feature-list">
            <li>CO₂ hookup & bait pack included</li>
            <li>Full maintenance & adjustments</li>
            <li>Pairs with any tank delivery plan</li>
          </ul>
          <a href="https://cal.com/greenguard-usa/mosqitter-service" class="btn-gold" target="_blank" rel="noopener">Schedule Service →</a>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container" style="text-align:center;max-width:580px;margin:0 auto;">
    <div class="section-label reveal" style="margin-bottom:16px;">Not sure which plan is right?</div>
    <h2 class="section-title reveal">Start with a property assessment.</h2>
    <p class="section-sub reveal" style="margin:0 auto 32px;">We evaluate your property, identify breeding zones, and recommend the optimal trap placement — at no charge.</p>
    <a href="https://cal.com/greenguard-usa/property-assessment" class="btn-gold reveal" style="font-size:1rem;padding:14px 36px;" target="_blank" rel="noopener">Schedule Property Assessment →</a>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-bottom" style="border-top:1px solid var(--border);padding-top:24px;">
    <div>© {new Date().getFullYear()} GreenGuard USA · Austin, TX</div>
    <div>Pesticide-free · Pollinator-safe · Family-owned</div>
  </div>
</footer>

<script>
  const obs = new IntersectionObserver(e => { e.forEach(el => { if (el.isIntersecting) { el.target.classList.add('visible'); obs.unobserve(el.target) } }) }, { threshold: 0.1 })
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el))
  const ham = document.getElementById('hamburger'); const links = document.getElementById('nav-links')
  ham.addEventListener('click', () => { links.classList.toggle('open'); ham.classList.toggle('active') })
  links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { links.classList.remove('open'); ham.classList.remove('active') }))
</script>

<style>
#site-nav { position:sticky;top:0;z-index:100;background:rgba(13,26,16,0.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--border); }
.nav-inner { display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px; }
.nav-logo { font-weight:900;font-size:1.05rem;letter-spacing:-0.02em;line-height:1.1;flex-shrink:0;text-decoration:none;color:#d4e6ca; }
.nav-logo span { color:var(--green); }
.nav-logo small { display:block;font-size:0.5rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:rgba(212,230,202,0.35); }
.nav-links { display:flex;align-items:center;gap:4px; }
.nav-link { font-size:0.88rem;font-weight:700;color:rgba(212,230,202,0.7);padding:6px 10px;border-radius:4px;transition:color .15s;text-decoration:none; }
.nav-link:hover,.nav-link.active { color:#d4e6ca; }
.hamburger { display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:8px; }
.hamburger span { display:block;width:24px;height:2px;background:#d4e6ca;transition:all .25s; }
.hamburger.active span:nth-child(1) { transform:translateY(7px) rotate(45deg); }
.hamburger.active span:nth-child(2) { opacity:0; }
.hamburger.active span:nth-child(3) { transform:translateY(-7px) rotate(-45deg); }
.btn-gold { display:inline-block;padding:12px 28px;border-radius:4px;background:var(--gold);color:#0d1a10;font-weight:800;font-size:0.88rem;font-family:var(--font);border:none;cursor:pointer;transition:background .2s,transform .15s;text-decoration:none;white-space:nowrap; }
.btn-gold:hover:not([disabled]) { background:#e8d08a;transform:translateY(-2px); }

.page-hero { background:linear-gradient(160deg,#070f09 0%,#0d1a10 50%,#152318 100%);padding:80px 0 60px;border-bottom:1px solid var(--border); }
.page-hero h1 { font-size:clamp(2.2rem,4.5vw,3.2rem);font-weight:900;line-height:1.1;letter-spacing:-0.03em;margin-bottom:20px; }
.page-hero h1 span { color:var(--green); }
.page-sub { font-size:1.05rem;color:var(--text-dim);line-height:1.75;max-width:580px; }
.rental-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:28px;margin-top:48px; }
.two-col { display:grid;grid-template-columns:1fr 1fr;gap:28px; }
.rental-card { background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:12px;overflow:hidden;display:flex;flex-direction:column; }
.rental-img-wrap { position:relative;aspect-ratio:16/9;overflow:hidden; }
.rental-img-wrap img { width:100%;height:100%;object-fit:cover;display:block; }
.rental-badge { position:absolute;top:12px;left:12px;padding:4px 12px;border-radius:100px;background:rgba(201,168,76,0.9);color:#0d1a10;font-size:0.72rem;font-weight:800;letter-spacing:0.08em;text-transform:uppercase; }
.rental-body { padding:24px;display:flex;flex-direction:column;gap:12px;flex:1; }
.rental-body h3 { font-size:1.05rem;font-weight:900; }
.rental-price { font-size:1.6rem;font-weight:900;color:var(--gold); }
.rental-price span { font-size:0.9rem;color:var(--text-faint);font-weight:600; }
.rental-body p { font-size:0.88rem;color:var(--text-dim);line-height:1.65; }
.feature-list { list-style:none;flex:1;display:flex;flex-direction:column;gap:6px; }
.feature-list li { font-size:0.85rem;color:var(--text-dim);padding-left:18px;position:relative; }
.feature-list li::before { content:'✓';position:absolute;left:0;color:var(--gold);font-weight:800; }
.cta-section { padding:80px 0;background:linear-gradient(160deg,var(--bg2),var(--bg3)); }
.site-footer { border-top:1px solid var(--border);padding:28px 0; }
.footer-bottom { display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:0.78rem;color:var(--text-faint); }
@media (max-width:768px) {
  .hamburger { display:flex; }
  .nav-links { display:none;flex-direction:column;align-items:flex-start;gap:4px;position:absolute;top:64px;left:0;right:0;background:rgba(13,26,16,0.98);border-bottom:1px solid var(--border);padding:16px 24px 20px; }
  .nav-links.open { display:flex; }
  .two-col,.rental-grid { grid-template-columns:1fr !important; }
}
</style>
</Base>
