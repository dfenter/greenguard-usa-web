---
import Base from '../layouts/Base.astro'
---
<Base title="Book a Free Consultation · GreenGuard USA" description="Schedule your free mosquito control consultation with GreenGuard USA in Austin, TX. No chemicals, no commitment.">
<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80px 24px; text-align: center; }
  .label { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: var(--green); margin-bottom: 12px; }
  h1 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: -0.02em; margin-bottom: 16px; }
  p { font-size: 1.05rem; color: var(--text-dim); line-height: 1.7; max-width: 520px; margin: 0 auto 28px; }
  .cal-wrap { width: 100%; max-width: 900px; min-height: 700px; border-radius: 16px; overflow: hidden; border: 1px solid var(--border); margin-top: 16px; }
  iframe { width: 100%; height: 750px; border: none; }
  #zip-input:focus, #city-input:focus { border-color: rgba(201,168,76,0.6); outline: none; }
</style>

<nav id="site-nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">Green<span>Guard</span> USA<small>Smart · Safe · Effective</small></a>
    <div class="nav-links">
      <a href="/services" class="nav-link">Services</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href="/faq" class="nav-link">FAQ</a>
      <a href="/about" class="nav-link">About</a>
      <a href="https://portal.greenguard-usa.com/login" class="nav-link">My Account</a>
      <a href="/book" class="btn-gold">Book Consultation</a>
    </div>
  </div>
</nav>

<div class="page">
  <div class="label">Get Started</div>
  <h1>Book Your Free <span style="color:var(--green)">Consultation</span></h1>
  <p>We'll assess your property, recommend the right system, and answer every question — no commitment required.</p>

  <!-- City + ZIP gate — required before Cal.com loads -->
  <div id="location-gate" style="width:100%;max-width:480px;margin-bottom:32px;">
    <div style="font-size:0.78rem;font-weight:700;color:var(--text-faint);margin-bottom:14px;letter-spacing:0.04em;">First, confirm your location</div>

    <div style="display:flex;gap:10px;margin-bottom:10px;">
      <input id="city-input" type="text" placeholder="City" autocomplete="address-level2"
        style="flex:1;padding:12px 16px;border-radius:8px;border:1px solid rgba(122,171,130,0.3);background:rgba(255,255,255,0.05);color:#d4e6ca;font-size:0.95rem;font-family:inherit;outline:none;" />
      <input id="zip-input" type="text" inputmode="numeric" maxlength="5" placeholder="ZIP code" autocomplete="postal-code"
        style="width:120px;padding:12px 16px;border-radius:8px;border:1px solid rgba(122,171,130,0.3);background:rgba(255,255,255,0.05);color:#d4e6ca;font-size:0.95rem;font-family:inherit;outline:none;text-align:center;letter-spacing:0.12em;" />
    </div>
    <button id="zip-btn"
      style="width:100%;padding:13px 22px;border-radius:8px;background:#c9a84c;color:#0d1a10;font-weight:800;font-size:0.95rem;border:none;cursor:pointer;font-family:inherit;">
      Check My Area &amp; Book
    </button>
    <div id="zip-result" style="margin-top:10px;font-size:0.85rem;font-weight:700;min-height:22px;"></div>
  </div>

  <div id="cal-wrap" class="cal-wrap" style="display:none;">
    <iframe id="cal-iframe" src="" title="Book a consultation"></iframe>
  </div>
</div>

<footer style="border-top:1px solid var(--border);padding:28px 24px;text-align:center;font-size:0.8rem;color:var(--text-faint);">
  © 2025 GreenGuard USA · <a href="/" style="color:var(--text-faint);">Home</a>
</footer>

<script>
const DEPOT_LAT = 30.2741
const DEPOT_LNG = -97.7602
const MAX_MILES = 45

function haversine(lat1, lng1, lat2, lng2) {
  const R = 3958.8
  const dLat = (lat2 - lat1) * Math.PI / 180
  const dLng = (lng2 - lng1) * Math.PI / 180
  const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLng/2)**2
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a))
}

document.getElementById('zip-btn')?.addEventListener('click', checkZip)
document.getElementById('zip-input')?.addEventListener('keydown', e => { if (e.key === 'Enter') checkZip() })
document.getElementById('city-input')?.addEventListener('keydown', e => { if (e.key === 'Enter') checkZip() })

async function checkZip() {
  const city = document.getElementById('city-input')?.value?.trim()
  const zip  = document.getElementById('zip-input')?.value?.trim()
  const result = document.getElementById('zip-result')

  if (!city) {
    result.style.color = '#ffb060'
    result.textContent = 'Please enter your city.'
    document.getElementById('city-input')?.focus()
    return
  }
  if (!zip || zip.length !== 5 || !/^\d+$/.test(zip)) {
    result.style.color = '#ffb060'
    result.textContent = 'Please enter a valid 5-digit ZIP code.'
    document.getElementById('zip-input')?.focus()
    return
  }

  result.style.color = 'rgba(212,230,202,0.5)'
  result.textContent = 'Checking…'

  try {
    const res = await fetch(`https://api.zippopotam.us/us/${zip}`)
    if (!res.ok) throw new Error('not found')
    const data = await res.json()
    const place = data.places?.[0]
    const lat = parseFloat(place?.latitude)
    const lng = parseFloat(place?.longitude)
    const miles = haversine(DEPOT_LAT, DEPOT_LNG, lat, lng)

    if (miles <= MAX_MILES) {
      result.style.color = '#7dffaa'
      result.textContent = `✓ We serve ${city}, TX ${zip} (${Math.round(miles)} mi away) — booking form loading below!`
      if (window.gtag) gtag('event', 'zip_check', { zip, city, in_service_area: true, miles: Math.round(miles) })
      revealCalendar(city, zip)
    } else {
      result.style.color = '#ffb060'
      result.textContent = `We don't currently serve ${city} ${zip} (${Math.round(miles)} mi from Austin). We're expanding — leave your email at greenguard-usa.com to be notified.`
      if (window.gtag) gtag('event', 'zip_check', { zip, city, in_service_area: false, miles: Math.round(miles) })
    }
  } catch {
    result.style.color = '#ffb060'
    result.textContent = "Could not verify that ZIP code. Try again or call us at (512) 555-0100."
  }
}

function revealCalendar(city, zip) {
  // Hide the gate form, show Cal.com with city+zip prefilled in the location/notes field
  document.getElementById('location-gate').style.display = 'none'
  const calWrap = document.getElementById('cal-wrap')
  const calIframe = document.getElementById('cal-iframe')
  const location = encodeURIComponent(`${city}, TX ${zip}`)
  calIframe.src = `https://cal.com/greenguard-usa/consultation?location=${location}&notes=${encodeURIComponent(`City: ${city} | ZIP: ${zip}`)}`
  calWrap.style.display = 'block'
  calWrap.scrollIntoView({ behavior: 'smooth', block: 'start' })
}
</script>
</Base>
