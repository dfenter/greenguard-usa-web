---
import Base from '../layouts/Base.astro'
---
<Base title="Pricing · GreenGuard USA" description="Transparent pricing for CO₂ mosquito trap rentals and tank service in Austin, TX. No contracts, no chemicals.">
<style>
  .page { padding: 100px 0 80px; }
  .label { font-size:0.72rem;font-weight:800;letter-spacing:0.15em;text-transform:uppercase;color:var(--green);margin-bottom:12px;text-align:center; }
  h1 { font-size:clamp(2rem,4vw,3rem);font-weight:900;letter-spacing:-0.02em;text-align:center;margin-bottom:12px; }
  .sub { text-align:center;color:var(--text-dim);font-size:1.05rem;line-height:1.7;max-width:560px;margin:0 auto 64px; }
  .section-label { font-size:0.72rem;font-weight:800;letter-spacing:0.15em;text-transform:uppercase;color:var(--gold);margin-bottom:28px;margin-top:56px; }
  .plans { display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;margin-bottom:16px; }
  .plan { background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:14px;padding:28px;display:flex;flex-direction:column;gap:10px; }
  .plan.featured { border-color:rgba(201,168,76,0.4);background:rgba(201,168,76,0.05); }
  .plan-name { font-size:1.1rem;font-weight:900; }
  .plan-price { font-size:2rem;font-weight:900;color:var(--gold);line-height:1; }
  .plan-period { font-size:0.78rem;color:var(--text-faint);margin-top:2px; }
  .plan-desc { font-size:0.85rem;color:var(--text-dim);line-height:1.6;margin:8px 0; }
  .plan-features { list-style:none;display:flex;flex-direction:column;gap:6px;margin:0;flex:1; }
  .plan-features li { font-size:0.85rem;color:var(--text-dim);padding-left:18px;position:relative; }
  .plan-features li::before { content:'✓';position:absolute;left:0;color:var(--gold);font-weight:800; }
  .plan-cta { display:inline-block;margin-top:auto;padding:12px 24px;border-radius:8px;background:var(--gold);color:#0d1a10;font-weight:800;font-size:0.9rem;text-align:center; }
  .plan-cta:hover { background:#e8d08a; }
  .addon-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px; }
  .addon { background:rgba(255,255,255,0.02);border:1px solid var(--border);border-radius:10px;padding:16px 20px;display:flex;justify-content:space-between;align-items:center; }
  .addon-name { font-size:0.88rem;font-weight:700; }
  .addon-price { font-size:0.95rem;font-weight:900;color:var(--gold); }
  .note { font-size:0.8rem;color:var(--text-faint);text-align:center;margin-top:40px; }
  @media (max-width:768px) { .page { padding:64px 0 60px; } }
</style>

<nav id="site-nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">Green<span>Guard</span> USA<small>Smart · Safe · Effective</small></a>
    <button class="hamburger" id="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
    <div class="nav-links" id="nav-links">
      <a href="/services" class="nav-link">Services</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href="/faq" class="nav-link">FAQ</a>
      <a href="/about" class="nav-link">About</a>
      <a href="https://portal.greenguard-usa.com/login" class="nav-link">My Account</a>
      <a href="/book" class="btn-gold">Book Consultation</a>
    </div>
  </div>
</nav>

<div class="page">
  <div class="container">
    <div class="label">Transparent Pricing</div>
    <h1>Simple, honest <span style="color:var(--green)">pricing</span></h1>
    <p class="sub">No contracts, no spraying fees, no surprise charges. Just effective mosquito control billed monthly.</p>

    <div class="section-label">Biogents BG-Mosquitaire Rentals</div>
    <div class="plans">
      <div class="plan">
        <div class="plan-name">1 Trap</div>
        <div class="plan-price">$159<span style="font-size:1rem">.99</span></div>
        <div class="plan-period">per month</div>
        <p class="plan-desc">Ideal for smaller yards up to ⅓ acre. Includes trap, CO₂ tank service, and monthly maintenance.</p>
        <ul class="plan-features">
          <li>1 Biogents BG-Mosquitaire</li>
          <li>CO₂ tank delivery & swap</li>
          <li>Monthly tech visit</li>
          <li>Pesticide-free</li>
        </ul>
        <a href="/book" class="plan-cta">Get Started</a>
      </div>
      <div class="plan featured">
        <div class="plan-name">2 Traps <span style="font-size:0.7rem;color:var(--gold);font-weight:800;letter-spacing:0.08em;text-transform:uppercase;margin-left:8px;">Most Popular</span></div>
        <div class="plan-price">$266<span style="font-size:1rem">.99</span></div>
        <div class="plan-period">per month</div>
        <p class="plan-desc">Best coverage for standard Austin lots up to ½ acre. Maximum protection for outdoor entertaining areas.</p>
        <ul class="plan-features">
          <li>2 Biogents BG-Mosquitaire</li>
          <li>CO₂ tank delivery & swap</li>
          <li>Monthly tech visit</li>
          <li>Pesticide-free</li>
        </ul>
        <a href="/book" class="plan-cta">Get Started</a>
      </div>
      <div class="plan">
        <div class="plan-name">3 Traps</div>
        <div class="plan-price">$399<span style="font-size:1rem">.99</span></div>
        <div class="plan-period">per month</div>
        <p class="plan-desc">Full-yard coverage for larger properties and high-pressure mosquito environments.</p>
        <ul class="plan-features">
          <li>3 Biogents BG-Mosquitaire</li>
          <li>CO₂ tank delivery & swap</li>
          <li>Monthly tech visit</li>
          <li>Pesticide-free</li>
        </ul>
        <a href="/book" class="plan-cta">Get Started</a>
      </div>
    </div>

    <div class="section-label">Mosqitter Grand</div>
    <div class="plans" style="max-width:340px;">
      <div class="plan">
        <div class="plan-name">Mosqitter Grand Rental</div>
        <div class="plan-price">$299<span style="font-size:1rem">.99</span></div>
        <div class="plan-period">per month · service $129.99</div>
        <p class="plan-desc">Stainless steel commercial-grade trap for large properties, waterfront homes, and high-pressure environments.</p>
        <ul class="plan-features">
          <li>1 Mosqitter Grand</li>
          <li>Monthly service visit</li>
          <li>CO₂ tank hookup</li>
          <li>Higher catch rate</li>
        </ul>
        <a href="/book" class="plan-cta">Get Started</a>
      </div>
    </div>

    <div class="section-label">CO₂ Tank Service</div>
    <div class="addon-grid">
      {[
        { name: '1 Tank / month', price: '$89.99' },
        { name: '2 Tanks / month', price: '$139.99' },
        { name: '3 Tanks / month', price: '$189.99' },
        { name: 'CO₂ Tank + Timer Bundle', price: '$124.99' },
      ].map(a => (
        <div class="addon">
          <span class="addon-name">{a.name}</span>
          <span class="addon-price">{a.price}</span>
        </div>
      ))}
    </div>

    <div class="section-label">One-Time Services</div>
    <div class="addon-grid">
      {[
        { name: 'Mosquito Barrier Spray', price: 'From $149' },
        { name: 'Bait Station Install', price: 'Quoted' },
        { name: 'Trap Installation', price: 'Quoted' },
        { name: 'Weekend Surcharge', price: '$25' },
      ].map(a => (
        <div class="addon">
          <span class="addon-name">{a.name}</span>
          <span class="addon-price">{a.price}</span>
        </div>
      ))}
    </div>

    <p class="note">All prices include Austin service area. Free property assessment with every new signup. Pause or cancel anytime.</p>

    <div style="text-align:center;margin-top:56px;">
      <a href="/book" class="btn-gold" style="font-size:1rem;padding:16px 40px;">Book Your Free Consultation</a>
    </div>
  </div>
</div>

<footer style="border-top:1px solid var(--border);padding:40px 24px 28px;text-align:center;font-size:0.8rem;color:var(--text-faint);">
  © 2025 GreenGuard USA · Austin, TX · <a href="/" style="color:var(--text-faint);">Home</a> · <a href="/services" style="color:var(--text-faint);">Services</a>
</footer>

<script>
  const btn = document.getElementById('hamburger')
  const nav = document.getElementById('nav-links')
  btn?.addEventListener('click', () => nav?.classList.toggle('open'))
</script>
</Base>
