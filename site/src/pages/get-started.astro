---
import Base from '../layouts/Base.astro'
import reviewsData from '../data/reviews.json'

const featured = reviewsData.google.reviews.slice(0, 3)
---
<Base
  title="Book a Free Mosquito Assessment · GreenGuard USA"
  description="Book your free Austin property assessment. CO₂ mosquito control — no chemicals, no contracts. 4.9★ · {reviewsData.google.total} Google Reviews."
  canonical="https://www.greenguard-usa.com/get-started"
>

<style>
  * { box-sizing: border-box; }

  .lp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(13,26,16,0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
  }
  .lp-nav-inner {
    max-width: 960px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    height: 60px;
  }
  .lp-logo {
    font-size: 1.15rem; font-weight: 900; letter-spacing: -0.02em;
    color: var(--text); text-decoration: none;
  }
  .lp-logo span { color: var(--green); }
  .lp-logo small {
    display: block; font-size: 0.55rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-faint); margin-top: -2px;
  }
  .lp-badge {
    display: flex; align-items: center; gap: 6px;
    font-size: 0.78rem; font-weight: 700; color: var(--green);
    background: rgba(125,255,170,0.08);
    border: 1px solid rgba(125,255,170,0.2);
    padding: 6px 14px; border-radius: 100px;
  }

  /* Hero */
  .hero {
    padding: 72px 24px 56px;
    text-align: center;
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(125,255,170,0.07) 0%, transparent 70%);
  }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--green);
    background: rgba(125,255,170,0.1); border: 1px solid rgba(125,255,170,0.25);
    padding: 6px 16px; border-radius: 100px; margin-bottom: 24px;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 900; line-height: 1.1; letter-spacing: -0.03em;
    margin-bottom: 20px; max-width: 700px; margin-left: auto; margin-right: auto;
  }
  .hero h1 em { font-style: normal; color: var(--green); }
  .hero p {
    font-size: 1.1rem; color: var(--text-dim); line-height: 1.7;
    max-width: 520px; margin: 0 auto 36px;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--green); color: var(--bg);
    font-weight: 900; font-size: 1.05rem;
    padding: 16px 36px; border-radius: 8px; text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .hero-cta:hover { transform: translateY(-2px); box-shadow: 0 12px 36px rgba(125,255,170,0.3); }

  /* Trust bar */
  .trust-bar {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0;
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    background: rgba(255,255,255,0.015);
  }
  .trust-item {
    display: flex; align-items: center; gap: 8px;
    padding: 18px 28px; font-size: 0.85rem; font-weight: 700;
    color: var(--text-dim); border-right: 1px solid var(--border);
  }
  .trust-item:last-child { border-right: none; }
  .trust-item strong { color: var(--text); }
  .trust-dot { color: var(--green); font-size: 1.1rem; }

  /* Reviews */
  .reviews-section { padding: 64px 24px; }
  .reviews-section h2 {
    text-align: center; font-size: 1.5rem; font-weight: 900;
    letter-spacing: -0.02em; margin-bottom: 36px;
  }
  .reviews-section h2 span { color: var(--green); }
  .reviews-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    max-width: 960px; margin: 0 auto;
  }
  .review-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 12px; padding: 24px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .review-stars { color: #f5c518; font-size: 0.85rem; letter-spacing: 2px; }
  .review-text {
    font-size: 0.9rem; line-height: 1.65; color: var(--text-dim); flex: 1;
  }
  .review-author { font-size: 0.8rem; font-weight: 800; color: var(--text); }

  /* Booking */
  .booking-section { padding: 0 24px 80px; }
  .booking-inner { max-width: 820px; margin: 0 auto; }
  .booking-header {
    text-align: center; margin-bottom: 32px;
  }
  .booking-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900;
    letter-spacing: -0.02em; margin-bottom: 10px;
  }
  .booking-header h2 span { color: var(--green); }
  .booking-header p { font-size: 0.95rem; color: var(--text-dim); }
  .cal-frame {
    width: 100%; min-height: 700px; border: 1px solid var(--border);
    border-radius: 14px; overflow: hidden; background: rgba(255,255,255,0.02);
  }
  #cal-embed { width: 100%; min-height: 700px; }

  /* Footer */
  .lp-footer {
    border-top: 1px solid var(--border); padding: 24px;
    text-align: center; font-size: 0.78rem; color: var(--text-faint);
  }
  .lp-footer a { color: var(--text-faint); text-decoration: underline; }

  @media (max-width: 768px) {
    .hero { padding: 56px 24px 48px; }
    .reviews-grid { grid-template-columns: 1fr; }
    .trust-item { padding: 14px 18px; font-size: 0.78rem; }
    .trust-item:nth-child(even) { border-right: none; }
    .trust-bar { display: grid; grid-template-columns: 1fr 1fr; }
    .cal-frame iframe { height: 800px; }
  }
</style>

<!-- Nav: logo only -->
<nav class="lp-nav">
  <div class="lp-nav-inner">
    <a href="/" class="lp-logo">
      Green<span>Guard</span> USA
      <small>Smart · Safe · Effective</small>
    </a>
    <div class="lp-badge">
      <span>⭐</span> 4.9 · {reviewsData.google.total} Google Reviews
    </div>
  </div>
</nav>

<!-- Hero -->
<section class="hero">
  <div class="hero-tag">🦟 Free Property Assessment</div>
  <h1>Mosquito-Free Yard.<br/><em>No Chemicals.</em></h1>
  <p>Austin's CO₂ trap specialists. We'll assess your property and recommend the right system — no commitment, no pressure, no spraying.</p>
  <a href="#book" class="hero-cta">Book My Free Assessment →</a>
</section>

<!-- Trust bar -->
<div class="trust-bar">
  <div class="trust-item"><span class="trust-dot">⭐</span> <span><strong>4.9 Stars</strong> · {reviewsData.google.total} Google Reviews</span></div>
  <div class="trust-item"><span class="trust-dot">✓</span> <span><strong>100+</strong> Austin Customers</span></div>
  <div class="trust-item"><span class="trust-dot">🌿</span> <span><strong>100%</strong> Pesticide-Free</span></div>
  <div class="trust-item"><span class="trust-dot">📋</span> <span><strong>No</strong> Contracts</span></div>
</div>

<!-- Reviews -->
<section class="reviews-section">
  <h2>What Austin homeowners are <span>saying</span></h2>
  <div class="reviews-grid">
    {featured.map(review => (
      <div class="review-card">
        <div class="review-stars">★★★★★</div>
        <p class="review-text">"{review.text}"</p>
        <div class="review-author">— {review.author} <span style="color:var(--text-faint);font-weight:400">{review.time}</span></div>
      </div>
    ))}
  </div>
</section>

<!-- Booking -->
<section class="booking-section" id="book">
  <div class="booking-inner">
    <div class="booking-header">
      <h2>Book Your <span>Free Assessment</span></h2>
      <p>Pick a time below — we'll come to you, walk the property, and build a plan. Takes 20 minutes.</p>
    </div>
    <div class="cal-frame">
      <div id="cal-embed"></div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="lp-footer">
  © 2026 GreenGuard USA · Austin, TX · <a href="/">greenguard-usa.com</a>
</footer>

<script>
  // Smooth scroll
  document.querySelector('.hero-cta')?.addEventListener('click', (e) => {
    e.preventDefault()
    document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' })
  })

  // Cal.com embed with conversion callbacks
  ;(function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar) }
    let d = C.document
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true }
      if (ar[0] === L) { const api = function () { p(api, arguments) }; const ns = ar[1]; api.q = api.q || []; typeof ns === 'string' ? (cal.ns[ns] = api) && p(api, ar) : p(cal, ar); return }
      p(cal, ar)
    }
  })(window, 'https://app.cal.com/embed/embed.js', 'init')

  Cal('init', { origin: 'https://cal.com' })
  Cal('inline', {
    elementOrSelector: '#cal-embed',
    calLink: 'greenguard-usa/consultation',
    layout: 'month_view',
  })
  // GA4: view the booking page = viewing the service item
  if (window.gtag) {
    gtag('event', 'view_item', {
      currency: 'USD',
      value: 159.99,
      items: [{ item_id: 'CONSULT', item_name: 'Free Mosquito Assessment', item_category: 'Consultation', price: 0 }]
    })
  }

  Cal('on', {
    action: 'bookingSuccessful',
    callback: function () {
      const eventId = 'cal_bk_' + Date.now()
      if (window.fbq) fbq('track', 'Schedule', {}, { eventID: eventId })
      if (window.gtag) {
        gtag('event', 'conversion', { send_to: 'AW-16913987571' })
        gtag('event', 'generate_lead', { currency: 'USD', value: 159.99 })
        gtag('event', 'purchase', {
          transaction_id: eventId,
          currency: 'USD',
          value: 0,
          items: [{ item_id: 'CONSULT', item_name: 'Free Mosquito Assessment', price: 0, quantity: 1 }]
        })
      }
    },
  })

  // GA4: begin_checkout when user interacts with the Cal embed
  let checkoutFired = false
  document.getElementById('cal-embed')?.addEventListener('click', function () {
    if (checkoutFired) return
    checkoutFired = true
    if (window.gtag) gtag('event', 'begin_checkout', {
      currency: 'USD', value: 159.99,
      items: [{ item_id: 'CONSULT', item_name: 'Free Mosquito Assessment', price: 0, quantity: 1 }]
    })
  }, { once: false })
</script>

</Base>
