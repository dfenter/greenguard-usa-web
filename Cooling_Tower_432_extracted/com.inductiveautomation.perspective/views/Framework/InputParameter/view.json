{
  "custom": {
    "DATDifference": 35,
    "IWTDifference": 85,
    "POGTDifference": 120,
    "designApproachTempF": "0",
    "designApproachTempFTarget": 35,
    "designIncomingWaterTempF": 0,
    "designIncomingWaterTempFTarget": 0,
    "key": "AirExpander_1_Aftercooler_1",
    "processOutGasTempF": 0,
    "processOutGasTempFTarget": 0,
    "site": "Irving",
    "stickyValues": {
      "designIncomingWaterTempFTarget": "value",
      "processGasOutTempFTarget": "value"
    }
  },
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\n\t# Load sticky values from DB for this coolingTowerDataID\n\teid = self.params.id\n\tif eid:\n\t\ttry:\n\t\t\tresult = system.db.runNamedQuery(\n\t\t\t\t\"coolingTowerData/getStickyValues\",\n\t\t\t\t{\"coolingTowerDataID\": eid}\n\t\t\t)\n\t\t\tif result.getRowCount() > 0:\n\t\t\t\tv1 = result.getValueAt(0, \"approachTempTarget\")\n\t\t\t\tif v1 is not None:\n\t\t\t\t\tself.params.designApproachTempFTarget = v1\n\t\t\t\tv2 = result.getValueAt(0, \"incomingWaterTempTarget\")\n\t\t\t\tif v2 is not None:\n\t\t\t\t\tself.params.designIncomingWaterTempFTarget = v2\n\t\t\t\tv3 = result.getValueAt(0, \"processGasOutTempTarget\")\n\t\t\t\tif v3 is not None:\n\t\t\t\t\tself.params.processGasOutTempFTarget = v3\n\t\t\t\tv4 = result.getValueAt(0, \"altEquipmentName\")\n\t\t\t\tif v4 is not None and v4 != '':\n\t\t\t\t\tself.params.altEquipmentName = v4\n\t\texcept Exception as e:\n\t\t\tsystem.perspective.print(\"getStickyValues error: \" + str(e))\n\tself.params.loaded = True\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "altEquipmentName": "",
    "designApproachTempF": "0",
    "designApproachTempFTarget": 35,
    "designIncomingWaterTempF": "",
    "designIncomingWaterTempFTarget": 85,
    "enabled": true,
    "id": "",
    "parameter": "AirExpander 1 Aftercooler 1",
    "parameterIds": {
      "designApproachTempF": 3,
      "designApproachTempFTarget": 6,
      "designIncomingWaterTempF": 1,
      "designIncomingWaterTempFTarget": 4,
      "processGasOutTempF": 2,
      "processGasOutTempFTarget": 5
    },
    "processGasOutTempF": "",
    "processGasOutTempFTarget": 120,
    "recordDate": "value",
    "siteId": 10
  },
  "propConfig": {
    "custom.DATDifference": {
      "binding": {
        "config": {
          "expression": "{view.custom.designApproachTempFTarget}-{view.custom.designApproachTempF}"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.IWTDifference": {
      "binding": {
        "config": {
          "expression": "{view.params.designIncomingWaterTempFTarget}-{view.params.designIncomingWaterTempF}"
        },
        "transforms": [
          {
            "code": "\tif value:\n\t\treturn value\n\telse:\n\t\treturn ''",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.POGTDifference": {
      "binding": {
        "config": {
          "expression": "{view.params.processGasOutTempFTarget}-{view.params.processGasOutTempF}"
        },
        "transforms": [
          {
            "code": "\tif value:\n\t\treturn value\n\telse:\n\t\treturn ''",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.designApproachTempF": {
      "binding": {
        "config": {
          "expression": "{view.params.processGasOutTempF}-{view.params.designIncomingWaterTempF}"
        },
        "transforms": [
          {
            "code": "\tif value:\n\t\treturn value\n\telse:\n\t\treturn '0'",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "onChange": {
        "enabled": true,
        "script": "\tself.params.designApproachTempF = currentValue.value"
      },
      "persistent": true
    },
    "custom.designApproachTempFTarget": {
      "binding": {
        "config": {
          "expression": "{view.params.processGasOutTempFTarget}-{view.params.designIncomingWaterTempFTarget}"
        },
        "transforms": [
          {
            "code": "\tif value:\n\t\treturn value\n\telse:\n\t\treturn '0'",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "onChange": {
        "enabled": true,
        "script": "\tself.params.designApproachTempFTarget = currentValue.value"
      },
      "persistent": true
    },
    "custom.designIncomingWaterTempF": {
      "persistent": true
    },
    "custom.designIncomingWaterTempFTarget": {
      "persistent": true
    },
    "custom.key": {
      "binding": {
        "config": {
          "path": "view.params.parameter"
        },
        "transforms": [
          {
            "expression": "replace({value},' ','_')",
            "type": "expression"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.processOutGasTempF": {
      "persistent": true
    },
    "custom.processOutGasTempFTarget": {
      "persistent": true
    },
    "custom.site": {
      "binding": {
        "config": {
          "parameters": {
            "siteId": "{view.params.siteId}"
          },
          "queryPath": "coolingTowerData/getSite"
        },
        "type": "query"
      },
      "persistent": true
    },
    "custom.stickyValues": {
      "persistent": true
    },
    "params.altEquipmentName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.designApproachTempF": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.designApproachTempFTarget": {
