{
  "custom": {},
  "params": {
    "site": "",
    "siteId": 0,
    "sparkPoints": [
      0
    ],
    "worstDev": 0.0,
    "lastEntry": "No data"
  },
  "propConfig": {
    "params.site": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.siteId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sparkPoints": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.worstDev": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.lastEntry": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex",
    "props": {
      "direction": "column",
      "style": {
        "margin": "8px",
        "border": "1px solid #DDDDDD",
        "borderRadius": "6px",
        "padding": "8px",
        "backgroundColor": "#FAFAFA",
        "minWidth": "200px"
      }
    },
    "children": [
      {
        "meta": {
          "name": "SiteName"
        },
        "position": {
          "basis": "28px"
        },
        "props": {
          "style": {
            "fontSize": 14,
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.site"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "StatusDot"
        },
        "position": {
          "basis": "28px"
        },
        "props": {
          "style": {
            "fontSize": 12,
            "fontWeight": "bold",
            "textAlign": "center",
            "borderRadius": "4px",
            "padding": "2px 6px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.worstDev} > 10, \"\u26a0 OUT OF SPEC\", if({view.params.worstDev} > 5, \"\u26a0 WARNING\", \"\u2713 IN SPEC\"))"
              },
              "type": "expr"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if({view.params.worstDev} > 10, \"#FF4444\", if({view.params.worstDev} > 5, \"#FFD700\", \"#70AD47\"))"
              },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.worstDev} > 10, \"#FFFFFF\", if({view.params.worstDev} > 5, \"#333333\", \"#FFFFFF\"))"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Sparkline"
        },
        "position": {
          "basis": "90px"
        },
        "props": {
          "points": [
            0
          ]
        },
        "propConfig": {
          "props.points": {
            "binding": {
              "config": {
                "path": "view.params.sparkPoints"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.sparkline"
      },
      {
        "meta": {
          "name": "LastEntry"
        },
        "position": {
          "basis": "20px"
        },
        "props": {
          "style": {
            "fontSize": 11,
            "color": "#888888",
            "textAlign": "center",
            "fontStyle": "italic"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.lastEntry"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Completeness"
        },
        "position": {
          "basis": "18px"
        },
        "props": {
          "style": {
            "fontSize": 11,
            "color": "#888888",
            "textAlign": "center"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.completeness"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ]
  }
}