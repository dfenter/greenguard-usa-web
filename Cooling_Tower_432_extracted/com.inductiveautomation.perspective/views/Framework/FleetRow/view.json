{
  "custom": {},
  "params": {
    "siteId": 0,
    "siteName": "",
    "region": "",
    "lastEntry": "Never",
    "daysSince": 9999,
    "worstDev": 0.0,
    "completeness": 0,
    "equipment": 0
  },
  "propConfig": {
    "params.siteId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.siteName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.region": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.lastEntry": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.daysSince": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.worstDev": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.completeness": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.equipment": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex",
    "props": {
      "direction": "row",
      "style": {
        "borderBottom": "1px solid #E8E8E8",
        "padding": "0 8px",
        "alignItems": "center",
        "height": "38px",
        "overflow": "hidden"
      }
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "expression": "if({view.params.daysSince} > 30, \"#F9F9F9\", \"#FFFFFF\")"
          },
          "type": "expr"
        }
      }
    },
    "children": [
      {
        "meta": {
          "name": "SiteName"
        },
        "position": {
          "basis": "180px",
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": 13,
            "fontWeight": "bold"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.siteName"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Region"
        },
        "position": {
          "basis": "160px",
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": 12,
            "color": "#666666"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.region"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "LastEntry"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": 12
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.lastEntry"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "DaysAgo"
        },
        "position": {
          "basis": "100px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} >= 9999, \"Never\", toString({view.params.daysSince}) + \"d\")"
              },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} > 30, \"#CC0000\", if({view.params.daysSince} > 14, \"#E07B00\", \"#333333\"))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": 12
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "SpecStatus"
        },
        "position": {
          "basis": "160px",
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": 11,
            "fontWeight": "bold",
            "borderRadius": "4px",
            "padding": "2px 8px",
            "textAlign": "center",
            "maxWidth": "150px",
            "whiteSpace": "nowrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} > 30, \"No data\", if({view.params.worstDev} > 10, \"\u26a0 OUT OF SPEC\", if({view.params.worstDev} > 5, \"\u26a0 WARNING\", \"\u2713 IN SPEC\")))"
              },
              "type": "expr"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} > 30, \"#CCCCCC\", if({view.params.worstDev} > 10, \"#FF4444\", if({view.params.worstDev} > 5, \"#FFD700\", \"#70AD47\")))"
              },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} > 30, \"#555555\", if({view.params.worstDev} > 10, \"#FFFFFF\", if({view.params.worstDev} > 5, \"#333333\", \"#FFFFFF\")))"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Completeness"
        },
        "position": {
          "basis": "200px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "toString({view.params.completeness}) + \"%  (\" + toString({view.params.equipment}) + \" units)\""
              },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.completeness} < 50, \"#CC0000\", if({view.params.completeness} < 80, \"#E07B00\", \"#2E7D32\"))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": 12
          }
        },
        "type": "ia.display.label"
      }
    ],
    "position": {
      "basis": "38px",
      "shrink": 0,
      "grow": 0
    }
  }
}