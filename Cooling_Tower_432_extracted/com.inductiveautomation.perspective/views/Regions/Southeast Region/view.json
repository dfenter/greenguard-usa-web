{
  "custom": {},
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tif self.params.tabIndex is not None and self.params.tabIndex > 0:\n\t\tself.getChild(\"root\").getChild(\"TabContainer\").props.currentTabIndex=self.params.tabIndex\n\telse:\n\t\tself.getChild(\"root\").getChild(\"TabContainer\").props.currentTabIndex=0\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "tabIndex": "value"
  },
  "propConfig": {
    "params.tabIndex": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": "1080+",
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Overview"
            },
            "props": {
              "path": "Regions/Overviews/Southeast Region Overview"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Chattanooga"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "params": {
                "siteId": 5,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Delisle"
            },
            "position": {
              "tabIndex": 2
            },
            "props": {
              "params": {
                "siteId": 6,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Lakeland"
            },
            "position": {
              "tabIndex": 3
            },
            "props": {
              "params": {
                "siteId": 13,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "WPB"
            },
            "position": {
              "tabIndex": 5
            },
            "props": {
              "params": {
                "siteId": 37,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "TabContainer"
        },
        "position": {
          "basis": "1080px"
        },
        "propConfig": {
          "props.currentTabIndex": {
            "onChange": {
              "enabled": false,
              "script": "\tself.session.custom.tankConfig = self.props.currentTabIndex\n\tself.session.custom.Site = self.props.tabs[self.props.currentTabIndex].text"
            }
          }
        },
        "props": {
          "currentTabIndex": "value",
          "menuType": "modern",
          "tabSize": {
            "width": 150
          },
          "tabs": [
            {
              "text": "Overview"
            },
            {
              "text": "Chattanooga"
            },
            {
              "text": "De Lisle"
            },
            {
              "text": "Lakeland"
            },
            {
              "text": "Orlando"
            },
            {
              "text": "WPB"
            }
          ]
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}