  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\ttry:\n\t\tds \u003d system.db.runNamedQuery(\u0027coolingTowerData/getAllRegions\u0027, {})\n\t\topts \u003d [{\u0027label\u0027: \u0027None\u0027, \u0027value\u0027: \u0027\u0027}]\n\t\tfor r in range(ds.getRowCount()):\n\t\t\treg \u003d ds.getValueAt(r, \u0027region\u0027)\n\t\t\topts.append({\u0027label\u0027: reg, \u0027value\u0027: reg})\n\t\tself.session.custom.regionOptions \u003d opts\n\texcept Exception as e:\n\t\tsystem.perspective.print(\u0027RegionAdmin startup error: \u0027 + str(e))\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {},
  "propConfig": {
    "custom.allSites": {
      "binding": {
        "config": {
          "queryPath": "coolingTowerData/getAllSitesWithRegion"
        },
        "transforms": [
          {
            "code": "\tif value is None: return []\n\tds \u003d system.dataset.toPyDataSet(value)\n\treturn [{\n\t\t\u0027instancePosition\u0027: {}, \u0027instanceStyle\u0027: {\u0027classes\u0027: \u0027\u0027},\n\t\t\u0027siteId\u0027:  row[\u0027id\u0027],\n\t\t\u0027site\u0027:    row[\u0027site\u0027],\n\t\t\u0027region\u0027:  row[\u0027region\u0027] if row[\u0027region\u0027] else \u0027\u0027\n\t} for row in ds]\n",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    },
    "custom.regionOptions": {
      "binding": {
        "config": {
          "queryPath": "coolingTowerData/getAllRegions"
        },
        "transforms": [
          {
            "code": "\tif value is None: return []\n\tds \u003d system.dataset.toPyDataSet(value)\n\treturn [{\u0027label\u0027: row[\u0027region\u0027], \u0027value\u0027: row[\u0027region\u0027]} for row in ds]\n",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "meta": {
          "name": "PageTitle"
        },
        "position": {
          "basis": "48px",
          "shrink": 0
        },
        "props": {
          "style": {
            "borderBottom": "2px solid #E0E0E0",
            "fontSize": 20,
            "fontWeight": "bold",
            "padding": "12px 16px"
          },
          "text": "Region / Site Assignment"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Instructions"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "props": {
          "style": {
            "color": "#666666",
            "fontSize": 12,
            "padding": "4px 16px"
          },
          "text": "Select a row then use the dropdown below to reassign the region."
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "SiteTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "config": {
                "queryPath": "coolingTowerData/getAllSitesWithRegion"
              },
              "transforms": [
                {
                  "code": "\tif value is None: return system.dataset.toDataSet([], [])\n\theaders \u003d [\"id\", \"Site\", \"Current Region\"]\n\trows \u003d []\n\tfor r in range(value.getRowCount()):\n\t\trows.append([\n\t\t\tvalue.getValueAt(r, \"id\"),\n\t\t\tstr(value.getValueAt(r, \"site\") or \"\"),\n\t\t\tstr(value.getValueAt(r, \"region\") or \"Unassigned\")\n\t\t])\n\treturn system.dataset.toDataSet(headers, rows)\n",
                  "type": "script"
                }
              ],
              "type": "query"
            }
          }
        },
        "props": {
          "alternatingRowBackground": true,
          "columns": [
            {
              "editable": false,
              "field": "id",
              "header": {
                "title": "ID"
              },
              "width": 60
            },
            {
              "editable": false,
              "field": "Site",
              "header": {
                "title": "Site"
              },
              "width": 250
            },
            {
              "editable": false,
              "field": "Current Region",
              "header": {
                "title": "Current Region"
              },
              "width": 250
            }
          ],
          "pageSize": 20,
          "rowHeight": 36,
          "selectionMode": "single",
          "showPaginationBar": true,
          "style": {
            "margin": "0 16px",
            "overflowY": "auto"
          }
        },
        "type": "ia.display.table"
      },
      {
        "children": [
          {
            "meta": {
              "name": "AssignLabel"
            },
            "position": {
              "basis": "120px",
              "shrink": 0
            },
            "props": {
              "style": {
                "fontSize": 13
              },
              "text": "Assign selected to:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "RegionDropdown"
            },
            "position": {
              "basis": "240px",
              "shrink": 0
            },
            "props": {
              "options": [
                {
                  "label": "Central Region",
                  "value": "Central Region"
                },
                {
                  "label": "East Region",
                  "value": "East Region"
                },
                {
                  "label": "Midwest Region",
                  "value": "Midwest Region"
                },
                {
                  "label": "North Region",
                  "value": "North Region"
                },
                {
                  "label": "Northeast Region",
                  "value": "Northeast Region"
                },
                {
                  "label": "South Region",
                  "value": "South Region"
                },
                {
                  "label": "Southeast Region",
                  "value": "Southeast Region"
                },
                {
                  "label": "Southwest Region",
                  "value": "Southwest Region"
                }
              ],
              "placeholder": "Select region..."
            },
            "type": "ia.input.dropdown"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\ttable    \u003d self.getSibling(\u0027SiteTable\u0027)\n\tselected \u003d table.props.selection.data\n\tif not selected or selected.getRowCount() \u003d\u003d 0:\n\t\tsystem.perspective.openPopup(\u0027adminError\u0027,\u0027Framework/ErrorPopup\u0027,\n\t\t\tparams\u003d{\u0027message\u0027: \u0027Please select a site first.\u0027})\n\t\treturn\n\tregion \u003d self.getSibling(\u0027RegionDropdown\u0027).props.value\n\tif not region:\n\t\tsystem.perspective.openPopup(\u0027adminError\u0027,\u0027Framework/ErrorPopup\u0027,\n\t\t\tparams\u003d{\u0027message\u0027: \u0027Please select a region.\u0027})\n\t\treturn\n\tsiteId \u003d selected.getValueAt(0, \u0027id\u0027)\n\tsite   \u003d selected.getValueAt(0, \u0027Site\u0027)\n\ttry:\n\t\tsystem.db.runNamedQuery(\u0027coolingTowerData/updateSiteRegion\u0027,\n\t\t\t{\u0027siteId\u0027: siteId, \u0027region\u0027: region})\n\t\tsystem.perspective.openPopup(\u0027adminSuccess\u0027,\u0027Framework/SuccessPopup\u0027,\n\t\t\tparams\u003d{\u0027message\u0027: site + \u0027 assigned to \u0027 + region})\n\t\t# Refresh table\n\t\ttable.refreshBinding(\u0027props.data\u0027)\n\texcept Exception as e:\n\t\tsystem.perspective.openPopup(\u0027adminError\u0027,\u0027Framework/ErrorPopup\u0027,\n\t\t\tparams\u003d{\u0027message\u0027: \u0027Save failed: \u0027 + str(e)})\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "SaveButton"
            },
            "position": {
              "basis": "120px",
              "shrink": 0
            },
            "props": {
              "text": "Save Assignment"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "AssignBar"
        },
        "position": {
          "basis": "56px",
          "shrink": 0
        },
        "props": {
          "style": {
            "alignItems": "center",
            "backgroundColor": "#F8F8F8",
            "borderTop": "1px solid #E0E0E0",
            "gap": "12px",
            "padding": "8px 16px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}