\"coolingTowerData/enables/CDADataEnable\", parameters\u003dparams7, tx\u003dtxID)\n\tconfig9 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/AirExpanderDataEnable\", parameters\u003dparams8, tx\u003dtxID)\n\tconfig10 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/warmExpanderDataEnable\", parameters\u003dparams9, tx\u003dtxID)\n\tconfig11 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/coldExpanderDataEnable\", parameters\u003dparams10, tx\u003dtxID)\n\tconfig12 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/argonSkidDataEnable\", parameters\u003dparams11, tx\u003dtxID)\n\tconfig13 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/auxillaryCoolerDataEnable\", parameters\u003dparams12, tx\u003dtxID)\n\tconfig14 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/DCACDataEnable\", parameters\u003dparams13, tx\u003dtxID)\n\tconfig15 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/chillerDataEnable\", parameters\u003dparams14, tx\u003dtxID)\n\tconfig16 \u003d system.db.runNamedQuery(project\u003d\"Cooling_Tower_Approach_Temps\",path\u003d\"coolingTowerData/enables/NLUChillerDataEnable\", parameters\u003dparams15, tx\u003dtxID)\n\tsystem.db.commitTransaction(txID)\n\tsystem.db.closeTransaction(txID)"
