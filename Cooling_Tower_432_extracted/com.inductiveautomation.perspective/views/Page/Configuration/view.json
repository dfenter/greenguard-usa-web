      {
        "meta": {
          "name": "Button"
        },
        "position": {
          "height": 36,
          "width": 120,
          "x": 560,
          "y": 686
        },
        "props": {
          "text": "Save Changes"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.edit"
              },
              "transforms": [
                {
                  "fallback": "",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "Save Site Configuration"
                    },
                    {
                      "input": false,
                      "output": "Edit Site Configuration"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tMAC = self.view.custom.MAC\n\tBAC = self.view.custom.BAC\n\tRNC = self.view.custom.RNC\n\tFNC = self.view.custom.FNC\n\tGOX = self.view.custom.GOX\n\tGAN = self.view.custom.GAN\n\tCDA = self.view.custom.CDA\n\tchiller = self.view.custom.chiller\n\tairExpander = self.view.custom.airExpander\n\twarmExpander = self.view.custom.warmExpander\n\tcoldExpander = self.view.custom.coldExpander\n\targonSkid = self.view.custom.argonSkid\n\tauxillaryCooler = self.view.custom.auxillaryCooler\n\tDCAC = self.view.custom.DCAC\n\tNLUChiller = self.view.custom.NLUChiller\n\tsiteId = self.view.custom.siteId\n\tequipmentId = [MAC,BAC,RNC,FNC,GOX,GAN,CDA,chiller,airExpander,warmExpander,coldExpander,argonSkid,auxillaryCooler,DCAC,NLUChiller,siteId]\n\ttxID=system.db.beginNamedQueryTransaction(project= \"Cooling_Tower_Approach_Temps\", database=\"Plant_Stats_DB_Write_Server\")\n\tparams  = {\"siteId\":siteId, \"MAC\":MAC, \"BAC\":BAC, \"RNC\":RNC, \"FNC\":FNC, \"GOX\":GOX, \"GAN\":GAN, \"CDA\":CDA, \"airExpander\":airExpander, \"warmExpander\":warmExpander,\"coldExpander\":coldExpander, \"argonSkid\":argonSkid, \"auxillaryCooler\":auxillaryCooler, \"DCAC\":DCAC, \"NLUChiller\":NLUChiller, \"chiller\":chiller}\n\tparams1 = {\"siteId\":siteId, \"equipmentNumber\":MAC, \"equipmentId\":1}\t\n\tparams2 = {\"siteId\":siteId, \"equipmentNumber\":BAC, \"equipmentId\":2}\n\tparams3 = {\"siteId\":siteId, \"equipmentNumber\":RNC, \"equipmentId\":3}\n\tparams4 = {\"siteId\":siteId, \"equipmentNumber\":FNC, \"equipmentId\":4}\n\tparams5 = {\"siteId\":siteId, \"equipmentNumber\":GOX, \"equipmentId\":5}\n\tparams6 = {\"siteId\":siteId, \"equipmentNumber\":GAN, \"equipmentId\":6}\n\tparams7 = {\"siteId\":siteId, \"equipmentNumber\":CDA, \"equipmentId\":7}\n\tparams8 = {\"siteId\":siteId, \"equipmentNumber\":airExpander, \"equipmentId\":8}\n\tparams9 = {\"siteId\":siteId, \"equipmentNumber\":warmExpander, \"equipmentId\":9}\n\tparams10 = {\"siteId\":siteId, \"equipmentNumber\"