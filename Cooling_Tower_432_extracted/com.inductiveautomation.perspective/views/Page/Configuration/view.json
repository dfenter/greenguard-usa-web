              "config": {
                "script": "\tMAC \u003d self.view.custom.MAC\n\tBAC \u003d self.view.custom.BAC\n\tRNC \u003d self.view.custom.RNC\n\tFNC \u003d self.view.custom.FNC\n\tGOX \u003d self.view.custom.GOX\n\tGAN \u003d self.view.custom.GAN\n\tCDA \u003d self.view.custom.CDA\n\tchiller \u003d self.view.custom.chiller\n\tairExpander \u003d self.view.custom.airExpander\n\twarmExpander \u003d self.view.custom.warmExpander\n\tcoldExpander \u003d self.view.custom.coldExpander\n\targonSkid \u003d self.view.custom.argonSkid\n\tauxillaryCooler \u003d self.view.custom.auxillaryCooler\n\tDCAC \u003d self.view.custom.DCAC\n\tNLUChiller \u003d self.view.custom.NLUChiller\n\tsiteId \u003d self.view.custom.siteId\n\tequipmentId \u003d [MAC,BAC,RNC,FNC,GOX,GAN,CDA,chiller,airExpander,warmExpander,coldExpander,argonSkid,auxillaryCooler,DCAC,NLUChiller,siteId]\n\ttxID\u003dsystem.db.beginNamedQueryTransaction(project\u003d \"Cooling_Tower_Approach_Temps\", database\u003d\"Plant_Stats_DB_Write_Server\")\n\tparams  \u003d {\"siteId\":siteId, \"MAC\":MAC, \"BAC\":BAC, \"RNC\":RNC, \"FNC\":FNC, \"GOX\":GOX, \"GAN\":GAN, \"CDA\":CDA, \"airExpander\":airExpander, \"warmExpander\":warmExpander,\"coldExpander\":coldExpander, \"argonSkid\":argonSkid, \"auxillaryCooler\":auxillaryCooler, \"DCAC\":DCAC, \"NLUChiller\":NLUChiller, \"chiller\":chiller}\n\tparams1 \u003d {\"siteId\":siteId, \"equipmentNumber\":MAC, \"equipmentId\":1}\t\n\tparams2 \u003d {\"siteId\":siteId, \"equipmentNumber\":BAC, \"equipmentId\":2}\n\tparams3 \u003d {\"siteId\":siteId, \"equipmentNumber\":RNC, \"equipmentId\":3}\n\tparams4 \u003d {\"siteId\":siteId, \"equipmentNumber\":FNC, \"equipmentId\":4}\n\tparams5 \u003d {\"siteId\":siteId, \"equipmentNumber\":GOX, \"equipmentId\":5}\n\tparams6 \u003d {\"siteId\":siteId, \"equipmentNumber\":GAN, \"equipmentId\":6}\n\tparams7 \u003d {\"siteId\":siteId, \"equipmentNumber\":CDA, \"equipmentId\":7}\n\tparams8 \u003d {\"siteId\":siteId, \"equipmentNumber\":airExpander, \"equipmentId