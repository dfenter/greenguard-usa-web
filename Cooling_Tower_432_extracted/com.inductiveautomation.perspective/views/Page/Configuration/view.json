    "custom.instancesEquipmentList": {
      "binding": {
        "config": {
          "path": "view.custom.allEquipmentList"
        },
        "transforms": [
          {
            "code": "\tnewDS \u003d system.dataset.toPyDataSet(value)\n\tinstances \u003d []\n\tfor entry in newDS:\n\t\tinstance \u003d {}\n\t\tinstance[\u0027equipmentType\u0027] \u003d entry[\u0027equipmentType\u0027]\n\t\tinstance[\u0027instanceStyle\u0027] \u003d {\u0027classes\u0027: []}\n\t\tinstance[\u0027instancePosition\u0027] \u003d {}\n\t\tinstances.append(instance)\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.siteConfig": {
      "binding": {
        "config": {
          "parameters": {
            "siteId": "{view.custom.siteId}"
          },
          "queryPath": "coolingTowerData/getSiteConfig"
        },
        "type": "query"
      },
      "persistent": true
    },
    "custom.siteConfigInstance": {
      "binding": {
        "config": {
          "path": "view.custom.siteConfig"
        },
        "transforms": [
          {
            "code": "\tnewDS \u003d system.dataset.toPyDataSet(value)\n\tinstances \u003d []\n\tfor entry in newDS:\n\t\tinstance \u003d {}\n\t\tinstance[\u0027MAC\u0027] \u003d entry[\u0027MAC\u0027]\n\t\tinstance[\u0027BAC\u0027] \u003d entry[\u0027BAC\u0027]\n\t\tinstance[\u0027RNC\u0027] \u003d entry[\u0027RNC\u0027]\n\t\tinstance[\u0027FNC\u0027] \u003d entry[\u0027FNC\u0027]\n\t\tinstance[\u0027GAN\u0027] \u003d entry[\u0027GAN\u0027]\n\t\tinstance[\u0027GOX\u0027] \u003d entry[\u0027GOX\u0027]\n\t\tinstance[\u0027CDA\u0027] \u003d entry[\u0027CDA\u0027]\n\t\tinstance[\u0027chiller\u0027] \u003d entry[\u0027chiller\u0027]\n\t\tinstance[\u0027NLUChiller\u0027] \u003d entry[\u0027NLUChiller\u0027]\n\t\tinstance[\u0027airExpander\u0027] \u003d entry[\u0027airExpander\u0027]\n\t\tinstance[\u0027warmExpander\u0027] \u003d entry[\u0027warmExpander\u0027]\n\t\tinstance[\u0027coldExpander\u0027] \u003d entry[\u0027coldExpander\u0027]\n\t\tinstance[\u0027argonSkid\u0027] \u003d entry[\u0027argonSkid\u0027]\n\t\tinstance[\u0027auxillaryCooler\u0027] \u003d entry[\u0027auxillaryCooler\u0027]\n\t\tinstance[\u0027DCAC\u0027] \u003d entry[\u0027DCAC\u0027]\n\t\tinstance[\u0027instanceStyle\u0027] \u003d {\u0027classes\u0027: []}\n\t\tinstance[\u0027instancePosition\u0027] \u003d {}\n\t\tinstances.append(instance)\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.CDA \u003d self.custom.siteConfigInstance[0].CDA\n\tself.custom.BAC \u003d self.custom.siteConfigInstance[0].BAC\n\tself.custom.RNC \u003d self.custom.siteConfigInstance[0].RNC\n\tself.custom.chiller \u003d self.custom.siteConfigInstance[0].chiller\n\tself.custom.MAC \u003d self.custom.siteConfigInstance[0].MAC\n\tself.custom.GOX \u003d self.custom.siteConfigInstance[0].GOX\n\tself.custom.coldExpander \u003d self.custom.siteConfigInstance[0].coldExpander\n\tself.custom.auxillaryCooler \u003d self.custom.siteConfigInstance[0].auxillaryCooler\n\tself.custom.NLUChiller \u003d self.custom.siteConfigInstance[0].NLUChiller\n\tself.custom.GAN \u003d self.custom.siteConfigInstance[0].GAN\n\tself.custom.warmExpander \u003d self.custom.siteConfigInstance[0].warmExpander\n\tself.custom.airExpander \u003d self.custom.siteConfigInstance[0].airExpander\n\tself.custom.FNC \u003d self.custom.siteConfigInstance[0].FNC\n\tself.custom.argonSkid \u003d self.custom.siteConfigInstance[0].argonSkid\n\tself.custom.DCAC \u003d self.custom.siteConfigInstance[0].DCAC"
      },
      "persistent": true
    },
