    "custom.instancesEquipmentList": {
      "binding": {
        "config": {
          "path": "view.custom.allEquipmentList"
        },
        "transforms": [
          {
            "code": "\tnewDS = system.dataset.toPyDataSet(value)\n\tinstances = []\n\tfor entry in newDS:\n\t\tinstance = {}\n\t\tinstance['equipmentType'] = entry['equipmentType']\n\t\tinstance['instanceStyle'] = {'classes': []}\n\t\tinstance['instancePosition'] = {}\n\t\tinstances.append(instance)\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.siteConfig": {
      "binding": {
        "config": {
          "parameters": {
            "siteId": "{view.custom.siteId}"
          },
          "queryPath": "coolingTowerData/getSiteConfig"
        },
        "type": "query"
      },
      "persistent": true
    },
    "custom.siteConfigInstance": {
      "binding": {
        "config": {
          "path": "view.custom.siteConfig"
        },
        "transforms": [
          {
            "code": "\tnewDS = system.dataset.toPyDataSet(value)\n\tinstances = []\n\tfor entry in newDS:\n\t\tinstance = {}\n\t\tinstance['MAC'] = entry['MAC']\n\t\tinstance['BAC'] = entry['BAC']\n\t\tinstance['RNC'] = entry['RNC']\n\t\tinstance['FNC'] = entry['FNC']\n\t\tinstance['GAN'] = entry['GAN']\n\t\tinstance['GOX'] = entry['GOX']\n\t\tinstance['CDA'] = entry['CDA']\n\t\tinstance['chiller'] = entry['chiller']\n\t\tinstance['NLUChiller'] = entry['NLUChiller']\n\t\tinstance['airExpander'] = entry['airExpander']\n\t\tinstance['warmExpander'] = entry['warmExpander']\n\t\tinstance['coldExpander'] = entry['coldExpander']\n\t\tinstance['argonSkid'] = entry['argonSkid']\n\t\tinstance['auxillaryCooler'] = entry['auxillaryCooler']\n\t\tinstance['DCAC'] = entry['DCAC']\n\t\tinstance['instanceStyle'] = {'classes': []}\n\t\tinstance['instancePosition'] = {}\n\t\tinstances.append(instance)\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": true,
        "script": "\tself.custom.CDA = self.custom.siteConfigInstance[0].CDA\n\tself.custom.BAC = self.custom.siteConfigInstance[0].BAC\n\tself.custom.RNC = self.custom.siteConfigInstance[0].RNC\n\tself.custom.chiller = self.custom.siteConfigInstance[0].chiller\n\tself.custom.MAC = self.custom.siteConfigInstance[0].MAC\n\tself.custom.GOX = self.custom.siteConfigInstance[0].GOX\n\tself.custom.coldExpander = self.custom.siteConfigInstance[0].coldExpander\n\tself.custom.auxillaryCooler = self.custom.siteConfigInstance[0].auxillaryCooler\n\tself.custom.NLUChiller = self.custom.siteConfigInstance[0].NLUChiller\n\tself.custom.GAN = self.custom.siteConfigInstance[0].GAN\n\tself.custom.warmExpander = self.custom.siteConfigInstance[0].warmExpander\n\tself.custom.airExpander = self.custom.siteConfigInstance[0].airExpander\n\tself.custom.FNC = self.custom.siteConfigInstance[0].FNC\n\tself.custom.argonSkid = self.custom.siteConfigInstance[0].argonSkid\n\tself.custom.DCAC = self.custom.siteConfigInstance[0].DCAC"
      },
      "persistent": true
    },
    "custom.siteConfigInstance[0].BAC": {
