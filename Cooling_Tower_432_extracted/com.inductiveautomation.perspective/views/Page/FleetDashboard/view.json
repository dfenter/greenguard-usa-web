{
  "custom": {
    "fleetData": [],
    "staleDays": 30,
    "filterRegion": "All",
    "countRed": 0,
    "countYellow": 0,
    "countStale": 0
  },
  "params": {},
  "propConfig": {
    "custom.fleetData": {
      "binding": {
        "config": {
          "queryPath": "coolingTowerData/getFleetSummary"
        },
        "transforms": [
          {
            "code": "\tif value is None: return []\n\tds = system.dataset.toPyDataSet(value)\n\tfilterRegion = self.view.custom.filterRegion\n\trows = []\n\tfor row in ds:\n\t\tif filterRegion != 'All' and row['region'] != filterRegion: continue\n\t\tdays = row['daysSinceEntry'] if row['daysSinceEntry'] is not None else 9999\n\t\trows.append({\n\t\t\t'instancePosition': {}, 'instanceStyle': {'classes': ''},\n\t\t\t'siteId':       row['siteId'],\n\t\t\t'siteName':     row['siteName'],\n\t\t\t'region':       row['region'] or '',\n\t\t\t'lastEntry':    system.date.format(row['lastEntry'], 'MM/dd/yyyy') if row['lastEntry'] else 'Never',\n\t\t\t'daysSince':    days,\n\t\t\t'worstDev':     row['worstDev'] or 0.0,\n\t\t\t'completeness': row['completenessPercent'] or 0,\n\t\t\t'equipment':    row['enabledEquipment'] or 0\n\t\t})\n\treturn rows\n",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    },
    "custom.countRed": {
      "binding": {
        "config": {
          "path": "view.custom.fleetData"
        },
        "transforms": [
          {
            "code": "\tif not value: return 0\n\treturn sum(1 for r in value if r.get('worstDev',0) > 10)\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.countYellow": {
      "binding": {
        "config": {
          "path": "view.custom.fleetData"
        },
        "transforms": [
          {
            "code": "\tif not value: return 0\n\treturn sum(1 for r in value if 5 < r.get('worstDev',0) <= 10)\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.countStale": {
      "binding": {
        "config": {
          "path": "view.custom.fleetData"
        },
        "transforms": [
          {
            "code": "\tif not value: return 0\n\treturn sum(1 for r in value if r.get('daysSince',9999) > 30)\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "16px"
      }
    },
    "children": [
      {
        "meta": {
          "name": "TitleBar"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "alignItems": "center",
            "marginBottom": "8px"
          }
        },
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "text": "Fleet Dashboard",
              "style": {
                "fontSize": 22,
                "fontWeight": "bold"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "FilterLabel"
            },
            "position": {
              "basis": "60px"
            },
            "props": {
              "text": "Region:",
              "style": {
                "fontSize": 13
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "RegionFilter"
            },
            "position": {
              "basis": "200px"
            },
            "props": {
              "options": [],
              "value": "All"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "queryPath": "coolingTowerData/getAllRegions"
                  },
                  "transforms": [
                    {
                      "code": "\tif value is None: return [{'label':'All','value':'All'}]\n\tds = system.dataset.toPyDataSet(value)\n\topts = [{'label':'All','value':'All'}]\n\tfor row in ds:\n\t\topts.append({'label': row['region'], 'value': row['region']})\n\treturn opts\n",
                      "type": "script"
                    }
                  ],
                  "type": "query"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.filterRegion"
                  },
                  "type": "property"
                }
              }
            },
            "type": "ia.input.dropdown"
          },
          {
            "meta": {
              "name": "ExportButton"
            },
            "position": {
              "basis": "130px",
              "shrink": 0
            },
            "props": {
              "text": "⬇ Export CSV",
              "style": {
                "marginLeft": "12px",
                "fontSize": 13
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tdata = self.view.custom.fleetData\n\tif not data:\n\t\treturn\n\theaders = ['Site','Region','Last Entry','Days Ago','Worst Dev (F)','Completeness %','Equipment Count']\n\tlines = [','.join(headers)]\n\tfor r in data:\n\t\tdays = r.get('daysSince', 9999)\n\t\trow = [\n\t\t\tr.get('siteName',''),\n\t\t\tr.get('region',''),\n\t\t\tr.get('lastEntry','Never'),\n\t\t\tstr(int(days)) if days < 9999 else 'Never',\n\t\t\tstr(round(r.get('worstDev',0), 2)),\n\t\t\tstr(r.get('completeness',0)) + '%',\n\t\t\tstr(r.get('equipment',0))\n\t\t]\n\t\tlines.append(','.join('\"' + v + '\"' for v in row))\n\tcsv = '\\n'.join(lines)\n\tsystem.perspective.download('fleet_summary.csv', csv.encode('utf-8'), 'text/csv')\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "type": "ia.input.button"
          }
        ],
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "SummaryBadges"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "marginBottom": "10px",
            "gap": "12px"
          }
        },
        "children": [
          {
            "meta": {
              "name": "BadgeRed"
            },
            "position": {
              "basis": "160px"
            },
            "props": {
              "style": {
                "backgroundColor": "#FF4444",
                "color": "#FFF",
                "borderRadius": "6px",
                "padding": "8px 12px",
                "fontSize": 13,
                "fontWeight": "bold",
                "textAlign": "center"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"\u26a0 \" + toString({view.custom.countRed}) + \" Out of Spec\""
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "BadgeYellow"
            },
            "position": {
              "basis": "160px"
            },
            "props": {
              "style": {
                "backgroundColor": "#FFD700",
                "color": "#333",
                "borderRadius": "6px",
                "padding": "8px 12px",
                "fontSize": 13,
                "fontWeight": "bold",
                "textAlign": "center"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"\u26a0 \" + toString({view.custom.countYellow}) + \" Warning\""
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "BadgeGrey"
            },
            "position": {
              "basis": "160px"
            },
            "props": {
              "style": {
                "backgroundColor": "#AAAAAA",
                "color": "#FFF",
                "borderRadius": "6px",
                "padding": "8px 12px",
                "fontSize": 13,
                "fontWeight": "bold",
                "textAlign": "center"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"\ud83d\udd50 \" + toString({view.custom.countStale}) + \" Stale\""
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          }
        ],
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "FleetTable"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "columns": [
            {
              "field": "Site",
              "header": {
                "title": "Site"
              },
              "width": 200
            },
            {
              "field": "Region",
              "header": {
                "title": "Region"
              },
              "width": 170
            },
            {
              "field": "Last Entry",
              "header": {
                "title": "Last Entry"
              },
              "width": 130
            },
            {
              "field": "Days Ago",
              "header": {
                "title": "Days Ago"
              },
              "width": 90
            },
            {
              "field": "Spec Status",
              "header": {
                "title": "Spec Status"
              },
              "width": 140
            },
            {
              "field": "Completeness %",
              "header": {
                "title": "Monthly Completeness"
              },
              "width": 180
            }
          ],
          "rowHeight": 36,
          "alternatingRowBackground": true,
          "showPaginationBar": false,
          "style": {
            "overflowY": "auto"
          }
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "config": {
                "path": "view.custom.fleetData"
              },
              "transforms": [
                {
                  "code": "if not value: return []\nresult = []\nfor r in value:\n\tdays  = r.get('daysSince', 9999)\n\tworst = r.get('worstDev', 0)\n\tif worst > 10:     spec = '⚠ OUT OF SPEC'\n\telif worst > 5:    spec = '⚠ WARNING'\n\telif days > 30:    spec = '🕐 STALE'\n\telse:              spec = '✓ IN SPEC'\n\tdayStr = str(int(days)) if days < 9999 else 'Never'\n\tresult.append({\n\t\t'Site':           r.get('siteName', ''),\n\t\t'Region':         r.get('region', ''),\n\t\t'Last Entry':     r.get('lastEntry', 'Never'),\n\t\t'Days Ago':       dayStr,\n\t\t'Spec Status':    spec,\n\t\t'Completeness %': str(r.get('completeness', 0)) + '%  (' + str(r.get('equipment', 0)) + ' units)'\n\t})\nreturn result\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "events": {
          "component": {
            "onCellClick": {
              "config": {
                "script": "\tregionMap = {\n\t\t'Central Region':   '/central-region',\n\t\t'East Region':      '/east-region',\n\t\t'Midwest Region':   '/midwest-region',\n\t\t'North Region':     '/north-region',\n\t\t'Northeast Region': '/northeast-region',\n\t\t'South Region':     '/south-region',\n\t\t'Southeast Region': '/southeast-region',\n\t\t'Southwest Region': '/southwest-region'\n\t}\n\tsiteName = event.rowData.get('Site', '')\n\tregion   = event.rowData.get('Region', '')\n\tfor r in self.view.custom.fleetData:\n\t\tif r.get('siteName') == siteName:\n\t\t\tself.session.custom.currentSite     = r.get('siteId', 0)\n\t\t\tself.session.custom.currentSiteName = siteName\n\t\t\tbreak\n\turl = regionMap.get(region, '')\n\tif url:\n\t\tsystem.perspective.navigate(page=url)\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "type": "ia.display.table"
      }
    ],
    "type": "ia.container.flex"
  }
}