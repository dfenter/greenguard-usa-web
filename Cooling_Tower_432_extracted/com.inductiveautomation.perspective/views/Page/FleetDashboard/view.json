            },
            "props": {
              "style": {
                "backgroundColor": "#AAAAAA",
                "borderRadius": "6px",
                "color": "#FFF",
                "fontSize": 13,
                "fontWeight": "bold",
                "padding": "8px 12px",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "SummaryBadges"
        },
        "position": {
          "basis": "50px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": "12px",
            "marginBottom": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "FleetTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "config": {
                "queryPath": "coolingTowerData/getFleetSummary"
              },
              "transforms": [
                {
                  "code": "\tif value is None: return system.dataset.toDataSet([], [])\n\theaders \u003d [\"Site\", \"Region\", \"Last Entry\", \"Days Ago\", \"Spec Status\", \"Completeness %\"]\n\trows \u003d []\n\tfor r in range(value.getRowCount()):\n\t\tsiteName  \u003d str(value.getValueAt(r, \"siteName\") or \"\")\n\t\tregion    \u003d str(value.getValueAt(r, \"region\") or \"\")\n\t\tlastEntry \u003d value.getValueAt(r, \"lastEntry\")\n\t\tdaysSince \u003d value.getValueAt(r, \"daysSinceEntry\")\n\t\tworstDev  \u003d value.getValueAt(r, \"worstDev\") or 0\n\t\tcompPct   \u003d value.getValueAt(r, \"completenessPercent\") or 0\n\t\t\n\t\tleStr \u003d system.date.format(lastEntry, \"MM/dd/yyyy\") if lastEntry else \"Never\"\n\t\tdaStr \u003d str(int(daysSince)) if daysSince is not None else \"N/A\"\n\t\t\n\t\tif worstDev \u003e 10:    spec \u003d \"OUT OF SPEC\"\n\t\telif worstDev \u003e 5:   spec \u003d \"WARNING\"\n\t\telif daysSince and daysSince \u003e 30: spec \u003d \"STALE\"\n\t\telse:                spec \u003d \"IN SPEC\"\n\t\t\n\t\trows.append([siteName, region, leStr, daStr, spec, str(compPct) + \"%\"])\n\treturn system.dataset.toDataSet(headers, rows)\n",
                  "type": "script"
                }
              ],
              "type": "query"
            }
          }
        },
        "props": {
          "alternatingRowBackground": true,
          "columns": [
            {
              "field": "Site",
              "header": {
                "title": "Site"
              },
              "width": 200
            },
            {
              "field": "Region",
              "header": {
                "title": "Region"
              },
              "width": 170
            },
            {
              "field": "Last Entry",
              "header": {
                "title": "Last Entry"
              },
              "width": 130
            },
            {
              "field": "Days Ago",
              "header": {
                "title": "Days Ago"
              },
              "width": 90
            },
            {
              "field": "Spec Status",
              "header": {
                "title": "Spec Status"
              },
              "width": 140
            },
            {
              "field": "Completeness %",
              "header": {
                "title": "Monthly Completeness"
              },
              "width": 180
            }
          ],
          "rowHeight": 36,
          "showPaginationBar": false,
          "style": {
            "overflowY": "auto"
          }
        },
        "type": "ia.display.table"
      }
