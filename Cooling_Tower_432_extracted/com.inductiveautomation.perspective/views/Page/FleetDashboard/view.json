  "params": {},
  "propConfig": {
    "custom.countRed": {
      "binding": {
        "config": {
          "path": "view.custom.fleetData"
        },
        "transforms": [
          {
            "code": "\tif not value: return 0\n\treturn sum(1 for r in value if r.get(\u0027worstDev\u0027,0) \u003e 10)\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.countStale": {
      "binding": {
        "config": {
          "path": "view.custom.fleetData"
        },
        "transforms": [
          {
            "code": "\tif not value: return 0\n\treturn sum(1 for r in value if r.get(\u0027daysSince\u0027,9999) \u003e 30)\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.countYellow": {
      "binding": {
        "config": {
          "path": "view.custom.fleetData"
        },
        "transforms": [
          {
            "code": "\tif not value: return 0\n\treturn sum(1 for r in value if 5 \u003c r.get(\u0027worstDev\u0027,0) \u003c\u003d 10)\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.fleetData": {
      "binding": {
        "config": {
          "queryPath": "coolingTowerData/getFleetSummary"
        },
        "transforms": [
          {
            "code": "\tif value is None: return []\n\tds \u003d system.dataset.toPyDataSet(value)\n\tfilterRegion \u003d self.view.custom.filterRegion\n\trows \u003d []\n\tfor row in ds:\n\t\tif filterRegion !\u003d \u0027All\u0027 and row[\u0027region\u0027] !\u003d filterRegion: continue\n\t\tdays \u003d row[\u0027daysSinceEntry\u0027] if row[\u0027daysSinceEntry\u0027] is not None else 9999\n\t\trows.append({\n\t\t\t\u0027instancePosition\u0027: {}, \u0027instanceStyle\u0027: {\u0027classes\u0027: \u0027\u0027},\n\t\t\t\u0027siteId\u0027:       row[\u0027siteId\u0027],\n\t\t\t\u0027siteName\u0027:     row[\u0027siteName\u0027],\n\t\t\t\u0027region\u0027:       row[\u0027region\u0027] or \u0027\u0027,\n\t\t\t\u0027lastEntry\u0027:    system.date.format(row[\u0027lastEntry\u0027], \u0027MM/dd/yyyy\u0027) if row[\u0027lastEntry\u0027] else \u0027Never\u0027,\n\t\t\t\u0027daysSince\u0027:    days,\n\t\t\t\u0027worstDev\u0027:     row[\u0027worstDev\u0027] or 0.0,\n\t\t\t\u0027completeness\u0027: row[\u0027completenessPercent\u0027] or 0,\n\t\t\t\u0027equipment\u0027:    row[\u0027enabledEquipment\u0027] or 0\n\t\t})\n\treturn rows\n",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "fontSize": 22,
                "fontWeight": "bold"
              },
              "text": "Fleet Dashboard"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "FilterLabel"
            },
            "position": {
              "basis": "60px"
            },
            "props": {
              "style": {
                "fontSize": 13
              },
              "text": "Region:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "RegionFilter"
            },
            "position": {
              "basis": "200px"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "queryPath": "coolingTowerData/getAllRegions"
                  },
                  "transforms": [
                    {
                      "code": "\tif value is None: return [{\u0027label\u0027:\u0027All\u0027,\u0027value\u0027:\u0027All\u0027}]\n\tds \u003d system.dataset.toPyDataSet(value)\n\topts \u003d [{\u0027label\u0027:\u0027All\u0027,\u0027value\u0027:\u0027All\u0027}]\n\tfor row in ds:\n\t\topts.append({\u0027label\u0027: row[\u0027region\u0027], \u0027value\u0027: row[\u0027region\u0027]})\n\treturn opts\n",
                      "type": "script"
                    }
                  ],
                  "type": "query"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.filterRegion"
                  },
                  "type": "property"
                }
              }
            },
            "type": "ia.input.dropdown"
          }
        ],
