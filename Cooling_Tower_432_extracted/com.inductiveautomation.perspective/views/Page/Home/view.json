{
  "custom": {
    "countOutOfSpec": 0,
    "countWarning": 0,
    "countStale": 0,
    "totalSites": 0
  },
  "params": {
    "feature": "",
    "key": "",
    "tier1": "",
    "tier2": ""
  },
  "propConfig": {
    "params.feature": { "paramDirection": "input" },
    "params.key":     { "paramDirection": "input" },
    "params.tier1":   { "paramDirection": "input" },
    "params.tier2":   { "paramDirection": "input" },
    "custom.countOutOfSpec": {
      "binding": {
        "config": { "queryPath": "coolingTowerData/getFleetSummary" },
        "transforms": [
          {
            "code": "\tif value is None: return 0\n\tcount = 0\n\tfor r in range(value.getRowCount()):\n\t\tdev = value.getValueAt(r, 'worstDev') or 0\n\t\tif dev > 10: count += 1\n\treturn count\n",
            "type": "script"
          }
        ],
        "type": "query"
      }
    },
    "custom.countWarning": {
      "binding": {
        "config": { "queryPath": "coolingTowerData/getFleetSummary" },
        "transforms": [
          {
            "code": "\tif value is None: return 0\n\tcount = 0\n\tfor r in range(value.getRowCount()):\n\t\tdev = value.getValueAt(r, 'worstDev') or 0\n\t\tif 5 < dev <= 10: count += 1\n\treturn count\n",
            "type": "script"
          }
        ],
        "type": "query"
      }
    },
    "custom.countStale": {
      "binding": {
        "config": { "queryPath": "coolingTowerData/getFleetSummary" },
        "transforms": [
          {
            "code": "\tif value is None: return 0\n\tcount = 0\n\tfor r in range(value.getRowCount()):\n\t\tdays = value.getValueAt(r, 'daysSinceEntry')\n\t\tif days is None or days > 30: count += 1\n\treturn count\n",
            "type": "script"
          }
        ],
        "type": "query"
      }
    },
    "custom.totalSites": {
      "binding": {
        "config": { "queryPath": "coolingTowerData/getFleetSummary" },
        "transforms": [
          {
            "code": "\treturn 0 if value is None else value.getRowCount()\n",
            "type": "script"
          }
        ],
        "type": "query"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 1080,
      "width": 1720
    }
  },
