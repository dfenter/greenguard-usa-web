{
  "custom": {},
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\t# Header dock startup - intentionally minimal\n\t# Do NOT reset session.custom.tankConfig or session.custom.header here\n\t# as this fires on every dock re-render and snaps the user back to Overview\n\tpass\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "size": "medium"
  },
  "propConfig": {
    "params.size": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AppIcon"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "text": "🌿",
          "style": {
            "fontSize": "20px",
            "color": "#FFFFFF"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "AppName"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "text": "Cooling Tower Approach Temps",
          "style": {
            "fontSize": "16px",
            "fontWeight": "700",
            "color": "#FFFFFF",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "SiteLabel"
        },
        "position": {
          "basis": "200px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "session.custom.currentSiteName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "13px",
            "color": "#C8E6C9",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "StatusLabel"
        },
        "position": {
          "basis": "120px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({session.custom.currentSiteName} != \"\", {session.custom.currentSiteName}, \"No site selected\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "12px",
            "color": "#C8E6C9",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "style": {
        "height": "50px",
        "backgroundColor": "#1B5E20",
        "alignItems": "center",
        "padding": "0 20px",
        "gap": "12px",
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      }
    },
    "type": "ia.container.flex"
  }
}
