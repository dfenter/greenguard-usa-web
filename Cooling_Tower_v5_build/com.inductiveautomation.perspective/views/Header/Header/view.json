{
  "custom": {},
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\t# Header dock startup - intentionally minimal\n\t# Do NOT reset session.custom.tankConfig or session.custom.header here\n\t# as this fires on every dock re-render and snaps the user back to Overview\n\tpass\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "size": "medium"
  },
  "propConfig": {
    "params.size": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 1846
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": [
              {
                "config": {
                  "page": "/Overview"
                },
                "scope": "C",
                "type": "nav"
              },
              {
                "config": {
                  "script": "\tself.session.custom.header = \"Overview\"\n\tself.session.custom.hasPlants = -1"
                },
                "scope": "G",
                "type": "script"
              }
            ]
          }
        },
        "meta": {
          "name": "Image"
        },
        "position": {
          "basis": "250px",
          "shrink": 0
        },
        "props": {
          "fit": {
            "mode": "percent"
          },
          "source": "/system/images/Matheson Cooling.jpg",
          "style": {
            "cursor": "pointer"
          },
          "tint": {
            "color": "#D5D5D5"
          }
        },
        "type": "ia.display.image"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Filler",
          "tooltip": {
            "width": "10px"
          }
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Spacer 6"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "if ({session.custom.header} = 'Overview' , false, true)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "session.custom.header"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "fontSize": "28px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Filler_0",
          "tooltip": {
            "width": "10px"
          }
        },
        "position": {
          "basis": "575px"
        },
        "props": {
          "text": " "
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Spacer 2"
        },
        "position": {
          "basis": "5px"
        },
        "props": {
          "text": " "
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Filler_1",
          "tooltip": {
            "width": "10px"
          }
        },
        "props": {
          "text": " "
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Spacer 4"
        },
        "position": {
          "basis": "2px"
        },
        "props": {
          "textStyle": {
            "fontSize": "28px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Dropdown"
        },
        "position": {
          "basis": "124px",
          "shrink": 0
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "session.props.theme"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "options": [
            {
              "label": "light",
              "value": "light"
            },
            {
              "label": "light-cool",
              "value": "light-cool"
            },
            {
              "label": "light-warm",
              "value": "light-warm"
            },
            {
              "label": "dark",
              "value": "dark"
            },
            {
              "label": "dark-cool",
              "value": "dark-cool"
            },
            {
              "label": "dark-warm",
              "value": "dark-warm"
            }
          ],
          "search": {
            "enabled": false
          },
          "style": {
            "classes": "Header/DropDown",
            "textAlign": "left"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\t\tself.session.custom.dropdowns.selectPlants = -1\n\telse:\n\t\tsystem.perspective.login()\n\t\tself.session.custom.dropdowns.selectPlants = 8"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "User"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "path": "material/person",
          "style": {
            "classes": "Header/Icon"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "custom": {
          "inMyplants": 0
        },
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\n\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\t\tself.session.custom.dropdowns.selectPlants = -1\n\telse:\n\t\tsystem.perspective.login()\n\t\tself.session.custom.dropdowns.selectPlants = 8"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "hasDelegate": true,
          "name": "Sign In_0"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.size} != \"small\""
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "session.props.auth.user.userName"
              },
              "transforms": [
                {
                  "expression": "if({value} = null || len({value}) = 0, \"Sign In\", {value})",
                  "type": "expression"
                }
              ],
              "type": "property"
            },
            "onChange": {
              "enabled": false,
              "script": "\tfrom time import sleep\n\tuserName = self.props.text\n\tif userName != 'Sign In':\n\t\tsleep(5)\n\t\tif self.custom.inMyplants == 0:\n\t\t\tsystem.db.runPrepUpdate(\"INSERT INTO myplants (username) VALUES (?)\", [userName], 'Plant_Stats_DB_Write_Server')"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Header/Icon",
            "cursor": "pointer",
            "marginLeft": "4px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "session.props.theme"
          },
          "transforms": [
            {
              "code": "\tif \"dark\" in value:\n\t\treturn \"var(--neutral-10)\"\n\telse:\n\t\treturn \"\"",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "style": {
        "classes": "Header/Header"
      }
    },
    "type": "ia.container.flex"
  }
}