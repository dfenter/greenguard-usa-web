{
  "custom": {},
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tif self.params.tabIndex is not None and self.params.tabIndex > 0:\n\t\tself.getChild(\"root\").getChild(\"TabContainer\").props.currentTabIndex=self.params.tabIndex\n\telse:\n\t\tself.getChild(\"root\").getChild(\"TabContainer\").props.currentTabIndex=0\n"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "tabIndex": "value"
  },
  "propConfig": {
    "params.tabIndex": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 1080,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Overview"
            },
            "props": {
              "path": "Regions/Overviews/Northeast Region Overview"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Albany"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "params": {
                "siteId": 0,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Middletown"
            },
            "position": {
              "tabIndex": 2
            },
            "props": {
              "params": {
                "siteId": 17,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "St Marys"
            },
            "position": {
              "tabIndex": 3
            },
            "props": {
              "params": {
                "siteId": 27,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Toledo"
            },
            "position": {
              "tabIndex": 4
            },
            "props": {
              "params": {
                "siteId": 29,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "West Point"
            },
            "position": {
              "tabIndex": 5
            },
            "props": {
              "params": {
                "siteId": 36,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "TabContainer"
        },
        "position": {
          "basis": "1080px"
        },
        "propConfig": {
          "props.currentTabIndex": {
            "onChange": {
              "enabled": true,
              "script": "\tsite_name = self.props.tabs[self.props.currentTabIndex].get('text', '')\n\tsite_ids  = {'Albany': 0, 'Middletown': 17, 'St Marys': 27, 'Toledo': 29, 'West Point': 36}\n\tself.session.custom.currentSiteName = site_name\n\tself.session.custom.site            = site_name\n\tif site_name in site_ids:\n\t\tself.session.custom.currentSite = site_ids[site_name]\n",
              "scope": "G"
            }
          }
        },
        "props": {
          "currentTabIndex": "value",
          "menuType": "modern",
          "tabSize": {
            "width": 160
          },
          "tabs": [
            {
              "text": "Overview"
            },
            {
              "text": "Albany"
            },
            {
              "text": "Middletown"
            },
            {
              "text": "St Marys"
            },
            {
              "text": "Toledo"
            },
            {
              "text": "West Point"
            }
          ]
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#F8FAFC",
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      }
    },
    "type": "ia.container.flex"
  }
}