{
  "custom": {
    "key": "value"
  },
  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\tif self.params.tabIndex is not None and self.params.tabIndex > 0:\n\t\tself.getChild(\"root\").getChild(\"TabContainer\").props.currentTabIndex=self.params.tabIndex\n\telse:\n\t\tself.getChild(\"root\").getChild(\"TabContainer\").props.currentTabIndex=0\n\t"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "tabIndex": "value"
  },
  "propConfig": {
    "custom.key": {
      "binding": {
        "config": {
          "path": "/root/TabContainer.props.currentTabIndex"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.tabIndex": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 1080,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Irving"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "params": {
                "siteId": 10,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Lawton"
            },
            "position": {
              "tabIndex": 3
            },
            "props": {
              "params": {
                "siteId": 14,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Mulberry"
            },
            "position": {
              "tabIndex": 4
            },
            "props": {
              "params": {
                "siteId": 19,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Odessa"
            },
            "position": {
              "tabIndex": 5
            },
            "props": {
              "params": {
                "siteId": 21,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Waxahachie"
            },
            "position": {
              "tabIndex": 2
            },
            "props": {
              "path": "Sites/siteView",
              "params": {
                "tabIndex": 0,
                "siteId": 35
              }
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Overview"
            },
            "props": {
              "path": "Regions/Overviews/Central Region Overview"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Penwell"
            },
            "position": {
              "tabIndex": 6
            },
            "props": {
              "params": {
                "siteId": 38,
                "tabIndex": 0
              },
              "path": "Sites/siteView"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "TabContainer"
        },
        "position": {
          "basis": "1080px"
        },
        "propConfig": {
          "props.currentTabIndex": {
            "onChange": {
              "enabled": true,
              "script": "\tsite_name = self.props.tabs[self.props.currentTabIndex].get('text', '')\n\tsite_ids  = {'Irving': 10, 'Waxahachie': 35, 'Lawton': 14, 'Mulberry': 19, 'Odessa': 21, 'Penwell': 38}\n\tself.session.custom.currentSiteName = site_name\n\tself.session.custom.site            = site_name\n\tif site_name in site_ids:\n\t\tself.session.custom.currentSite = site_ids[site_name]\n",
              "scope": "G"
            }
          }
        },
        "props": {
          "currentTabIndex": "value",
          "menuType": "modern",
          "tabSize": {
            "width": 120
          },
          "tabs": [
            {
              "text": "Overview"
            },
            {
              "text": "Irving"
            },
            {
              "text": "Waxahachie"
            },
            {
              "text": "Lawton"
            },
            {
              "text": "Mulberry"
            },
            {
              "text": "Odessa"
            },
            {
              "text": "Penwell"
            }
          ]
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}