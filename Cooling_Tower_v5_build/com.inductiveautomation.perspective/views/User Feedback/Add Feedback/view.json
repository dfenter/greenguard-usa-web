{
  "custom": {
    "submitted": false
  },
  "params": {},
  "props": {
    "defaultSize": {
      "width": 560,
      "height": 350
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "type": "ia.container.coord",
    "props": {
      "style": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      }
    },
    "children": [
      {
        "meta": {
          "name": "Header"
        },
        "position": {
          "height": 52,
          "width": 560,
          "x": 0,
          "y": 0
        },
        "props": {
          "style": {
            "backgroundColor": "#1565C0"
          }
        },
        "type": "ia.container.coord",
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "height": 40,
              "width": 520,
              "x": 20,
              "y": 6
            },
            "props": {
              "text": "Submit Feedback",
              "style": {
                "fontSize": 18,
                "color": "#FFFFFF",
                "fontWeight": "700",
                "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
              }
            },
            "type": "ia.display.label"
          }
        ]
      },
      {
        "meta": {
          "name": "SiteLbl"
        },
        "position": {
          "height": 24,
          "width": 60,
          "x": 20,
          "y": 66
        },
        "props": {
          "text": "Site:",
          "style": {
            "fontSize": 13,
            "fontWeight": "600",
            "color": "#0F172A",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "SiteDropdown"
        },
        "position": {
          "height": 32,
          "width": 220,
          "x": 82,
          "y": 62
        },
        "props": {
          "placeholder": "Select site...",
          "style": {
            "border": "1px solid #E2E8F0",
            "borderRadius": "4px",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "propConfig": {
          "props.options": {
            "binding": {
              "config": {
                "queryPath": "coolingTowerData/getAllSitesDropdown"
              },
              "transforms": [
                {
                  "code": "\tif value is None: return []\n\topts = []\n\tfor r in range(value.getRowCount()):\n\t\tsite = str(value.getValueAt(r, 0))\n\t\topts.append({'label': site, 'value': site})\n\treturn opts\n",
                  "type": "script"
                }
              ],
              "type": "query"
            }
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "meta": {
          "name": "CatLbl"
        },
        "position": {
          "height": 24,
          "width": 80,
          "x": 316,
          "y": 66
        },
        "props": {
          "text": "Category:",
          "style": {
            "fontSize": 13,
            "fontWeight": "600",
            "color": "#0F172A",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "CategoryDropdown"
        },
        "position": {
          "height": 32,
          "width": 140,
          "x": 400,
          "y": 62
        },
        "props": {
          "value": "bug",
          "options": [
            {
              "label": "Bug / Error",
              "value": "bug"
            },
            {
              "label": "Data Issue",
              "value": "data"
            },
            {
              "label": "Feature Request",
              "value": "feature"
            },
            {
              "label": "UI / Display",
              "value": "ui"
            },
            {
              "label": "Other",
              "value": "other"
            }
          ],
          "style": {
            "border": "1px solid #E2E8F0",
            "borderRadius": "4px",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "meta": {
          "name": "FeedbackLbl"
        },
        "position": {
          "height": 20,
          "width": 520,
          "x": 20,
          "y": 106
        },
        "props": {
          "text": "Feedback:",
          "style": {
            "fontSize": 13,
            "fontWeight": "600",
            "color": "#0F172A",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "FeedbackInput"
        },
        "position": {
          "height": 150,
          "width": 520,
          "x": 20,
          "y": 128
        },
        "props": {
          "placeholder": "Describe the issue or suggestion...",
          "style": {
            "border": "1px solid #E2E8F0",
            "borderRadius": "4px",
            "fontSize": "13px",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "type": "ia.input.text-area"
      },
      {
        "meta": {
          "name": "CancelButton"
        },
        "position": {
          "height": 36,
          "width": 100,
          "x": 310,
          "y": 296
        },
        "props": {
          "text": "Cancel",
          "style": {
            "backgroundColor": "#FFFFFF",
            "border": "1px solid #E2E8F0",
            "borderRadius": "6px",
            "color": "#64748B",
            "fontWeight": "600",
            "fontSize": "13px",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.closePopup('feedback')\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "type": "ia.input.button"
      },
      {
        "meta": {
          "name": "SubmitButton"
        },
        "position": {
          "height": 36,
          "width": 120,
          "x": 420,
          "y": 296
        },
        "props": {
          "text": "Submit",
          "style": {
            "backgroundColor": "#1565C0",
            "color": "#FFFFFF",
            "borderRadius": "6px",
            "fontWeight": "600",
            "fontSize": "13px",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsite     = self.getSibling('SiteDropdown').props.value\n\tcategory = self.getSibling('CategoryDropdown').props.value\n\tfeedback = self.getSibling('FeedbackInput').props.text\n\tif not site:\n\t\tsystem.perspective.openPopup('fbError','Framework/ErrorPopup',\n\t\t\tparams={'message': 'Please select a site.'})\n\t\treturn\n\tif not feedback or not feedback.strip():\n\t\tsystem.perspective.openPopup('fbError','Framework/ErrorPopup',\n\t\t\tparams={'message': 'Please enter feedback before submitting.'})\n\t\treturn\n\ttry:\n\t\tuser = self.session.props.auth.user.userName or 'unknown'\n\t\tsystem.db.runNamedQuery(\n\t\t\t'coolingTowerData/insertUserFeedback',\n\t\t\t{'site': site, 'username': user, 'category': category, 'feedback': feedback.strip()}\n\t\t)\n\t\tsystem.perspective.closePopup('feedback')\n\t\tsystem.perspective.openPopup('fbSuccess','Framework/SuccessPopup',\n\t\t\tparams={'message': 'Thank you! Feedback submitted for ' + site + '.'})\n\texcept Exception as e:\n\t\tsystem.perspective.openPopup('fbError','Framework/ErrorPopup',\n\t\t\tparams={'message': 'Submit failed: ' + str(e)})\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "type": "ia.input.button"
      }
    ]
  }
}
