{
  "custom": {},
  "params": {
    "message": "Operation completed successfully."
  },
  "propConfig": {
    "params.message": { "paramDirection": "input" }
  },
  "props": {
    "defaultSize": { "width": 420, "height": 180 }
  },
  "root": {
    "meta": { "name": "root" },
    "type": "ia.container.flex",
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#FFFFFF",
        "borderRadius": "8px",
        "overflow": "hidden",
        "boxShadow": "0 4px 12px rgba(0,0,0,0.15)",
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      }
    },
    "children": [
      {
        "meta": { "name": "Header" },
        "position": { "basis": "48px", "shrink": 0 },
        "type": "ia.container.flex",
        "props": {
          "direction": "row",
          "style": {
            "backgroundColor": "#1B5E20",
            "alignItems": "center",
            "padding": "0 16px",
            "gap": "10px"
          }
        },
        "children": [
          {
            "meta": { "name": "Icon" },
            "type": "ia.display.label",
            "props": {
              "text": "✓",
              "style": {
                "color": "#FFFFFF",
                "fontSize": 18,
                "fontWeight": "bold"
              }
            }
          },
          {
            "meta": { "name": "Title" },
            "position": { "grow": 1 },
            "type": "ia.display.label",
            "props": {
              "text": "Success",
              "style": {
                "color": "#FFFFFF",
                "fontSize": 16,
                "fontWeight": "600"
              }
            }
          }
        ]
      },
      {
        "meta": { "name": "Body" },
        "position": { "grow": 1 },
        "type": "ia.container.flex",
        "props": {
          "direction": "column",
          "style": {
            "padding": "20px 16px",
            "justifyContent": "center"
          }
        },
        "children": [
          {
            "meta": { "name": "Message" },
            "type": "ia.display.label",
            "props": {
              "style": {
                "fontSize": 14,
                "color": "#0F172A",
                "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": { "path": "view.params.message" },
                  "type": "property"
                }
              }
            }
          }
        ]
      },
      {
        "meta": { "name": "Footer" },
        "position": { "basis": "52px", "shrink": 0 },
        "type": "ia.container.flex",
        "props": {
          "direction": "row",
          "style": {
            "justifyContent": "flex-end",
            "padding": "8px 16px",
            "borderTop": "1px solid #E2E8F0",
            "gap": "8px",
            "alignItems": "center"
          }
        },
        "children": [
          {
            "meta": { "name": "OKBtn" },
            "position": { "basis": "80px", "shrink": 0 },
            "type": "ia.input.button",
            "props": {
              "text": "OK",
              "style": {
                "classes": "btn-primary"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.closePopup(self.view.id)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
