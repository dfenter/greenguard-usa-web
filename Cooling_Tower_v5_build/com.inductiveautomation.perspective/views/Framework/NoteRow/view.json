{
  "custom": {},
  "params": {
    "t_stamp": "",
    "submittedBy": "",
    "note": ""
  },
  "propConfig": {
    "params.t_stamp": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.submittedBy": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.note": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex",
    "props": {
      "direction": "row",
      "style": {
        "borderBottom": "1px solid #E2E8F0",
        "padding": "4px 8px",
        "alignItems": "center",
        "minHeight": "36px",
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      }
    },
    "children": [
      {
        "meta": {
          "name": "NoteDate"
        },
        "position": {
          "basis": "100px"
        },
        "props": {
          "style": {
            "fontSize": 12,
            "color": "#64748B",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.t_stamp"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NoteUser"
        },
        "position": {
          "basis": "130px"
        },
        "props": {
          "style": {
            "fontSize": 12,
            "color": "#64748B",
            "fontStyle": "italic",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.submittedBy"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NoteText"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "fontSize": 13,
            "color": "#0F172A",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.note"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ]
  }
}
