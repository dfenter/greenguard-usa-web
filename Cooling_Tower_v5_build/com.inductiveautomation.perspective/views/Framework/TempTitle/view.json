{
  "custom": {},
  "params": {
    "title": ""
  },
  "propConfig": {
    "params.title": { "paramDirection": "input" }
  },
  "props": {
    "defaultSize": { "width": 960, "height": 34 }
  },
  "root": {
    "meta": { "name": "root" },
    "type": "ia.container.flex",
    "props": {
      "direction": "row",
      "style": {
        "alignItems": "center",
        "backgroundColor": "#2E3748",
        "padding": "0 14px",
        "height": "34px",
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      }
    },
    "children": [
      {
        "meta": { "name": "Title" },
        "type": "ia.display.label",
        "props": {
          "style": {
            "fontSize": 12,
            "fontWeight": "700",
            "color": "#FFFFFF",
            "letterSpacing": "0.8px",
            "textTransform": "uppercase",
            "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": { "path": "view.params.title" },
              "type": "property"
            }
          }
        }
      }
    ]
  }
}
