{
  "custom": {
    "countOutOfSpec": 0,
    "countWarning": 0,
    "countStale": 0,
    "totalSites": 0
  },
  "params": {},
  "propConfig": {
    "custom.countOutOfSpec": {
      "persistent": false,
      "binding": {
        "type": "query",
        "config": {
          "queryPath": "coolingTowerData/getFleetSummary",
          "parameters": {},
          "polling": {"enabled": true, "rate": 300000},
          "transform": {
            "type": "script",
            "config": {
              "script": "count = 0\nfor row in (value or []):\n\tif (row.get('worstDev', 0) or 0) > 10:\n\t\tcount += 1\nreturn count"
            }
          }
        }
      }
    },
    "custom.countWarning": {
      "persistent": false,
      "binding": {
        "type": "query",
        "config": {
          "queryPath": "coolingTowerData/getFleetSummary",
          "parameters": {},
          "polling": {"enabled": true, "rate": 300000},
          "transform": {
            "type": "script",
            "config": {
              "script": "count = 0\nfor row in (value or []):\n\tdev = row.get('worstDev', 0) or 0\n\tif dev > 5 and dev <= 10:\n\t\tcount += 1\nreturn count"
            }
          }
        }
      }
    },
    "custom.countStale": {
      "persistent": false,
      "binding": {
        "type": "query",
        "config": {
          "queryPath": "coolingTowerData/getFleetSummary",
          "parameters": {},
          "polling": {"enabled": true, "rate": 300000},
          "transform": {
            "type": "script",
            "config": {
              "script": "count = 0\nfor row in (value or []):\n\tdays = row.get('daysSince', None)\n\tif days is None or days > 30:\n\t\tcount += 1\nreturn count"
            }
          }
        }
      }
    },
    "custom.totalSites": {
      "persistent": false,
      "binding": {
        "type": "query",
        "config": {
          "queryPath": "coolingTowerData/getFleetSummary",
          "parameters": {},
          "polling": {"enabled": true, "rate": 300000},
          "transform": {
            "type": "script",
            "config": {
              "script": "return len(value) if value else 0"
            }
          }
        }
      }
    }
  },
