    "custom.siteConfig": {
      "persistent": true,
      "binding": {
        "type": "query",
        "config": {
          "queryPath": "coolingTowerData/getSiteConfig",
          "parameters": {"siteId": "{view.custom.siteId}"},
          "polling": {"enabled": false, "rate": 0},
          "transform": {
            "type": "script",
            "config": {
              "script": "if value and len(value) > 0:\n\trow = value[0]\n\tself.view.custom.MAC = row.get('MAC', 0) or 0\n\tself.view.custom.BAC = row.get('BAC', 0) or 0\n\tself.view.custom.RNC = row.get('RNC', 0) or 0\n\tself.view.custom.FNC = row.get('FNC', 0) or 0\n\tself.view.custom.GOX = row.get('GOX', 0) or 0\n\tself.view.custom.GAN = row.get('GAN', 0) or 0\n\tself.view.custom.CDA = row.get('CDA', 0) or 0\n\tself.view.custom.airExpander = row.get('airExpander', 0) or 0\n\tself.view.custom.warmExpander = row.get('warmExpander', 0) or 0\n\tself.view.custom.coldExpander = row.get('coldExpander', 0) or 0\n\tself.view.custom.argonSkid = row.get('argonSkid', 0) or 0\n\tself.view.custom.auxillaryCooler = row.get('auxillaryCooler', 0) or 0\n\tself.view.custom.DCAC = row.get('DCAC', 0) or 0\n\tself.view.custom.chiller = row.get('chiller', 0) or 0\n\tself.view.custom.NLUChiller = row.get('NLUChiller', 0) or 0\n\treturn row\nreturn {}"
            }
          }
        }
      }
    }
  },
