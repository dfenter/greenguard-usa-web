{
  "custom": {
    "sites": [],
    "selectedSiteId": 0,
    "selectedSiteName": "",
    "fleetData": []
  },
  "params": {
    "region": ""
  },
  "propConfig": {
    "params.region": {"paramDirection": "input", "persistent": true},
    "custom.fleetData": {
      "persistent": true,
      "binding": {
        "type": "query",
        "config": {
          "queryPath": "coolingTowerData/getFleetSummary",
          "parameters": {},
          "polling": {"enabled": false, "rate": 0},
          "transform": {
            "type": "script",
            "config": {
              "script": "region = self.view.params.region\nresult = []\nfor row in (value or []):\n\tif region and row.get('region', '') != region:\n\t\tcontinue\n\tlastEntry = row.get('lastEntry', None)\n\tif lastEntry is None:\n\t\tlastEntryStr = 'Never'\n\telse:\n\t\ttry:\n\t\t\tif hasattr(lastEntry, 'strftime'):\n\t\t\t\tlastEntryStr = lastEntry.strftime('%m/%d/%Y')\n\t\t\telse:\n\t\t\t\tlastEntryStr = str(lastEntry)[:10]\n\t\texcept:\n\t\t\tlastEntryStr = str(lastEntry)\n\tresult.append({\n\t\t'siteId': row.get('siteId', 0),\n\t\t'siteName': row.get('siteName', ''),\n\t\t'region': row.get('region', ''),\n\t\t'lastEntry': lastEntryStr,\n\t\t'daysSince': row.get('daysSince', 9999) or 9999,\n\t\t'worstDev': row.get('worstDev', 0) or 0,\n\t\t'completeness': row.get('completeness', 0) or 0,\n\t\t'equipment': row.get('equipment', 0) or 0\n\t})\nreturn result"
            }
          }
        }
      }
    },
    "custom.sites": {
      "persistent": true,
      "binding": {
        "type": "query",
        "config": {
          "queryPath": "coolingTowerData/getSitesByRegion",
          "parameters": {"region": "{view.params.region}"},
          "polling": {"enabled": false, "rate": 0},
          "transform": {
            "type": "script",
            "config": {
              "script": "fleetData = self.view.custom.fleetData\nfleetMap = {}\nfor fd in (fleetData or []):\n\tfleetMap[fd.get('siteId', 0)] = fd\nresult = []\nfor row in (value or []):\n\tsiteId = row.get('siteId', 0)\n\tfd = fleetMap.get(siteId, {})\n\tresult.append({\n\t\t'siteId': siteId,\n\t\t'siteName': row.get('siteName', ''),\n\t\t'region': row.get('region', self.view.params.region),\n\t\t'lastEntry': fd.get('lastEntry', 'Never'),\n\t\t'daysSince': fd.get('daysSince', 9999),\n\t\t'worstDev': fd.get('worstDev', 0),\n\t\t'completeness': fd.get('completeness', 0),\n\t\t'equipment': fd.get('equipment', 0),\n\t\t'instancePosition': {},\n\t\t'instanceStyle': {'classes': ''}\n\t})\nreturn result"
            }
          }
        }
      }
    }
  },
  "props": {
    "defaultSize": {"width": 1400, "height": 900}
  },
  "root": {
    "meta": {"name": "root"},
    "type": "ia.container.flex",
    "props": {
      "direction": "row",
      "style": {
        "width": "100%",
        "height": "100%",
        "backgroundColor": "#F4F6F8"
      }
    },
    "children": [
      {
        "meta": {"name": "Sidebar"},
        "type": "ia.container.flex",
        "position": {"basis": "260px", "shrink": 0},
        "props": {
          "direction": "column",
          "style": {
            "backgroundColor": "#F4F6F8",
            "padding": "12px",
            "gap": "8px",
            "borderRight": "1px solid #DDD",
            "overflowY": "auto"
          }
        },
        "children": [
          {
            "meta": {"name": "RegionTitle"},
            "type": "ia.display.label",
            "position": {"basis": "36px", "shrink": 0},
            "props": {
              "style": {
                "fontSize": 16,
                "fontWeight": "bold",
                "color": "#2C5F2E",
                "marginBottom": "8px"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {"path": "view.params.region"}
                }
              }
            }
          },
          {
            "meta": {"name": "SiteCards"},
            "type": "ia.display.flex-repeater",
            "position": {"grow": 1},
            "props": {
              "instances": [],
              "repeatMode": "children",
              "direction": "column",
              "style": {"gap": "8px"}
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "type": "property",
                  "config": {"path": "view.custom.sites"}
                }
              }
            },
            "children": [
              {
                "meta": {"name": "SiteCard"},
                "type": "ia.display.view",
                "position": {"basis": "110px", "shrink": 0},
                "props": {
                  "path": "Framework/SiteCard",
                  "params": {}
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "siteId = self.props.params.get('siteId', 0)\nsiteName = self.props.params.get('siteName', '')\nself.view.custom.selectedSiteId = siteId\nself.view.custom.selectedSiteName = siteName\nself.session.custom.currentSite = siteId\nself.session.custom.currentSiteName = siteName"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "meta": {"name": "MainArea"},
        "type": "ia.container.flex",
        "position": {"grow": 1},
        "props": {
          "direction": "column",
          "style": {
            "width": "100%",
            "height": "100%"
          }
        },
        "children": [
          {
            "meta": {"name": "Placeholder"},
            "type": "ia.container.flex",
            "position": {"grow": 1},
            "props": {
              "direction": "column",
              "style": {
                "alignItems": "center",
                "justifyContent": "center",
                "backgroundColor": "#F4F6F8"
              }
            },
            "propConfig": {
              "props.style.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.selectedSiteId} > 0, 'none', 'flex')"
                  }
                }
              }
            },
            "children": [
              {
                "meta": {"name": "PlaceholderLabel"},
                "type": "ia.display.label",
                "props": {
                  "text": "← Select a site from the list",
                  "style": {"fontSize": 18, "color": "#AAAAAA", "fontStyle": "italic"}
                }
              }
            ]
          },
          {
            "meta": {"name": "SiteView"},
            "type": "ia.display.view",
            "position": {"grow": 1},
            "props": {
              "path": "Sites/siteView",
              "params": {
                "siteId": 0,
                "tabIndex": 0
              },
              "style": {"width": "100%", "height": "100%"}
            },
            "propConfig": {
              "props.params.siteId": {
                "binding": {
                  "type": "property",
                  "config": {"path": "view.custom.selectedSiteId"}
                }
              },
              "props.style.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.selectedSiteId} > 0, 'flex', 'none')"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
