        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "siteId = self.view.custom.siteId\nif not siteId:\n\tsystem.perspective.openPopup('cfgErr', 'Framework/ErrorPopup', params={'message': 'Please select a site.'})\n\treturn\nMAC = self.view.custom.MAC\nBAC = self.view.custom.BAC\nRNC = self.view.custom.RNC\nFNC = self.view.custom.FNC\nGOX = self.view.custom.GOX\nGAN = self.view.custom.GAN\nCDA = self.view.custom.CDA\nAirExpander = self.view.custom.AirExpander\nWarmExpander = self.view.custom.WarmExpander\nColdExpander = self.view.custom.ColdExpander\nArgonSkid = self.view.custom.ArgonSkid\nAuxillaryCooler = self.view.custom.AuxillaryCooler\nDCAC = self.view.custom.DCAC\nChiller = self.view.custom.Chiller\nNLUChiller = self.view.custom.NLUChiller\ntry:\n\ttxID = system.db.beginNamedQueryTransaction(project='Cooling_Tower_Approach_Temps', database='Plant_Stats_DB_Write_Server')\n\tsystem.db.runNamedQuery(\n\t\tproject='Cooling_Tower_Approach_Temps',\n\t\tpath='coolingTowerData/updateSiteConfig',\n\t\tparameters={'siteId': siteId, 'MAC': MAC, 'BAC': BAC, 'RNC': RNC, 'FNC': FNC, 'GOX': GOX, 'GAN': GAN, 'CDA': CDA, 'AirExpander': AirExpander, 'WarmExpander': WarmExpander, 'ColdExpander': ColdExpander, 'ArgonSkid': ArgonSkid, 'AuxillaryCooler': AuxillaryCooler, 'DCAC': DCAC, 'Chiller': Chiller, 'NLUChiller': NLUChiller},\n\t\ttx=txID\n\t)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/MACDataEnable', parameters={'siteId': siteId, 'equipmentNumber': MAC}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/BACDataEnable', parameters={'siteId': siteId, 'equipmentNumber': BAC}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/RNCDataEnable', parameters={'siteId': siteId, 'equipmentNumber': RNC}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/FNCDataEnable', parameters={'siteId': siteId, 'equipmentNumber': FNC}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/GOXDataEnable', parameters={'siteId': siteId, 'equipmentNumber': GOX}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/GANDataEnable', parameters={'siteId': siteId, 'equipmentNumber': GAN}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/CDADataEnable', parameters={'siteId': siteId, 'equipmentNumber': CDA}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/AirExpanderDataEnable', parameters={'siteId': siteId, 'equipmentNumber': AirExpander}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/warmExpanderDataEnable', parameters={'siteId': siteId, 'equipmentNumber': WarmExpander}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/coldExpanderDataEnable', parameters={'siteId': siteId, 'equipmentNumber': ColdExpander}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/argonSkidDataEnable', parameters={'siteId': siteId, 'equipmentNumber': ArgonSkid}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/auxillaryCoolerDataEnable', parameters={'siteId': siteId, 'equipmentNumber': AuxillaryCooler}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/DCACDataEnable', parameters={'siteId': siteId, 'equipmentNumber': DCAC}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTowerData/enables/chillerDataEnable', parameters={'siteId': siteId, 'equipmentNumber': Chiller}, tx=txID)\n\tsystem.db.runNamedQuery(project='Cooling_Tower_Approach_Temps', path='coolingTo