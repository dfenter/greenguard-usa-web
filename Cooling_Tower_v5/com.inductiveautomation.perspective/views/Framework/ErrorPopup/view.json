{
  "custom": {},
  "params": { "message": "An error occurred." },
  "propConfig": { "params.message": { "paramDirection": "input" } },
  "props": { "defaultSize": { "width": 420, "height": 180 } },
  "root": {
    "meta": { "name": "root" },
    "type": "ia.container.flex",
    "props": { "direction": "column", "style": { "backgroundColor": "#FFFFFF", "borderRadius": "8px", "overflow": "hidden" } },
    "children": [
      {
        "meta": { "name": "Header" },
        "position": { "basis": "48px", "shrink": 0 },
        "props": { "direction": "row", "style": { "backgroundColor": "#D32F2F", "alignItems": "center", "padding": "0 16px", "gap": "10px" } },
        "type": "ia.container.flex",
        "children": [
          { "meta": { "name": "Icon" }, "props": { "text": "✕", "style": { "color": "#FFF", "fontSize": 18, "fontWeight": "bold" } }, "type": "ia.display.label" },
          { "meta": { "name": "Title" }, "position": { "grow": 1 }, "props": { "text": "Error", "style": { "color": "#FFF", "fontSize": 16, "fontWeight": "bold" } }, "type": "ia.display.label" }
        ]
      },
      {
        "meta": { "name": "Body" },
        "position": { "grow": 1 },
        "props": { "direction": "column", "style": { "padding": "20px 16px", "justifyContent": "center" } },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": { "name": "Message" },
            "props": { "style": { "fontSize": 14, "color": "#333" } },
            "propConfig": { "props.text": { "binding": { "config": { "path": "view.params.message" }, "type": "property" } } },
            "type": "ia.display.label"
          }
        ]
      },
      {
        "meta": { "name": "Footer" },
        "position": { "basis": "52px", "shrink": 0 },
        "props": { "direction": "row", "style": { "justifyContent": "flex-end", "padding": "8px 16px", "borderTop": "1px solid #EEE" } },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": { "name": "OKBtn" },
            "position": { "basis": "80px" },
            "props": { "text": "OK" },
            "events": { "component": { "onActionPerformed": { "config": { "script": "\tsystem.perspective.closePopup(self.view.id)\n" }, "scope": "G", "type": "script" } } },
            "type": "ia.input.button"
          }
        ]
      }
    ]
  }
}
