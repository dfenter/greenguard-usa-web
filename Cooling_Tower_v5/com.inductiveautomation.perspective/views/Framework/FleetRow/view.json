{
  "custom": {},
  "params": {
    "siteId": 0,
    "siteName": "",
    "region": "",
    "lastEntry": "Never",
    "daysSince": 9999,
    "worstDev": 0.0,
    "completeness": 0,
    "equipment": 0
  },
  "propConfig": {
    "params.siteId":       { "paramDirection": "input", "persistent": true },
    "params.siteName":     { "paramDirection": "input", "persistent": true },
    "params.region":       { "paramDirection": "input", "persistent": true },
    "params.lastEntry":    { "paramDirection": "input", "persistent": true },
    "params.daysSince":    { "paramDirection": "input", "persistent": true },
    "params.worstDev":     { "paramDirection": "input", "persistent": true },
    "params.completeness": { "paramDirection": "input", "persistent": true },
    "params.equipment":    { "paramDirection": "input", "persistent": true }
  },
  "props": {
    "defaultSize": { "width": 1200, "height": 44 }
  },
  "root": {
    "meta": { "name": "root" },
    "type": "ia.container.flex",
    "props": {
      "direction": "row",
      "style": {
        "height": "44px",
        "alignItems": "center",
        "borderBottom": "1px solid #E2E8F0",
        "padding": "0 12px",
        "cursor": "pointer",
        "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
      }
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "expression": "if({view.params.daysSince} > 30, \"#F8FAFC\", \"#FFFFFF\")"
          },
          "type": "expr"
        }
      }
    },
    "events": {
      "component": {
        "onActionPerformed": {
          "config": {
            "script": "\tregionMap = {\n\t\t'Central Region': '/region',\n\t\t'East Region': '/region',\n\t\t'Midwest Region': '/region',\n\t\t'North Region': '/region',\n\t\t'Northeast Region': '/region',\n\t\t'South Region': '/region',\n\t\t'Southeast Region': '/region',\n\t\t'Southwest Region': '/region'\n\t}\n\tself.session.custom.currentSite     = self.view.params.siteId\n\tself.session.custom.currentSiteName = self.view.params.siteName\n\tself.session.custom.currentRegion   = self.view.params.region\n\tsystem.perspective.navigate(page='/region')\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "children": [
      {
        "meta": { "name": "Site" },
        "position": { "basis": "180px", "shrink": 0 },
        "type": "ia.display.label",
        "props": {
          "style": {
            "fontSize": 13,
            "fontWeight": "600",
            "color": "#0F172A"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": { "path": "view.params.siteName" },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": { "name": "Region" },
        "position": { "basis": "160px", "shrink": 0 },
        "type": "ia.display.label",
        "props": {
          "style": {
            "fontSize": 12,
            "color": "#64748B"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": { "path": "view.params.region" },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": { "name": "Last" },
        "position": { "basis": "120px", "shrink": 0 },
        "type": "ia.display.label",
        "props": {
          "style": {
            "fontSize": 12,
            "color": "#64748B"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": { "path": "view.params.lastEntry" },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": { "name": "Days" },
        "position": { "basis": "80px", "shrink": 0 },
        "type": "ia.display.label",
        "props": {
          "style": {
            "fontSize": 12
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} >= 9999, \"Never\", toString({view.params.daysSince}) + \"d\")"
              },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} > 30, \"#DC2626\", if({view.params.daysSince} > 14, \"#D97706\", \"#0F172A\"))"
              },
              "type": "expr"
            }
          }
        }
      },
      {
        "meta": { "name": "Status" },
        "position": { "basis": "160px", "shrink": 0 },
        "type": "ia.display.label",
        "props": {
          "style": {
            "fontSize": 11,
            "fontWeight": "700",
            "borderRadius": "4px",
            "padding": "2px 10px",
            "textAlign": "center",
            "color": "#FFFFFF"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} > 30, \"🕐 STALE\", if({view.params.worstDev} > 10, \"⚠ OUT OF SPEC\", if({view.params.worstDev} > 5, \"⚠ WARNING\", \"✓ IN SPEC\")))"
              },
              "type": "expr"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if({view.params.daysSince} > 30, \"#94A3B8\", if({view.params.worstDev} > 10, \"#DC2626\", if({view.params.worstDev} > 5, \"#F59E0B\", \"#16A34A\")))"
              },
              "type": "expr"
            }
          }
        }
      },
      {
        "meta": { "name": "Completeness" },
        "position": { "basis": "190px", "shrink": 0 },
        "type": "ia.display.label",
        "props": {
          "style": {
            "fontSize": 12
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "toString({view.params.completeness}) + \"% · \" + toString({view.params.equipment}) + \" units\""
              },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "if({view.params.completeness} < 50, \"#DC2626\", if({view.params.completeness} < 80, \"#D97706\", \"#16A34A\"))"
              },
              "type": "expr"
            }
          }
        }
      }
    ]
  }
}
