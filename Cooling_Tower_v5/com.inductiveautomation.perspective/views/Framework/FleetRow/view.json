{
  "custom": {},
  "params": {
    "siteId": 0, "siteName": "", "region": "",
    "lastEntry": "Never", "daysSince": 9999,
    "worstDev": 0.0, "completeness": 0, "equipment": 0
  },
  "propConfig": {
    "params.siteId":       { "paramDirection": "input", "persistent": true },
    "params.siteName":     { "paramDirection": "input", "persistent": true },
    "params.region":       { "paramDirection": "input", "persistent": true },
    "params.lastEntry":    { "paramDirection": "input", "persistent": true },
    "params.daysSince":    { "paramDirection": "input", "persistent": true },
    "params.worstDev":     { "paramDirection": "input", "persistent": true },
    "params.completeness": { "paramDirection": "input", "persistent": true },
    "params.equipment":    { "paramDirection": "input", "persistent": true }
  },
  "props": { "defaultSize": { "width": 1200, "height": 40 } },
  "root": {
    "meta": { "name": "root" },
    "type": "ia.container.flex",
    "props": {
      "direction": "row",
      "style": { "alignItems": "center", "borderBottom": "1px solid #EEEEEE", "padding": "0 8px", "height": "40px", "cursor": "pointer" }
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": { "config": { "expression": "if({view.params.daysSince} > 30, \"#F5F5F5\", \"#FFFFFF\")" }, "type": "expr" }
      }
    },
    "children": [
      { "meta": { "name": "Site" },   "position": { "basis": "180px", "shrink": 0 }, "props": { "style": { "fontSize": 13, "fontWeight": "bold" } }, "propConfig": { "props.text": { "binding": { "config": { "path": "view.params.siteName" }, "type": "property" } } }, "type": "ia.display.label" },
      { "meta": { "name": "Region" }, "position": { "basis": "160px", "shrink": 0 }, "props": { "style": { "fontSize": 12, "color": "#666" } },           "propConfig": { "props.text": { "binding": { "config": { "path": "view.params.region" }, "type": "property" } } }, "type": "ia.display.label" },
      { "meta": { "name": "Last" },   "position": { "basis": "120px", "shrink": 0 }, "props": { "style": { "fontSize": 12 } },                            "propConfig": { "props.text": { "binding": { "config": { "path": "view.params.lastEntry" }, "type": "property" } } }, "type": "ia.display.label" },
      {
        "meta": { "name": "Days" }, "position": { "basis": "80px", "shrink": 0 }, "props": { "style": { "fontSize": 12 } },
        "propConfig": {
          "props.text": { "binding": { "config": { "expression": "if({view.params.daysSince} >= 9999, \"Never\", toString({view.params.daysSince}) + \"d\")" }, "type": "expr" } },
          "props.style.color": { "binding": { "config": { "expression": "if({view.params.daysSince} > 30, \"#CC0000\", if({view.params.daysSince} > 14, \"#E07B00\", \"#333\"))" }, "type": "expr" } }
        },
        "type": "ia.display.label"
      },
      {
        "meta": { "name": "Status" }, "position": { "basis": "150px", "shrink": 0 },
        "props": { "style": { "fontSize": 11, "fontWeight": "bold", "borderRadius": "4px", "padding": "2px 8px", "textAlign": "center" } },
        "propConfig": {
          "props.text": { "binding": { "config": { "expression": "if({view.params.daysSince} > 30, \"🕐 STALE\", if({view.params.worstDev} > 10, \"⚠ OUT OF SPEC\", if({view.params.worstDev} > 5, \"⚠ WARNING\", \"✓ IN SPEC\")))" }, "type": "expr" } },
          "props.style.backgroundColor": { "binding": { "config": { "expression": "if({view.params.daysSince} > 30, \"#CCC\", if({view.params.worstDev} > 10, \"#FF4444\", if({view.params.worstDev} > 5, \"#FFD700\", \"#70AD47\")))" }, "type": "expr" } },
          "props.style.color": { "binding": { "config": { "expression": "if({view.params.daysSince} > 30, \"#555\", if({view.params.worstDev} > 10, \"#FFF\", if({view.params.worstDev} > 5, \"#333\", \"#FFF\")))" }, "type": "expr" } }
        },
        "type": "ia.display.label"
      },
      {
        "meta": { "name": "Comp" }, "position": { "basis": "200px", "shrink": 0 }, "props": { "style": { "fontSize": 12 } },
        "propConfig": {
          "props.text": { "binding": { "config": { "expression": "toString({view.params.completeness}) + \"% · \" + toString({view.params.equipment}) + \" units\"" }, "type": "expr" } },
          "props.style.color": { "binding": { "config": { "expression": "if({view.params.completeness} < 50, \"#CC0000\", if({view.params.completeness} < 80, \"#E07B00\", \"#2E7D32\"))" }, "type": "expr" } }
        },
        "type": "ia.display.label"
      }
    ]
  }
}
