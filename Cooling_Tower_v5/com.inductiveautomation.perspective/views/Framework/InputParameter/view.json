{
  "custom": {},
  "params": {
    "id": 0,
    "siteId": 0,
    "parameter": "",
    "altEquipmentName": "",
    "approachTempTarget": null,
    "incomingWaterTempTarget": null,
    "processGasOutTempTarget": null,
    "designIncomingWaterTempF": null,
    "processGasOutTempF": null,
    "designApproachTempF": null,
    "previousIWT": null,
    "previousPOGT": null
  },
  "propConfig": {
    "params.id":                     { "paramDirection": "input", "persistent": true },
    "params.siteId":                  { "paramDirection": "input", "persistent": true },
    "params.parameter":               { "paramDirection": "input", "persistent": true },
    "params.altEquipmentName":        { "paramDirection": "input", "persistent": true },
    "params.approachTempTarget":      { "paramDirection": "input", "persistent": true },
    "params.incomingWaterTempTarget": { "paramDirection": "input", "persistent": true },
    "params.processGasOutTempTarget": { "paramDirection": "input", "persistent": true },
    "params.designIncomingWaterTempF":{ "paramDirection": "input", "persistent": true },
    "params.processGasOutTempF":      { "paramDirection": "input", "persistent": true },
    "params.designApproachTempF":     { "paramDirection": "input", "persistent": true },
    "params.previousIWT":             { "paramDirection": "input", "persistent": true },
    "params.previousPOGT":            { "paramDirection": "input", "persistent": true }
  },
  "props": { "defaultSize": { "width": 960, "height": 44 } },
  "root": {
    "meta": { "name": "root" },
    "type": "ia.container.flex",
    "props": {
      "direction": "row",
      "style": {
        "alignItems": "center",
        "borderBottom": "1px solid #E8E8E8",
        "padding": "4px 8px",
        "height": "44px",
        "backgroundColor": "#FFFFFF"
      }
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": { "expression": "if({view.params.designApproachTempF} is not null and {view.params.approachTempTarget} is not null and abs({view.params.designApproachTempF} - {view.params.approachTempTarget}) > 10, \"#FFF5F5\", \"#FFFFFF\")" },
          "type": "expr"
        }
      }
    },
    "children": [
      {
        "meta": { "name": "EquipName" },
        "position": { "basis": "200px", "shrink": 0 },
        "props": { "style": { "fontSize": 13, "fontWeight": "bold", "color": "#222" } },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": { "expression": "if({view.params.altEquipmentName} != \"\", {view.params.altEquipmentName}, {view.params.parameter})" },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": { "name": "IWTActual" },
        "position": { "basis": "100px", "shrink": 0 },
        "propConfig": {
          "props.value": {
            "binding": { "config": { "bidirectional": true, "path": "view.params.designIncomingWaterTempF" }, "type": "property" }
          }
        },
        "props": { "placeholder": "IWT °F", "style": { "fontSize": 13 } },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": { "name": "IWTTarget" },
        "position": { "basis": "100px", "shrink": 0 },
        "propConfig": {
          "props.value": {
            "binding": { "config": { "bidirectional": true, "path": "view.params.incomingWaterTempTarget" }, "type": "property" }
          }
        },
        "props": { "placeholder": "IWT Tgt", "style": { "fontSize": 13, "color": "#777" } },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": { "name": "POGTActual" },
        "position": { "basis": "100px", "shrink": 0 },
        "propConfig": {
          "props.value": {
            "binding": { "config": { "bidirectional": true, "path": "view.params.processGasOutTempF" }, "type": "property" }
          }
        },
        "props": { "placeholder": "POGT °F", "style": { "fontSize": 13 } },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": { "name": "POGTTarget" },
        "position": { "basis": "100px", "shrink": 0 },
        "propConfig": {
          "props.value": {
            "binding": { "config": { "bidirectional": true, "path": "view.params.processGasOutTempTarget" }, "type": "property" }
          }
        },
        "props": { "placeholder": "POGT Tgt", "style": { "fontSize": 13, "color": "#777" } },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": { "name": "DATActual" },
        "position": { "basis": "90px", "shrink": 0 },
        "props": { "style": { "fontSize": 13, "fontWeight": "bold", "textAlign": "center" } },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": { "expression": "if({view.params.designApproachTempF} is not null, toString(round({view.params.designApproachTempF}, 2)) + \" °F\", \"—\")" },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": { "expression": "if({view.params.designApproachTempF} is not null and {view.params.approachTempTarget} is not null, if(abs({view.params.designApproachTempF} - {view.params.approachTempTarget}) > 10, \"#CC0000\", if(abs({view.params.designApproachTempF} - {view.params.approachTempTarget}) > 5, \"#B8860B\", \"#2E7D32\")), \"#555555\")" },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": { "name": "DATTarget" },
        "position": { "basis": "100px", "shrink": 0 },
        "propConfig": {
          "props.value": {
            "binding": { "config": { "bidirectional": true, "path": "view.params.approachTempTarget" }, "type": "property" }
          }
        },
        "props": { "placeholder": "DAT Tgt", "style": { "fontSize": 13, "color": "#777" } },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": { "name": "DevBadge" },
        "position": { "basis": "110px", "shrink": 0 },
        "props": { "style": { "fontSize": 11, "fontWeight": "bold", "borderRadius": "4px", "padding": "2px 6px", "textAlign": "center" } },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": { "expression": "if({view.params.designApproachTempF} is not null and {view.params.approachTempTarget} is not null, \"Δ \" + toString(round(abs({view.params.designApproachTempF} - {view.params.approachTempTarget}), 1)) + \" °F\", \"—\")" },
              "type": "expr"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": { "expression": "if({view.params.designApproachTempF} is not null and {view.params.approachTempTarget} is not null, if(abs({view.params.designApproachTempF} - {view.params.approachTempTarget}) > 10, \"#FF4444\", if(abs({view.params.designApproachTempF} - {view.params.approachTempTarget}) > 5, \"#FFD700\", \"#70AD47\")), \"#EEEEEE\")" },
              "type": "expr"
            }
          },
          "props.style.color": {
            "binding": {
              "config": { "expression": "if({view.params.designApproachTempF} is not null and {view.params.approachTempTarget} is not null, if(abs({view.params.designApproachTempF} - {view.params.approachTempTarget}) > 10, \"#FFF\", if(abs({view.params.designApproachTempF} - {view.params.approachTempTarget}) > 5, \"#333\", \"#FFF\")), \"#888\")" },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      }
    ]
  }
}
