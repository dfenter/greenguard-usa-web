# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-...

# ── Cal.com ───────────────────────────────────────────────────────────────────
CALCOM_WEBHOOK_SECRET=...
# Your Cal.com username (appears in booking URLs: cal.com/{username}/{event-slug})
CALCOM_USERNAME=greenguard
# API key — used by admin booking page + route optimizer
CALCOM_API_KEY=cal_live_...

# ── Google — OAuth2 (calendar reads + route optimizer) ───────────────────────
# One-time setup (run once on your Mac):
#   1. console.cloud.google.com → APIs & Services → Credentials
#      → Create Credentials → OAuth 2.0 Client ID → Desktop app → Create
#   2. Copy the Client ID and Client Secret
#   3. Run: GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... python3 _scripts/get-google-refresh-token.py
#      Sign in as admin@greenguard-usa.com — it prints the refresh token
#   4. Paste all three values below (and into Vercel env vars + GitHub secrets)
GOOGLE_CLIENT_ID=<your OAuth client ID>
GOOGLE_CLIENT_SECRET=<your OAuth client secret>
GOOGLE_REFRESH_TOKEN=<refresh token from get-google-refresh-token.py>

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_string_at_least_32_chars

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
PORTAL_FROM_EMAIL=noreply@greenguard-usa.com

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://portal.greenguard-usa.com

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Measurement ID from GA4 → Admin → Data Streams → your stream
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Maps API (Maps JavaScript + Places + Distance Matrix) ──────────────
# Enable ALL of these in Google Cloud Console → APIs & Services → Enabled APIs:
#   - Maps JavaScript API  (portal map pages)
#   - Places API           (fetch_reviews.py GitHub Action)
#   - Distance Matrix API  (route optimizer)
# Restrict to: portal.greenguard-usa.com/* and greenguard-usa-web-*.vercel.app/*
# Set as BOTH a Vercel env var AND a GitHub Actions secret under the same name.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...
