# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-...

# ── Cal.com ───────────────────────────────────────────────────────────────────
# Only the webhook secret is needed by the Vercel app.
# The API key is only used by the route optimizer (GitHub Actions secret).
CALCOM_WEBHOOK_SECRET=...

# ── Google — service account (calendar reads + route optimizer) ───────────────
# Steps to create:
#   1. Google Cloud Console → IAM → Service Accounts → Create
#   2. Enable Google Calendar API on the project
#   3. Grant the service account "Domain-wide delegation" in the service account settings
#   4. Google Workspace Admin → Security → API Controls → Domain-wide delegation
#      → Add client ID of service account, scope: https://www.googleapis.com/auth/calendar.readonly
#   5. Download the service account JSON key
#   6. Base64-encode it:  base64 -i key.json | tr -d '\n'
#   7. Paste the result below (and into Vercel env vars + GitHub secret)
GOOGLE_SERVICE_ACCOUNT_KEY=<base64-encoded service account JSON>

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_string_at_least_32_chars

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
PORTAL_FROM_EMAIL=noreply@greenguard-usa.com

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://portal.greenguard-usa.com
