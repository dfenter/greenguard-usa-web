---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, pubDate, category } = entry.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title={`${title} | GreenGuard USA`} description={description}>
  <!-- HERO -->
  <section class="bg-gradient-to-br from-bg-card via-bg to-accent-deep/40 py-16 px-5 text-center">
    <div class="max-w-3xl mx-auto">
      <div class="eyebrow mb-3">{category}</div>
      <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-4 leading-tight">
        {title}
      </h1>
      <p class="text-cream/70 text-base leading-relaxed max-w-2xl mx-auto mb-4">{description}</p>
      <div class="text-cream/40 text-xs">{formattedDate}</div>
    </div>
  </section>

  <!-- ARTICLE -->
  <article class="py-16 px-5">
    <div class="max-w-2xl mx-auto prose-gg">
      <Content />
    </div>
  </article>

  <!-- CTA -->
  <section class="py-16 px-5 bg-bg-panel text-center">
    <div class="max-w-xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Ready to protect your yard?</h2>
      <p class="text-cream/75 mb-6">Free property assessment. No pressure, no obligation.</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/book" class="btn-gold">Book Free Assessment</a>
        <a href="/blog" class="btn-outline">More Articles</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .prose-gg :global(h2) {
    font-size: 1.35rem;
    font-weight: 800;
    color: #fff;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .prose-gg :global(p) {
    color: rgba(201, 232, 209, 0.82);
    line-height: 1.75;
    margin-bottom: 1.15rem;
    font-size: 0.97rem;
  }
  .prose-gg :global(ul) {
    list-style: none;
    padding: 0;
  }
  .prose-gg :global(ul li) {
    color: rgba(201, 232, 209, 0.8);
    padding-left: 1.25rem;
    position: relative;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .prose-gg :global(ul li::before) {
    content: '✓';
    position: absolute;
    left: 0;
    color: #7dffaa;
    font-weight: 800;
  }
  .prose-gg :global(a) {
    color: #7dffaa;
    text-decoration: underline;
  }
</style>
