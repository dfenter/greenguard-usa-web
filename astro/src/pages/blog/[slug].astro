---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, pubDate, category } = entry.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  "dateModified": pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "GreenGuard USA",
    "url": "https://www.greenguard-usa.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "GreenGuard USA",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.greenguard-usa.com/og-image.jpg"
    }
  },
  "url": `https://www.greenguard-usa.com/blog/${entry.slug}`,
  "mainEntityOfPage": `https://www.greenguard-usa.com/blog/${entry.slug}`,
  "articleSection": category,
  "keywords": `mosquito control Austin TX, ${category}, GreenGuard USA`
};
---

<Base title={`${title} | GreenGuard USA`} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  <!-- HERO -->
  <section class="bg-gradient-to-br from-bg-card via-bg to-accent-deep/40 py-16 px-5 text-center">
    <div class="max-w-3xl mx-auto">
      <div class="eyebrow mb-3">{category}</div>
      <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-4 leading-tight">
        {title}
      </h1>
      <p class="text-cream/70 text-base leading-relaxed max-w-2xl mx-auto mb-4">{description}</p>
      <div class="text-cream/40 text-xs">{formattedDate}</div>
    </div>
  </section>

  <!-- ARTICLE -->
  <article class="py-16 px-5">
    <div class="max-w-2xl mx-auto prose-gg">
      <Content />
    </div>
  </article>

  <!-- RELATED RESOURCES -->
  <section class="py-10 px-5">
    <div class="max-w-2xl mx-auto">
      <div class="eyebrow mb-4">Related</div>
      <div class="space-y-3">
        <a href="/mosquito-control-austin-texas" class="card flex items-center justify-between gap-4 hover:border-accent/40 transition-colors" style="text-decoration: none;">
          <div>
            <div class="text-white font-semibold text-sm">Mosquito Control Austin TX: Complete Guide</div>
            <p class="text-cream/55 text-xs mt-0.5">Species, season, treatment options, and costs — the full picture for Austin homeowners.</p>
          </div>
          <span class="text-accent flex-shrink-0 text-lg">→</span>
        </a>
        <a href="/compare" class="card flex items-center justify-between gap-4 hover:border-accent/40 transition-colors" style="text-decoration: none;">
          <div>
            <div class="text-white font-semibold text-sm">CO₂ Trapping vs. Spray vs. DIY</div>
            <p class="text-cream/55 text-xs mt-0.5">Side-by-side comparison of all mosquito control options with honest pros and cons.</p>
          </div>
          <span class="text-accent flex-shrink-0 text-lg">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-5 bg-bg-panel text-center">
    <div class="max-w-xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Ready to protect your yard?</h2>
      <p class="text-cream/75 mb-6">Free property assessment. No pressure, no obligation.</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="/book" class="btn-gold">Book Free Assessment</a>
        <a href="/blog" class="btn-outline">More Articles</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .prose-gg :global(h2) {
    font-size: 1.35rem;
    font-weight: 800;
    color: #fff;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .prose-gg :global(p) {
    color: rgba(201, 232, 209, 0.82);
    line-height: 1.75;
    margin-bottom: 1.15rem;
    font-size: 0.97rem;
  }
  .prose-gg :global(ul) {
    list-style: none;
    padding: 0;
  }
  .prose-gg :global(ul li) {
    color: rgba(201, 232, 209, 0.8);
    padding-left: 1.25rem;
    position: relative;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .prose-gg :global(ul li::before) {
    content: '✓';
    position: absolute;
    left: 0;
    color: #7dffaa;
    font-weight: 800;
  }
  .prose-gg :global(a) {
    color: #7dffaa;
    text-decoration: underline;
  }
</style>
