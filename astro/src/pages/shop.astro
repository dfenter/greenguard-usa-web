</section>

<!-- NOT SURE CTA -->
<section class="py-20 px-5 text-center" style="background: linear-gradient(160deg, #0d1a10, #0a1208);">
  <div class="max-w-xl mx-auto">
    <div class="eyebrow mb-4">No Obligation · Austin TX</div>
    <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-4">Not sure which system is right?</h2>
    <p class="text-cream/60 leading-relaxed mb-8">
      Every equipment order includes a free property consultation. We visit your yard, map mosquito pressure zones, and confirm your trap placement is optimized before your first tank runs.
    </p>
    <a href="/book" class="btn-gold inline-block mr-3">Book Free Assessment</a>
    <a href="tel:5125604129" class="text-cream/50 text-sm hover:text-cream/80 transition-colors">or call 512-560-4129</a>
  </div>
</section>

<CartDrawer />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Success banner
    if (new URLSearchParams(window.location.search).get('order') === 'success') {
      document.getElementById('order-success')?.classList.remove('hidden');
      // Recover cart value for revenue tracking before clearing
      let cartValue = 0;
      try {
        const cart = JSON.parse(localStorage.getItem('gg_cart') || '[]');
        cartValue = cart.reduce((s: number, i: {price?: number, qty?: number}) => s + ((i.price || 0) * (i.qty || 1)), 0);
      } catch {}
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'purchase', {
          currency: 'USD',
          value: cartValue,
          transaction_id: Date.now().toString(),
        });
      }
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Purchase', { currency: 'USD', value: cartValue });
      }
      localStorage.removeItem('gg_cart');
    }

    // Wire add-to-cart buttons
    document.querySelectorAll('button[data-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLButtonElement;
        const { id, name, price } = el.dataset;
        if (!id || !name || !price) return;
        (window as any).addToCart(id, name, parseFloat(price));
        // Flash button
        const orig = el.textContent;
        el.textContent = '✓ Added';
        el.style.background = 'linear-gradient(135deg, #7dffaa, #5ddf8a)';
        setTimeout(() => {
          el.textContent = orig;
          el.style.background = 'linear-gradient(135deg, #d4b45a, #c9a84c)';
        }, 1200);
      });
    });
  });
</script>

</Base>
