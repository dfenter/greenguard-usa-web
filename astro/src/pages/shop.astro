---
import Base from '../layouts/Base.astro';
import CartDrawer from '../components/CartDrawer.astro';

const products = [
  {
    id: 'biogents-co2-trap',
    name: 'Biogents BG-Mosquitaire CO₂ Trap',
    tagline: 'The scientific standard in outdoor mosquito control',
    badge: 'Best Seller',
    badgeStyle: 'accent',
    price: 299.99,
    originalPrice: null,
    image: '/images/prod-biogents-co2.jpg',
    desc: 'CO₂-powered attraction captures host-seeking mosquitoes 24/7. No pesticides. Up to quarter-acre coverage.',
    pills: ['Up to 6,500 sq ft coverage', '24/7 silent operation', 'Regulator included'],
  },
  {
    id: 'all-in-one-bundle',
    name: 'All-in-One Starter Bundle',
    tagline: 'Everything you need. Day-one ready.',
    badge: 'Most Complete',
    badgeStyle: 'gold',
    price: 619.99,
    originalPrice: 649.97,
    image: '/images/prod-all-in-one-bundle.jpg',
    desc: 'CO₂ trap, timer, 20 lb tank, and bait pack in one order. Add a CO₂ fill and start the same day.',
    pills: ['Save $29.98', 'Includes CO₂ tank', 'Timer included'],
    featured: true,
  },
  {
    id: 'mosqitter-grand',
    name: 'Mosqitter Grand CO₂ Trap',
    tagline: 'Stainless steel. App-connected. Built to last.',
    badge: 'Premium',
    badgeStyle: 'gold',
    price: 1849.99,
    originalPrice: null,
    image: '/images/mosqitterGrand1.webp',
    desc: 'Professional-grade stainless steel with smartphone monitoring and one-acre coverage per unit.',
    pills: ['Up to 2-acre coverage', 'Bluetooth app', 'Stainless steel'],
  },
  {
    id: 'biogents-non-co2-trap',
    name: 'BG-Mosquitaire (No CO₂)',
    tagline: 'Heat and scent. No tank required.',
    badge: 'No Tank Needed',
    badgeStyle: 'accent',
    price: 199.99,
    originalPrice: null,
    image: '/images/mosquitairenoco2.webp',
    desc: 'Heat and scent-based attraction for indoor spaces, covered patios, and sheltered outdoor areas.',
    pills: ['No CO₂ tank', 'Indoor / outdoor', 'Low maintenance'],
  },
  {
    id: 'biogents-co2-timer',
    name: 'Biogents CO₂ Tank Timer',
    tagline: 'Cut CO₂ use by 50%. Extend your tank life.',
    badge: 'Recommended Add-on',
    badgeStyle: 'accent',
    price: 109.99,
    originalPrice: null,
    image: '/images/prod-co2-timer.png',
    desc: 'Programmable timer pauses CO₂ during low-activity hours. Reduces tank consumption by up to 50%.',
    pills: ['Up to 75% CO₂ savings', 'Battery-powered', 'Controls up to 5 traps'],
    outOfStock: true,
  },
  {
    id: 'co2-tank-20lb',
    name: 'CO₂ Tank (20 lb Empty Cylinder)',
    tagline: 'DOT-certified. CGA-320 valve. Refill anywhere.',
    badge: 'Accessory',
    badgeStyle: 'neutral',
    price: 239.99,
    originalPrice: null,
    image: '/images/tank.jpeg',
    desc: 'DOT-certified aluminum cylinder. Sold empty for local refill. Lasts 20–27 days per trap.',
    pills: ['DOT-certified', 'CGA-320 valve', '20–27 day runtime'],
  },
];

const featured = products.find(p => p.featured)!;
const grid = products.filter(p => !p.featured);

function badgeClasses(style: string) {
  if (style === 'gold') return 'bg-gold/15 text-gold border border-gold/30';
  if (style === 'accent') return 'bg-accent/10 text-accent border border-accent/25';
  return 'bg-cream/8 text-cream/60 border border-cream/15';
}
---

<Base
  title="Shop Mosquito Control Equipment | GreenGuard USA"
  description="Buy Biogents CO₂ traps, Mosqitter Grand, timers, tanks, and accessories. Professional mosquito control equipment used by GreenGuard USA in Austin, TX."
>

<!-- ORDER SUCCESS BANNER -->
<div id="order-success" class="hidden py-4 px-5 text-center text-sm font-bold" style="background: rgba(125,255,170,0.08); border-bottom: 1px solid rgba(125,255,170,0.2); color: #7dffaa;">
  Order placed. Check your email for confirmation and shipping details.
</div>

<!-- HERO -->
<section class="relative overflow-hidden py-24 px-5 text-center" style="background: linear-gradient(160deg, #060d07 0%, #0d1a10 40%, #111e12 100%);">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] rounded-full" style="border: 1px solid rgba(201,168,76,0.05);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full" style="border: 1px solid rgba(122,171,130,0.07);"></div>
  </div>
  <div class="relative z-10 max-w-3xl mx-auto">
    <div class="eyebrow mb-4">Professional Equipment · Austin, TX</div>
    <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight leading-none mb-6">
      Serious equipment.<br><span class="text-accent">Zero pesticides.</span>
    </h1>
    <p class="text-cream/65 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-8">
      The same CO₂ trap systems GreenGuard USA installs and maintains across Austin.
      Backed by science, built to last, shipped from Texas.
    </p>
    <div class="flex flex-wrap gap-2 justify-center">
      {[
        { icon: '🔒', text: 'Secure checkout' },
        { icon: '📦', text: 'Ships from Austin TX' },
        { icon: '🌿', text: 'Pesticide-free technology' },
        { icon: '📋', text: 'Free assessment included' },
      ].map(t => (
        <span class="flex items-center gap-1.5 text-cream/55 text-xs font-semibold px-3 py-1.5 rounded-full" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(122,171,130,0.15);">
          <span>{t.icon}</span>{t.text}
        </span>
      ))}
    </div>
  </div>
</section>

<!-- QUOTE BUILDER BANNER -->
<section class="py-12 px-5" style="background: #070e08; border-top: 1px solid rgba(122,171,130,0.1); border-bottom: 1px solid rgba(122,171,130,0.1);">
  <div class="max-w-container mx-auto">
    <div class="rounded-2xl px-8 py-10 md:px-14 md:py-12 flex flex-col md:flex-row items-center justify-between gap-6" style="background: linear-gradient(135deg, #0d1a10, #111e12); border: 1px solid rgba(201,168,76,0.2);">
      <div>
        <div class="eyebrow mb-2">Already a GreenGuard customer?</div>
        <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight leading-tight mb-2">See what an upgrade would cost</h2>
        <p class="text-cream/60 text-sm leading-relaxed max-w-md">Add a second system, expand your coverage, or upgrade to Mosqitter Grand. See the exact monthly and one-time costs before you commit.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0">
        <a href="https://portal.greenguard-usa.com/quote/new" class="btn-gold whitespace-nowrap">Quote Builder</a>
        <a href="https://portal.greenguard-usa.com/dashboard/upgrade" class="btn-outline whitespace-nowrap">Upgrade Calculator</a>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCT -->
<section class="py-16 px-5" style="background: #0a1208;">
  <div class="max-w-container mx-auto">
    <div class="eyebrow mb-3 text-center">Most Popular</div>
    <div class="rounded-2xl overflow-hidden grid md:grid-cols-2 gap-0" style="border: 1px solid rgba(201,168,76,0.2); background: linear-gradient(135deg, #0d1a10, #111e12);">
      <!-- Image -->
      <div class="relative aspect-square md:aspect-auto overflow-hidden" style="min-height: 320px;">
        <img
          src={featured.image}
          alt={featured.name}
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0" style="background: linear-gradient(to right, transparent 60%, #0d1a10);"></div>
        <div class="absolute top-5 left-5">
          <span class="text-xs font-black tracking-widest uppercase px-3 py-1.5 rounded-full" style="background: rgba(201,168,76,0.9); color: #0a1208;">{featured.badge}</span>
        </div>
      </div>
      <!-- Info -->
      <div class="p-8 md:p-12 flex flex-col justify-center">
        <div class="eyebrow mb-3">{featured.tagline}</div>
        <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight leading-tight mb-4">{featured.name}</h2>
        <p class="text-cream/70 leading-relaxed mb-6">{featured.desc}</p>
        <div class="flex flex-wrap gap-2 mb-8">
          {featured.pills.map(p => (
            <span class="text-xs font-bold text-accent px-3 py-1 rounded-full" style="background: rgba(122,171,130,0.1); border: 1px solid rgba(122,171,130,0.2);">{p}</span>
          ))}
        </div>
        <div class="flex items-baseline gap-3 mb-6">
          <span class="text-4xl font-black text-white">${featured.price.toFixed(2)}</span>
          {featured.originalPrice && (
            <span class="text-cream/35 text-lg line-through">${featured.originalPrice.toFixed(2)}</span>
          )}
          {featured.originalPrice && (
            <span class="text-xs font-black text-accent bg-accent/10 border border-accent/20 px-2 py-0.5 rounded">
              Save ${(featured.originalPrice - featured.price).toFixed(2)}
            </span>
          )}
        </div>
        <div class="flex gap-3 flex-col sm:flex-row">
          <button
            class="flex-1 py-4 rounded-xl font-black text-sm tracking-widest uppercase transition-all hover:scale-[1.02] active:scale-[0.98]"
            style="background: linear-gradient(135deg, #d4b45a, #c9a84c); color: #070e08; box-shadow: 0 4px 20px rgba(201,168,76,0.3);"
            data-id={featured.id}
            data-name={featured.name}
            data-price={featured.price}
          >
            Add to Cart
          </button>
          <a
            href={`/shop/${featured.id}`}
            class="flex-1 py-4 rounded-xl font-black text-sm tracking-widest uppercase text-center transition-all hover:bg-accent/10"
            style="border: 1px solid rgba(122,171,130,0.3); color: rgba(212,230,202,0.7);"
          >
            View Details
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCT GRID -->
<section class="py-16 px-5" style="background: #0d1a10;">
  <div class="max-w-container mx-auto">
    <div class="text-center mb-12">
      <div class="eyebrow mb-2">The Full Collection</div>
      <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">Every tool in the arsenal</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {grid.map(p => (
        <article class="group rounded-2xl overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-1" style="background: #0a1208; border: 1px solid rgba(122,171,130,0.12);">
          <!-- Image -->
          <a href={`/shop/${p.id}`} class="block relative overflow-hidden" style="aspect-ratio: 4/3;">
            <img
              src={p.image}
              alt={p.name}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 transition-opacity duration-300" style="background: linear-gradient(to top, rgba(7,14,8,0.8) 0%, transparent 50%);"></div>
            <div class="absolute top-4 left-4">
              <span class={`text-xs font-black tracking-wider uppercase px-2.5 py-1 rounded-full ${badgeClasses(p.badgeStyle)}`}>{p.badge}</span>
            </div>
          </a>
          <!-- Info -->
          <div class="p-6 flex flex-col flex-1">
            <div class="text-cream/45 text-xs font-semibold uppercase tracking-widest mb-1">{p.tagline}</div>
            <h3 class="text-white font-black text-lg leading-snug mb-2">{p.name}</h3>
            <p class="text-cream/55 text-sm leading-relaxed mb-4 flex-1">{p.desc}</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {p.pills.map(pill => (
                <span class="text-xs text-cream/50 px-2.5 py-1 rounded-full" style="background: rgba(122,171,130,0.07); border: 1px solid rgba(122,171,130,0.15);">{pill}</span>
              ))}
            </div>
            <div class="flex items-baseline gap-2 mb-5">
              <span class="text-2xl font-black text-white">${p.price.toFixed(2)}</span>
              {p.originalPrice && (
                <span class="text-cream/30 text-sm line-through">${p.originalPrice.toFixed(2)}</span>
              )}
            </div>
            <div class="flex gap-2">
              {p.outOfStock ? (
                <button
                  disabled
                  class="flex-1 py-3 rounded-lg font-black text-xs tracking-widest uppercase cursor-not-allowed"
                  style="background: rgba(122,171,130,0.08); color: rgba(212,230,202,0.3); border: 1px solid rgba(122,171,130,0.15);"
                >
                  Out of Stock
                </button>
              ) : (
                <button
                  class="flex-1 py-3 rounded-lg font-black text-xs tracking-widest uppercase transition-all hover:scale-[1.02] active:scale-[0.98]"
                  style="background: linear-gradient(135deg, #d4b45a, #c9a84c); color: #070e08;"
                  data-id={p.id}
                  data-name={p.name}
                  data-price={p.price}
                >
                  Add to Cart
                </button>
              )}
              <a
                href={`/shop/${p.id}`}
                class="px-4 py-3 rounded-lg font-bold text-xs text-cream/50 hover:text-cream/80 transition-colors"
                style="border: 1px solid rgba(122,171,130,0.2);"
              >
                Details
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- TRAP COMPARISON TABLE -->
<section class="py-14 px-5 bg-bg-panel">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-8">
