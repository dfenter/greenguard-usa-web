---
import Base from '../layouts/Base.astro';
import Reviews from '../components/Reviews.astro';
import CustomerCount from '../components/CustomerCount.astro';
---

<Base title="Eco-Friendly Mosquito Control Austin TX | GreenGuard USA">
  <!-- HERO -->
  <section class="bg-gradient-to-br from-bg-card via-bg to-accent-deep/40 pt-20 pb-16 px-5">
    <div class="max-w-container mx-auto text-center">
      <CustomerCount />

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1] mt-6 mb-5">
        Take your yard back from mosquitoes,
        <span class="text-accent block mt-2">without pesticides.</span>
      </h1>

      <p class="text-cream/80 text-base md:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
        We use CO₂-baited traps that catch only blood-seeking mosquitoes. Safe for kids, pets, bees,
        and butterflies. Set up by an all-electric Austin team.
      </p>

      <div class="flex gap-3 justify-center flex-wrap mb-8">
        <a href="/book" class="btn-gold">Book Free Assessment</a>
        <a href="tel:5125604129" class="btn-outline">Call 512-560-4129</a>
      </div>

      <div class="flex gap-2 justify-center flex-wrap text-xs">
        <span class="bg-bg-card/50 border border-accent/20 rounded-full px-3 py-1 text-cream/70">No pesticides</span>
        <span class="bg-bg-card/50 border border-accent/20 rounded-full px-3 py-1 text-cream/70">Bee-safe</span>
        <span class="bg-bg-card/50 border border-accent/20 rounded-full px-3 py-1 text-cream/70">Month-to-month</span>
        <span class="bg-bg-card/50 border border-accent/20 rounded-full px-3 py-1 text-cream/70">EV fleet</span>
      </div>
    </div>
  </section>

  <!-- THE SCIENCE -->
  <section class="py-16 px-5">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">The Science</div>
        <h2 class="text-3xl md:text-4xl font-black text-white mb-3 leading-tight">
          How CO₂ trapping works
        </h2>
        <p class="text-cream/70 max-w-2xl mx-auto">
          Mosquitoes find you by tracking the CO₂ you exhale. We use that against them silently,
          continuously, without a single pesticide.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="card">
          <div class="text-white font-bold mb-2">CO₂ Mimics Human Breath</div>
          <p class="text-cream/65 text-sm leading-relaxed">
            Our CO₂ traps emit a precise stream of carbon dioxide along with a customized scent bait,
            attracting mosquitoes using the exact signals humans naturally produce.
          </p>
        </div>
        <div class="card">
          <div class="text-white font-bold mb-2">Mosquitoes Enter the Trap</div>
          <p class="text-cream/65 text-sm leading-relaxed">
            Lured in, mosquitoes are sucked in by a fan and captured in a net. No zapping, no pesticides,
            no residue, just quiet, targeted control at the source.
          </p>
        </div>
        <div class="card">
          <div class="text-white font-bold mb-2">We Refill. You Relax.</div>
          <p class="text-cream/65 text-sm leading-relaxed">
            We deliver and install full CO₂ tanks to your property on a set schedule via our all-electric
            fleet. Your trap keeps running and your property stays protected.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <Reviews />

  <!-- CLOSING CTA -->
  <section class="bg-gradient-to-br from-bg-dark via-bg to-bg-card py-16 px-5 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl md:text-4xl font-black text-white mb-4">Ready to reclaim your backyard?</h2>
      <p class="text-cream/75 mb-7">
        Free property assessment. No pressure, no contracts. We'll show you what's possible.
      </p>
      <a href="/book" class="btn-gold">Book Your Free Assessment</a>
      <div class="text-cream/45 text-xs mt-4">or text/call 512-560-4129</div>
    </div>
  </section>
</Base>
