---
import Base from '../layouts/Base.astro';
import Reviews from '../components/Reviews.astro';
---

<style>
  .ix-hero {
    position: relative;
    overflow: hidden;
  }
  .ix-hero::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 700px; height: 700px;
    border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.07);
    pointer-events: none;
  }
  .ix-hero::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 1000px; height: 1000px;
    border-radius: 50%;
    border: 1px solid rgba(122,171,130,0.04);
    pointer-events: none;
  }
  .ix-hero-content {
    position: relative;
    z-index: 2;
  }
  .ix-cta {
    position: relative;
    overflow: hidden;
  }
  .ix-cta::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 600px; height: 600px;
    border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.07);
    pointer-events: none;
  }
  .ix-cta-content {
    position: relative;
    z-index: 2;
  }
</style>

<Base title="Eco-Friendly Mosquito Control Austin TX | GreenGuard USA">
  <!-- HERO -->
  <section class="ix-hero" style="background: linear-gradient(135deg, #0d1a10 0%, #1a2e1f 45%, #2d4a32 100%); padding: 80px 48px 90px; border-bottom: 1px solid rgba(122,171,130,0.2);">
    <div class="max-w-container mx-auto ix-hero-content">
      <div class="flex justify-between items-center gap-12 flex-col md:flex-row">
        <!-- Left column -->
        <div style="max-width: 560px;">
          <!-- Animated badge -->
          <div class="flex items-center gap-2 mb-6" style="display: inline-flex; align-items: center; gap: 10px; background: rgba(45,74,50,0.8); border: 1px solid rgba(122,171,130,0.3); border-radius: 20px; padding: 7px 16px;">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background: #7dffaa;"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background: #4ade80;"></span>
            </span>
            <span style="font-size: 0.8rem; font-weight: 700; color: #a8edc0; letter-spacing: 0.04em;">Now Serving Austin, TX</span>
          </div>

          <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 900; color: #fff; line-height: 1.1; margin: 20px 0 24px; letter-spacing: -0.02em;">
            Reclaim Your Sanctuary.<span style="display: block; color: #7dffaa;">Start Trapping Mosquitoes.</span>
          </h1>

          <p style="font-size: 1.1rem; line-height: 1.75; color: rgba(212,230,202,0.85); margin-bottom: 36px; max-width: 480px;">
            Precision CO₂ trap technology. Scientifically validated. Pesticide-free. Delivered to your home by our all-electric fleet. Protect your family with a smarter approach to mosquito control.
          </p>

          <div class="flex gap-3 flex-wrap">
            <a href="/book" class="btn-gold">Book Free Assessment</a>
            <a href="https://portal.greenguard-usa.com/quote/new" class="btn-outline">Quote Builder</a>
          </div>
        </div>

        <!-- Right column: hero image -->
        <div class="flex-shrink-0 w-full md:w-auto" style="max-width: 420px; margin: 0 auto;">
          <img
            src="/images/mosqitterGrand1.webp"
            alt="Mosqitter Grand CO₂ mosquito trap, GreenGuard USA Austin Texas"
            style="width: 100%; height: auto; object-fit: contain; border-radius: 12px; border: 1px solid rgba(122,171,130,0.15); display: block; box-shadow: 0 24px 64px rgba(0,0,0,0.45);"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div style="background: #2d4a32; border-bottom: 1px solid rgba(122,171,130,0.2); padding: 16px 48px; display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap;">
    <div class="flex items-center gap-2" style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #a8edc0;">
      <span style="color: #c9a84c; font-weight: 900;">✓</span> 100% Pesticide-Free
    </div>
    <div class="flex items-center gap-2" style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #a8edc0;">
      <span style="color: #c9a84c; font-weight: 900;">✓</span> Safe for Kids &amp; Pets
    </div>
    <div class="flex items-center gap-2" style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #a8edc0;">
      <span style="color: #c9a84c; font-weight: 900;">✓</span> Bee Safe
    </div>
    <div class="flex items-center gap-2" style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #a8edc0;">
      <span style="color: #c9a84c; font-weight: 900;">✓</span> Next-Day CO₂ Delivery
    </div>
    <div class="flex items-center gap-2" style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #a8edc0;">
      <span style="color: #c9a84c; font-weight: 900;">✓</span> Free Assessment
    </div>
  </div>

  <!-- THE SCIENCE -->
  <section class="py-16 px-5">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">The Science</div>
        <h2 class="text-3xl md:text-4xl font-black text-white mb-3 leading-tight">
          How CO₂ trapping works
        </h2>
        <p class="text-cream/70 max-w-2xl mx-auto">
          Mosquitoes find you by tracking the CO₂ you exhale. We use that against them silently,
          continuously, without a single pesticide.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="card">
          <div class="text-white font-bold mb-2">CO₂ Mimics Human Breath</div>
          <p class="text-cream/65 text-sm leading-relaxed">
            Our CO₂ traps emit a precise stream of carbon dioxide along with a customized scent bait,
            attracting mosquitoes using the exact signals humans naturally produce.
          </p>
        </div>
        <div class="card">
          <div class="text-white font-bold mb-2">Mosquitoes Enter the Trap</div>
          <p class="text-cream/65 text-sm leading-relaxed">
            Lured in, mosquitoes are sucked in by a fan and captured in a net. No zapping, no pesticides,
            no residue, just quiet, targeted control at the source.
          </p>
        </div>
        <div class="card">
          <div class="text-white font-bold mb-2">We Refill. You Relax.</div>
          <p class="text-cream/65 text-sm leading-relaxed">
            We deliver and install full CO₂ tanks to your property on a set schedule via our all-electric
            fleet. Your trap keeps running and your property stays protected.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY GREENGUARD USA -->
  <section class="py-16 px-5 bg-bg-panel">
    <div class="max-w-container mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="eyebrow mb-2">Why GreenGuard USA</div>
        <h2 class="text-3xl md:text-4xl font-black text-white mb-3 leading-tight">
          Advanced mosquito control starts with <span class="text-accent">smarter protection.</span>
        </h2>
        <p class="text-cream/70 mb-8">
          Traditional mosquito sprays coat your property in pesticides. We chose a smarter, safer approach.
        </p>
        <div class="space-y-5">
          <div>
            <div class="text-white font-bold mb-1">Zero Pesticide Residue</div>
            <p class="text-cream/65 text-sm leading-relaxed">No spray drift, no groundwater contamination, no toxic residue where your kids and pets play.</p>
          </div>
          <div>
            <div class="text-white font-bold mb-1">Bees Stay Safe</div>
            <p class="text-cream/65 text-sm leading-relaxed">CO₂ traps target only blood-seeking insects. Bees and your garden ecosystem are completely untouched.</p>
          </div>
          <div>
            <div class="text-white font-bold mb-1">All-Electric Delivery Fleet</div>
            <p class="text-cream/65 text-sm leading-relaxed">We deliver your CO₂ in fully electric Chevy Silverado EV trucks. Zero emissions from our fleet to your door.</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="card col-span-2 text-center">
          <span class="block text-4xl font-black text-accent mb-1">93%</span>
          <span class="text-cream/65 text-sm">Proven bite reduction after 6 months of CO₂ trapping</span>
        </div>
        <div class="card text-center">
          <span class="block text-4xl font-black text-white mb-1">0</span>
          <span class="text-cream/65 text-sm">Pesticides in every service visit</span>
        </div>
        <div class="card text-center">
          <span class="block text-4xl font-black text-white mb-1">100%</span>
          <span class="text-cream/65 text-sm">Bee safe</span>
        </div>
        <div class="card text-center">
          <span class="block text-4xl font-black text-white mb-1">EV</span>
          <span class="text-cream/65 text-sm">Zero-emission delivery fleet</span>
        </div>
        <div class="card text-center">
          <span class="block text-4xl font-black text-white mb-1">Local</span>
          <span class="text-cream/65 text-sm">Austin based company</span>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <Reviews bg="bg-bg" />

  <!-- PROOF OF RESULTS -->
  <section class="py-16 px-5">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">Real Results</div>
        <h2 class="text-2xl md:text-3xl font-black text-white mb-3">This is what one Austin trap catches in a week.</h2>
        <p class="text-cream/65 text-base max-w-xl mx-auto">Every mosquito in that pile is one that never bit your family. No pesticides. No sprays. Just a CO₂ trap doing its job.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-3xl mx-auto">
        <div class="rounded-xl overflow-hidden border border-accent/20">
          <img
            src="/images/results-mosquito-haul.jpg"
            alt="Thousands of dead mosquitoes caught by a single GreenGuard CO2 trap in one week in Austin TX"
            class="w-full h-72 object-cover"
            loading="lazy"
          />
        </div>
        <div class="rounded-xl overflow-hidden border border-accent/20">
          <img
            src="/images/results-mosquito-haul-2.jpg"
            alt="Hand next to pile of mosquitoes caught by GreenGuard CO2 trap — Austin Texas mosquito control"
            class="w-full h-72 object-cover"
            loading="lazy"
          />
        </div>
      </div>
      <p class="text-center text-cream/45 text-xs mt-5">Actual catch from a customer property in Austin, TX. Results vary by property size and mosquito pressure.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-5">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">Common Questions</div>
        <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Frequently asked questions</h2>
      </div>
      <div class="space-y-4" id="faq-list">
        {[
          { q: "How is CO₂ trapping different from mosquito sprays?", a: "Sprays coat your yard in pesticides that kill indiscriminately, including bees and beneficial insects. CO₂ traps use the same signal mosquitoes use to find you, drawing them in and capturing them without any chemicals. No spray drift, no residue, no bee deaths." },
          { q: "How quickly will I see results?", a: "Most customers notice a significant reduction in mosquito activity within 2 to 4 weeks. Studies show up to 93% bite reduction after 6 months of continuous trapping as the local breeding population collapses." },
          { q: "What does the service include?", a: "We handle everything: trap installation, monthly CO₂ tank exchanges, maintenance, and seasonal adjustments. You don't touch the equipment. We show up, swap tanks, and leave your yard protected." },
          { q: "Do I have to sign a long-term contract?", a: "No contracts. Service runs month to month. Most customers stay because it works, not because they're locked in." },
          { q: "Is it safe for kids, pets, and bees?", a: "Yes. CO₂ traps target only blood-seeking insects following carbon dioxide. Bees don't follow CO₂ cues, so they're completely unaffected. No pesticides means no risk to kids, pets, or your garden." },
        ].map(({ q, a }) => (
          <details class="card" style="cursor: pointer;">
            <summary style="font-weight: 800; color: #fff; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
              {q}
              <span style="color: #c9a84c; font-size: 1.2rem; flex-shrink: 0;">+</span>
            </summary>
            <p style="margin-top: 12px; font-size: 0.88rem; color: rgba(212,230,202,0.7); line-height: 1.7;">{a}</p>
          </details>
        ))}
      </div>
      <p class="text-center text-cream/45 text-sm mt-8">
        More questions? <a href="/faq" class="text-accent underline hover:text-accent/80">See all FAQs</a> or <a href="/compare" class="text-accent underline hover:text-accent/80">compare all options</a>.
      </p>
    </div>
  </section>

  <!-- EMAIL CAPTURE -->
  <section class="py-14 px-5 bg-bg-panel">
    <div class="max-w-xl mx-auto text-center">
      <div class="eyebrow mb-3">Stay in the Loop</div>
      <h2 class="text-xl md:text-2xl font-black text-white mb-2">Get seasonal tips and service updates</h2>
      <p class="text-cream/60 text-sm mb-6">No spam. Just useful info about protecting your Austin property from mosquitoes.</p>
      <form id="email-capture-form" class="flex gap-3 flex-wrap justify-center max-w-md mx-auto">
        <input
          type="email"
          id="email-capture-input"
          placeholder="your@email.com"
          required
          style="flex: 1 1 200px; padding: 11px 14px; border-radius: 6px; border: 1px solid rgba(122,171,130,0.3); background: rgba(255,255,255,0.05); color: #d4e6ca; font-size: 0.95rem; outline: none; font-family: inherit; min-width: 0;"
        />
        <button type="submit" class="btn-gold" style="white-space: nowrap; padding: 11px 24px;">Subscribe</button>
      </form>
      <p id="email-capture-msg" style="font-size: 0.82rem; margin-top: 10px; min-height: 1.2em; color: #7dffaa; display: none;"></p>
    </div>
  </section>
  <script>
    const form = document.getElementById('email-capture-form') as HTMLFormElement | null;
    const msg = document.getElementById('email-capture-msg') as HTMLElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email-capture-input') as HTMLInputElement)?.value?.trim();
      if (!email) return;
      try {
        await fetch('https://portal.greenguard-usa.com/api/leads/subscribe', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'homepage_footer' }),
        });
        if (msg) { msg.textContent = 'You\'re in. Talk soon.'; msg.style.display = 'block'; }
        form.reset();
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'lead_capture', { event_category: 'email', event_label: 'homepage_footer' });
        }
      } catch {
        if (msg) { msg.textContent = 'Something went wrong. Try again.'; msg.style.color = '#ff8080'; msg.style.display = 'block'; }
      }
    });
  </script>

  <!-- SERVICE AREAS -->
  <section class="py-16 px-5">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">Service Areas</div>
        <h2 class="text-2xl md:text-3xl font-black text-white mb-3">
          Mosquito control across greater Austin, TX
        </h2>
        <p class="text-cream/65 max-w-xl mx-auto text-sm">
          We serve Austin and 13 surrounding communities with the same pesticide-free CO₂ trap service and all-electric fleet.
        </p>
      </div>

      <div class="max-w-3xl mx-auto mb-8">
        <a href="/mosquito-control-austin-texas" class="card flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between hover:border-accent/40 transition-colors" style="text-decoration: none;">
          <div>
            <div class="eyebrow mb-1 text-xs">Complete Guide</div>
            <div class="text-white font-bold">Mosquito Control in Austin, TX</div>
            <p class="text-cream/60 text-sm mt-1">Species, season length, treatment options, and costs — everything Austin homeowners need to know.</p>
          </div>
          <span class="text-accent text-2xl flex-shrink-0">→</span>
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-3xl mx-auto">
        {[
          { city: 'Austin', slug: 'austin' },
          { city: 'Cedar Park', slug: 'cedar-park' },
          { city: 'Round Rock', slug: 'round-rock' },
          { city: 'Westlake Hills', slug: 'westlake-hills' },
          { city: 'Lakeway', slug: 'lakeway' },
          { city: 'Bee Cave', slug: 'bee-cave' },
          { city: 'Dripping Springs', slug: 'dripping-springs' },
          { city: 'Steiner Ranch', slug: 'steiner-ranch' },
          { city: 'Georgetown', slug: 'georgetown' },
          { city: 'Pflugerville', slug: 'pflugerville' },
          { city: 'Leander', slug: 'leander' },
          { city: 'Liberty Hill', slug: 'liberty-hill' },
          { city: 'Kyle', slug: 'kyle' },
          { city: 'Buda', slug: 'buda' },
        ].map(({ city, slug }) => (
          <a href={`/mosquito-control-${slug}`} class="card text-center hover:border-accent/40 transition-colors py-2" style="text-decoration: none;">
            <span class="text-cream/80 text-sm font-semibold">{city}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="ix-cta bg-gradient-to-br from-bg-dark via-bg to-bg-card py-16 px-5 text-center">
    <div class="max-w-2xl mx-auto ix-cta-content">
      <h2 class="text-2xl md:text-4xl font-black text-white mb-4">Ready to reclaim your backyard?</h2>
      <p class="text-cream/75 mb-7">
        Free property assessment. No pressure, no contracts. We'll show you what's possible.
      </p>
      <a href="/book" class="btn-gold">Book Free Assessment</a>
      <div class="text-cream/45 text-xs mt-4">or text/call 512-560-4129</div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How is CO₂ trapping different from mosquito sprays?", "acceptedAnswer": { "@type": "Answer", "text": "Sprays coat your yard in pesticides that kill indiscriminately, including bees and beneficial insects. CO₂ traps use the same signal mosquitoes use to find you, drawing them in and capturing them without any chemicals. No spray drift, no residue, no bee deaths." } },
      { "@type": "Question", "name": "How quickly will I see results?", "acceptedAnswer": { "@type": "Answer", "text": "Most customers notice a significant reduction in mosquito activity within 2 to 4 weeks. Studies show up to 93% bite reduction after 6 months of continuous trapping as the local breeding population collapses." } },
      { "@type": "Question", "name": "What does the service include?", "acceptedAnswer": { "@type": "Answer", "text": "We handle everything: trap installation, monthly CO₂ tank exchanges, maintenance, and seasonal adjustments. You don't touch the equipment. We show up, swap tanks, and leave your yard protected." } },
      { "@type": "Question", "name": "Do I have to sign a long-term contract?", "acceptedAnswer": { "@type": "Answer", "text": "No contracts. Service runs month to month. Most customers stay because it works, not because they're locked in." } },
      { "@type": "Question", "name": "Is it safe for kids, pets, and bees?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. CO₂ traps target only blood-seeking insects following carbon dioxide. Bees don't follow CO₂ cues, so they're completely unaffected. No pesticides means no risk to kids, pets, or your garden." } },
    ]
  })} />
</Base>
