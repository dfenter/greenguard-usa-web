---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categories = ['Environment', 'Health and Family', 'Local Guide', 'Mosquito Science', 'Outdoor Living'] as const;
---

<Base
  title="Mosquito Control Blog | GreenGuard USA"
  description="Practical guidance on mosquito control, outdoor living, and protecting your home environment. Written for Austin homeowners."
>
  <!-- HERO -->
  <section class="bg-gradient-to-br from-bg-card via-bg to-accent-deep/40 py-16 px-5 text-center">
    <div class="max-w-3xl mx-auto">
      <div class="eyebrow mb-2">GreenGuard USA</div>
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4 leading-tight">
        Outdoor Living. Mosquito Science. <span class="text-accent">Austin Life.</span>
      </h1>
      <p class="text-cream/80 text-base md:text-lg leading-relaxed">
        Practical guidance on mosquito control, outdoor living, and protecting your home environment.
        Written for Austin homeowners who take these things seriously.
      </p>
    </div>
  </section>

  <!-- POSTS -->
  <section class="py-16 px-5">
    <div class="max-w-container mx-auto">
      {allPosts.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-cream/50 text-lg">Articles coming soon.</p>
          <p class="text-cream/35 text-sm mt-2">Check back shortly or subscribe for updates.</p>
          <a href="/contact" class="btn-outline mt-6 inline-block">Get Notified</a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allPosts.map((post) => (
            <article class="card flex flex-col">
              <div class="eyebrow mb-2 text-xs">{post.data.category}</div>
              <h2 class="text-white font-bold text-base leading-snug mb-3 flex-1">
                <a href={`/blog/${post.slug}`} class="hover:text-accent transition-colors">
                  {post.data.title}
                </a>
              </h2>
              <p class="text-cream/65 text-sm leading-relaxed mb-4">{post.data.description}</p>
              <div class="border-t border-accent/15 pt-3 flex justify-between items-center">
                <span class="text-cream/40 text-xs">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </span>
                <a href={`/blog/${post.slug}`} class="text-accent text-xs font-bold hover:underline">
                  Read article
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-5 bg-bg-panel text-center">
    <div class="max-w-xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Ready to protect your yard?</h2>
      <p class="text-cream/75 mb-6">Free property assessment. No pressure, no obligation.</p>
      <a href="/book" class="btn-gold">Book Free Assessment</a>
    </div>
  </section>
</Base>
