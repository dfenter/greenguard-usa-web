---
import Base from '../layouts/Base.astro';
---

<Base
  title="Mosquito Control Services Austin TX | GreenGuard USA"
  description="Outdoor Protection Program: mosquito trap rental and CO₂ delivery for Austin homeowners. Flat monthly pricing, no sprays, no contracts."
>
  <!-- HERO -->
  <section class="bg-gradient-to-br from-bg-card via-bg to-accent-deep/40 py-16 px-5 text-center">
    <div class="max-w-3xl mx-auto">
      <div class="eyebrow mb-2">Services</div>
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4 leading-tight">
        Pesticide-free protection.<br />
        <span class="text-accent">Monthly. Simple. Effective.</span>
      </h1>
      <p class="text-cream/80 text-base md:text-lg leading-relaxed mb-6">
        Pick a trap, pick a frequency. We handle CO₂ refills, maintenance, and seasonal tuning.
        You enjoy the backyard.
      </p>
      <a href="/book" class="btn-gold">Book Free Assessment</a>
    </div>
  </section>

  <!-- TWO TRAP OPTIONS -->
  <section class="py-16 px-5">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">Two traps. Both pesticide-free.</div>
        <h2 class="text-2xl md:text-3xl font-black text-white">Which one fits your property?</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card">
          <div class="eyebrow mb-2">Biogents Mosquitaire</div>
          <h3 class="text-xl font-black text-white mb-3">Best for most yards</h3>
          <p class="text-cream/75 mb-4 text-sm leading-relaxed">
            Covers up to ¼ acre per trap. Quiet, discreet, and effective for standard suburban properties.
            Most customers start with one or two.
          </p>
          <ul class="space-y-2 text-sm text-cream/75 mb-5">
            <li>✓ Covers up to ¼ acre per trap</li>
            <li>✓ Runs 24/7 for best long-term results</li>
            <li>✓ Powered by standard outdoor outlet</li>
          </ul>
          <a href="/traprental" class="btn-outline">Trap Rental Details</a>
        </div>

        <div class="card border-gold/30">
          <div class="eyebrow mb-2 text-gold">Mosqitter Grand</div>
          <h3 class="text-xl font-black text-white mb-3">Best for larger properties</h3>
          <p class="text-cream/75 mb-4 text-sm leading-relaxed">
            Covers up to 1 acre per trap. Heavy-duty, ideal for waterfront homes, large lots,
            and commercial properties.
          </p>
          <ul class="space-y-2 text-sm text-cream/75 mb-5">
            <li>✓ Covers up to 1 acre per trap</li>
            <li>✓ Solar-friendly option available</li>
            <li>✓ Built for heavy mosquito pressure</li>
          </ul>
          <a href="/traprental" class="btn-outline">Trap Rental Details</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WE HANDLE IT -->
  <section class="py-16 px-5 bg-bg-panel">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">Done For You</div>
        <h2 class="text-2xl md:text-3xl font-black text-white">We handle the hard part</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="card">
          <div class="text-white font-bold mb-2">CO₂ delivery</div>
          <p class="text-cream/70 text-sm mb-3">Monthly tank exchanges, on-time, no scheduling required.</p>
          <a href="/co2delivery" class="text-accent text-xs underline">Delivery details</a>
        </div>
        <div class="card">
          <div class="text-white font-bold mb-2">Trap maintenance</div>
          <p class="text-cream/70 text-sm">Net cleaning, lure replacement, and seasonal placement adjustments.</p>
        </div>
        <div class="card">
          <div class="text-white font-bold mb-2">Seasonal tuning</div>
          <p class="text-cream/70 text-sm">Spring ramp-up, peak summer, fall taper. We adjust as conditions change.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-5 text-center">
    <h2 class="text-2xl md:text-3xl font-black text-white mb-4">Simple monthly pricing</h2>
    <p class="text-cream/75 mb-6">Plans start at $89.99/month. No contracts.</p>
    <a href="/pricing" class="btn-gold">See Pricing</a>
  </section>
</Base>
