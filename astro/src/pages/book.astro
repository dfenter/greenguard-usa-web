---
import Base from '../layouts/Base.astro';

// Cal.com inline embed: the public booking page is at /greenguard-usa
const CAL_USERNAME = 'greenguard-usa';
const CAL_EVENT = 'property-assessment';
---

<Base
  title="Book Your Free Mosquito Assessment | GreenGuard USA"
  description="Schedule a free in-person property assessment with GreenGuard USA. No pressure, no obligation."
>
  <!-- HERO -->
  <section class="bg-gradient-to-br from-bg-card via-bg to-accent-deep/40 py-16 px-5 text-center">
    <div class="max-w-2xl mx-auto">
      <div class="eyebrow mb-2">Free Assessment</div>
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4 leading-tight">
        Book your <span class="text-accent">free assessment</span>
      </h1>
      <p class="text-cream/80 text-base md:text-lg">
        We come out, walk your property, and show you exactly where traps would go and what to expect.
        No pressure, no obligation.
      </p>
    </div>
  </section>

  <!-- SERVICE-AREA CHECK (advisory — calendar always unlocked) -->
  <section class="py-8 px-5">
    <div class="max-w-md mx-auto text-center">
      <p class="text-cream/60 text-sm font-bold uppercase tracking-widest mb-3">Your location</p>
      <p class="text-cream/70 text-sm mb-4">Enter your ZIP code or city so we can confirm service availability before your visit.</p>
      <div class="flex gap-2">
        <input id="zip-input" type="text" maxlength="40" placeholder="ZIP code or city"
          class="flex-1 bg-bg-card border border-accent/20 text-cream rounded-lg px-4 py-3 text-center text-base font-bold tracking-widest outline-none focus:border-gold/60" />
        <button id="zip-btn" class="btn-gold whitespace-nowrap">Check</button>
      </div>
      <div id="zip-result" class="mt-3 text-sm font-bold min-h-[20px]"></div>
    </div>
  </section>

  <!-- BOOKING EMBED (always visible) -->
  <section class="py-12 px-5">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-white text-center mb-6">Pick a time that works for you</h2>
      <div class="card !p-2 min-h-[640px]">
        <!-- Cal.com inline embed via official SDK. The SDK establishes the
             postMessage handshake a bare <iframe> does not, so the
             bookingSuccessful event reliably fires for Lead tracking. -->
        <div id="cal-inline" data-cal-link={`${CAL_USERNAME}/${CAL_EVENT}`} style="width:100%;height:640px;overflow:auto;"></div>
      </div>

      <div class="text-center text-cream/50 text-xs mt-4">
        Prefer to talk first? <a href="tel:5125604129" class="text-accent underline">Call 512-560-4129</a>
        &nbsp;·&nbsp;
        <a href="mailto:admin@greenguard-usa.com" class="text-accent underline">admin@greenguard-usa.com</a>
      </div>
    </div>
  </section>

  <script>
    let calMounted = false;

    function checkZip() {
      const input = (document.getElementById('zip-input') as HTMLInputElement);
      const val = input?.value?.trim();
      const result = document.getElementById('zip-result')!;
      if (!val) {
        result.style.color = '#ffb060'; result.textContent = 'Please enter your ZIP code or city.'; return;
      }
      result.style.color = '#7dffaa';
      result.textContent = `✓ Got it — we'll confirm service availability before your appointment.`;
      if (window.gtag) (window as any).gtag('event', 'zip_check', { location: val });
    }
    document.getElementById('zip-btn')?.addEventListener('click', checkZip);
    (document.getElementById('zip-input') as HTMLInputElement)?.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') checkZip(); });

    // Load the Cal.com embed SDK once.
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if (typeof namespace === "string") { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ["initNamespace", namespace]); } else p(cal, ar); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");

    // Mount the inline calendar — only after the gate passes (lazy, once).
    function mountCal() {
      if (calMounted) return;
      calMounted = true;
      const Cal = (window as any).Cal;
      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', {
        elementOrSelector: '#cal-inline',
        calLink: 'greenguard-usa/property-assessment',
        layout: 'month_view',
        config: { theme: 'dark' },
      });
      Cal('on', { action: 'bookingSuccessful', callback: (e: any) => { fireBookingLead(e?.detail); } });
    }

    async function fireBookingLead(detail: any) {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', { event_category: 'booking', event_label: 'property_assessment' });
        window.gtag('event', 'qualify_lead', { event_category: 'booking', event_label: 'property_assessment' });
      }
      // Dig the attendee email out of whatever shape the payload arrives in.
      const data = detail?.data || detail || {};
      const bookerEmail =
        data?.booking?.attendees?.[0]?.email ||
        data?.attendees?.[0]?.email ||
        data?.responses?.email?.value ||
        data?.attendee?.email ||
        data?.email ||
        null;
      // Shared event_id so the client pixel Lead and the server CAPI Lead
      // (lib fires the same scheme) dedupe instead of double-counting.
      let leadEventId: string | undefined;
      if (bookerEmail) {
        try {
          const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(bookerEmail.trim().toLowerCase()));
          const hex = Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
          leadEventId = `lead_${hex.slice(0, 16)}_${new Date().toISOString().slice(0, 10)}`;
        } catch {}
      }
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Lead', { content_name: 'Property Assessment Booking', value: 25, currency: 'USD' }, leadEventId ? { eventID: leadEventId } : undefined);
      }
      if (bookerEmail) {
        const payload: Record<string, string> = { email: bookerEmail, source: 'booking' };
        ['gclid','fbclid','utm_source','utm_medium','utm_campaign','utm_content','ref'].forEach(k => {
          const v = sessionStorage.getItem('gg_' + k);
          if (v) payload[k === 'ref' ? 'referredBy' : k] = v;
        });
        await fetch('/api/lead-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).catch(() => {});
      }
    }

    // Belt-and-suspenders: keep the raw postMessage listener too, in case the
    // SDK callback shape changes. Dedup is handled by the shared event_id.
    window.addEventListener('message', (e) => {
      if (e.data?.type === 'bookingSuccessful' || e.data?.action === 'bookingSuccessful') {
        fireBookingLead(e.data?.data || e.data);
      }
    });
  </script>

  <!-- WHAT TO EXPECT -->
  <section class="py-16 px-5 bg-bg-panel">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">What to Expect</div>
        <h2 class="text-2xl md:text-3xl font-black text-white">Simple process. No surprises.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="card">
          <div class="text-gold font-extrabold text-sm mb-2">Step 1 · Visit</div>
          <div class="text-white font-bold mb-2">~30 minute walkthrough</div>
          <p class="text-cream/65 text-sm">We look at vegetation, water sources, and how you use the yard. Identify the right trap spots.</p>
        </div>
        <div class="card">
          <div class="text-gold font-extrabold text-sm mb-2">Step 2 · Recommendation</div>
          <div class="text-white font-bold mb-2">Honest assessment</div>
          <p class="text-cream/65 text-sm">We'll tell you if CO₂ trapping is right for your property, or honestly say it's not the best fit.</p>
        </div>
        <div class="card">
          <div class="text-gold font-extrabold text-sm mb-2">Step 3 · No Pressure</div>
          <div class="text-white font-bold mb-2">Decide on your own time</div>
          <p class="text-cream/65 text-sm">Take a day, a week, or pass entirely. No follow-up sales calls.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
