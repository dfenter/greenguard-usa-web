      {
        q: 'Why is it sold empty?',
        a: 'US carrier regulations prohibit shipping pressurized CO₂ cylinders. Sold empty is standard for all CO₂ cylinder purchases. Your local fill station can have it ready in under 10 minutes.'
      },
    ],
    crossSells: [
      { id: 'biogents-co2-timer', name: 'Biogents CO₂ Tank Timer', price: 89.99, image: '/images/prod-co2-timer.png', tagline: 'Triple your tank runtime' },
      { id: 'biogents-co2-trap', name: 'Biogents BG-Mosquitaire CO₂ Trap', price: 279.99, image: '/images/prod-biogents-co2.jpg', tagline: 'The trap this tank is built for' },
    ],
    rating: 4.8,
    reviewCount: 11,
  },
  ];
  return products.map(p => ({ params: { product: p.id }, props: { product: p } }));
}

const { product: p } = Astro.props;

function stars(rating: number) {
  return '★'.repeat(Math.floor(rating)) + (rating % 1 >= 0.5 ? '½' : '') ;
}

function badgeCss(style: string) {
  if (style === 'gold') return 'background:rgba(201,168,76,0.15);color:#c9a84c;border:1px solid rgba(201,168,76,0.3);';
  if (style === 'accent') return 'background:rgba(122,171,130,0.1);color:#7aab82;border:1px solid rgba(122,171,130,0.25);';
  return 'background:rgba(212,230,202,0.06);color:rgba(212,230,202,0.5);border:1px solid rgba(212,230,202,0.12);';
}

const savings = p.originalPrice ? (p.originalPrice - p.price) : 0;

// JSON-LD for this product
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.shortDesc,
  image: `https://www.greenguard-usa.com${p.image}`,
  brand: { '@type': 'Brand', name: 'GreenGuard USA' },
  mpn: p.id.toUpperCase(),
  offers: {
    '@type': 'Offer',
    url: `https://www.greenguard-usa.com/shop/${p.id}`,
    priceCurrency: 'USD',
    price: p.price.toFixed(2),
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: { '@type': 'Organization', name: 'GreenGuard USA' },
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: p.rating,
    reviewCount: p.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
};
---

<Base
  title={`${p.name} | GreenGuard USA Shop`}
  description={p.shortDesc}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <!-- BREADCRUMB + BACK -->
  <div class="px-5 py-4" style="background: #070e08; border-bottom: 1px solid rgba(122,171,130,0.08);">
    <div class="max-w-container mx-auto flex items-center gap-2 text-xs text-cream/35 font-semibold">
      <a href="/shop" class="hover:text-cream/70 transition-colors">Shop</a>
      <span>/</span>
      <span class="text-cream/60">{p.name}</span>
    </div>
  </div>

  <!-- MAIN PRODUCT SECTION -->
  <section class="py-10 px-5" style="background: #070e08;">
    <div class="max-w-container mx-auto">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- LEFT: IMAGE GALLERY -->
        <div class="lg:sticky lg:top-6">
          <div class="relative rounded-2xl overflow-hidden" style="background: #0a1208; border: 1px solid rgba(122,171,130,0.12); aspect-ratio: 1;">
            <img
              id="main-product-img"
              src={p.image}
              alt={p.name}
              class="w-full h-full object-contain p-6"
              loading="eager"
            />
            {p.badge && (
              <div class="absolute top-4 left-4">
                <span class="text-xs font-black tracking-widest uppercase px-3 py-1.5 rounded-full" style={badgeCss(p.badgeStyle)}>{p.badge}</span>
              </div>
            )}
          </div>
          {p.altImage && (
            <div class="flex gap-3 mt-3">
              <button
                class="img-thumb flex-1 rounded-xl overflow-hidden transition-all"
                style="border: 2px solid rgba(201,168,76,0.5); background: #0a1208; aspect-ratio: 1;"
                data-src={p.image}
              >
                <img src={p.image} alt="View 1" class="w-full h-full object-contain p-2" loading="lazy" />
              </button>
              <button
                class="img-thumb flex-1 rounded-xl overflow-hidden transition-all"
                style="border: 1px solid rgba(122,171,130,0.15); background: #0a1208; aspect-ratio: 1;"
                data-src={p.altImage}
              >
                <img src={p.altImage} alt="View 2" class="w-full h-full object-contain p-2" loading="lazy" />
              </button>
            </div>
          )}
          <!-- Main stat callout -->
          {p.mainStat && (
            <div class="mt-4 rounded-xl p-5 text-center" style="background: rgba(122,171,130,0.05); border: 1px solid rgba(122,171,130,0.12);">
              <div class="text-5xl font-black text-white">{p.mainStat}</div>
              <div class="text-cream/50 text-sm mt-1 font-semibold">{p.mainStatLabel}</div>
            </div>
          )}
        </div>

        <!-- RIGHT: PRODUCT INFO -->
        <div>
          <!-- Category + species -->
          <div class="flex flex-wrap gap-2 mb-4">
            {p.targetSpecies && (
              <span class="text-xs font-bold px-2.5 py-1 rounded-full" style="background: rgba(122,171,130,0.08); border: 1px solid rgba(122,171,130,0.18); color: rgba(122,171,130,0.8);">
                {p.targetSpecies}
              </span>
            )}
            {p.coverageStat && (
              <span class="text-xs font-bold px-2.5 py-1 rounded-full" style="background: rgba(201,168,76,0.08); border: 1px solid rgba(201,168,76,0.18); color: rgba(201,168,76,0.8);">
                {p.coverageStat}
              </span>
            )}
          </div>

          <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight leading-tight mb-3">{p.name}</h1>

          <!-- Rating -->
          <div class="flex items-center gap-2 mb-5">
            <span class="text-gold text-sm tracking-tight">{stars(p.rating)}</span>
            <span class="text-gold font-black text-sm">{p.rating}</span>
            <span class="text-cream/35 text-sm">({p.reviewCount} verified reviews)</span>
          </div>

          <!-- Price -->
          <div class="flex items-baseline gap-3 mb-4">
            <span class="text-4xl font-black text-white">${p.price.toFixed(2)}</span>
            {p.originalPrice && (
              <span class="text-cream/35 text-xl line-through">${p.originalPrice.toFixed(2)}</span>
            )}
            {savings > 0 && (
              <span class="text-xs font-black px-2.5 py-1 rounded-full" style="background: rgba(122,171,130,0.1); border: 1px solid rgba(122,171,130,0.2); color: #7aab82;">
                Save ${savings.toFixed(2)}
              </span>
            )}
          </div>

          <!-- Short description -->
          <p class="text-cream/70 leading-relaxed mb-6">{p.shortDesc}</p>

          <!-- Key benefit pills -->
          <div class="flex flex-wrap gap-2 mb-8">
            {p.keyBenefits.map(b => (
              <span class="flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-full" style="background: rgba(122,171,130,0.06); border: 1px solid rgba(122,171,130,0.15); color: rgba(212,230,202,0.7);">
                <span class="text-accent">✓</span>{b}
              </span>
            ))}
          </div>

          <!-- ADD TO CART -->
          <div class="mb-6">
            <button
              id="main-add-to-cart"
              data-id={p.id}
              data-name={p.name}
              data-price={p.price}
              class="w-full py-5 rounded-xl font-black text-base tracking-widest uppercase transition-all hover:scale-[1.01] active:scale-[0.99]"
              style="background: linear-gradient(135deg, #d4b45a 0%, #c9a84c 50%, #b8952a 100%); color: #070e08; box-shadow: 0 8px 32px rgba(201,168,76,0.3); letter-spacing: 0.1em;"
            >
              Add to Cart — ${p.price.toFixed(2)}
            </button>
          </div>

          <!-- Trust badges -->
          <div class="grid grid-cols-2 gap-2 mb-8">
            {[
              { icon: '🔒', title: 'Secure Checkout', sub: 'SSL · Stripe encrypted' },
              { icon: '✅', title: 'In Stock', sub: 'Ships from Austin TX' },
              { icon: '📋', title: 'Free Assessment', sub: 'Included with every order' },
              { icon: '📞', title: 'Questions?', sub: '512-560-4129' },
            ].map(b => (
              <div class="rounded-lg px-3 py-2.5 flex items-start gap-2.5" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(122,171,130,0.1);">
                <span class="text-base flex-shrink-0 mt-0.5">{b.icon}</span>
                <div>
                  <div class="text-white text-xs font-bold">{b.title}</div>
                  <div class="text-cream/35 text-xs">{b.sub}</div>
                </div>
              </div>
            ))}
          </div>

          <!-- Not sure link -->
          <p class="text-cream/35 text-xs text-center">
            Not sure this is the right model?{' '}
            <a href="/book" class="text-accent underline hover:text-accent/80 transition-colors">Book a free consultation</a>
            {' '}and we'll recommend the right system for your property.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- STICKY MOBILE CTA BAR (appears when main CTA scrolls out of view) -->
  <div
    id="sticky-cart-bar"
    class="fixed bottom-0 left-0 right-0 z-30 translate-y-full transition-transform duration-300 lg:hidden"
    style="background: #070e08; border-top: 1px solid rgba(201,168,76,0.2); padding: 12px 20px; box-shadow: 0 -8px 32px rgba(0,0,0,0.5);"
  >
    <div class="flex items-center gap-3">
      <div class="flex-1 min-w-0">
        <div class="text-white font-black text-sm leading-none truncate">{p.name}</div>
        <div class="text-gold font-black text-base mt-0.5">${p.price.toFixed(2)}</div>
      </div>
      <button
        id="sticky-add-to-cart"
        data-id={p.id}
        data-name={p.name}
        data-price={p.price}
        class="flex-shrink-0 px-6 py-3.5 rounded-xl font-black text-sm tracking-wider uppercase"
        style="background: linear-gradient(135deg, #d4b45a, #c9a84c); color: #070e08;"
      >
        Add to Cart
      </button>
    </div>
  </div>

  <!-- FEATURES -->
  <section class="py-16 px-5" style="background: #0a1208; border-top: 1px solid rgba(122,171,130,0.08);">
    <div class="max-w-container mx-auto">
      <div class="text-center mb-12">
        <div class="eyebrow mb-2">Product Details</div>
        <h2 class="text-3xl font-black text-white tracking-tight">Why it works</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {p.features.map((f, i) => (
          <div class="rounded-xl p-6" style="background: rgba(122,171,130,0.03); border: 1px solid rgba(122,171,130,0.1);">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5" style="background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.2);">
                <span class="text-gold font-black text-sm">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div>
                <div class="text-white font-black text-base mb-2">{f.title}</div>
                <p class="text-cream/60 text-sm leading-relaxed">{f.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  {p.whatsIncluded && (
    <section class="py-16 px-5" style="background: #0d1a10;">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-10">
          <div class="eyebrow mb-2">In the Box</div>
          <h2 class="text-3xl font-black text-white tracking-tight">What's included</h2>
        </div>
        <div class="rounded-2xl overflow-hidden" style="border: 1px solid rgba(122,171,130,0.12);">
          {p.whatsIncluded.map((item, i) => (
            <div
              class="flex items-start gap-4 px-6 py-4"
              style={`border-bottom: ${i < p.whatsIncluded!.length - 1 ? '1px solid rgba(122,171,130,0.08)' : 'none'}; background: ${item.includes('NOT') ? 'rgba(255,100,100,0.03)' : 'transparent'};`}
            >
              <span class={`font-black text-sm flex-shrink-0 mt-0.5 ${item.includes('NOT') ? 'text-red-400/60' : 'text-accent'}`}>
                {item.includes('NOT') ? '✗' : '✓'}
              </span>
              <span class={`text-sm leading-relaxed ${item.includes('NOT') ? 'text-cream/40 italic' : 'text-cream/75'}`}>{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SPECS -->
  <section class="py-16 px-5" style="background: #070e08;">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">Specifications</div>
        <h2 class="text-3xl font-black text-white tracking-tight">Technical details</h2>
      </div>
      <div class="rounded-2xl overflow-hidden" style="border: 1px solid rgba(122,171,130,0.12);">
        {p.specs.map((s, i) => (
          <div
            class="flex items-start justify-between gap-6 px-6 py-4"
            style={`border-bottom: ${i < p.specs.length - 1 ? '1px solid rgba(122,171,130,0.07)' : 'none'};`}
          >
            <span class="text-cream/45 text-sm font-semibold flex-shrink-0">{s.label}</span>
            <span class="text-white text-sm font-bold text-right">{s.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CROSS-SELLS -->
  {p.crossSells.length > 0 && (
    <section class="py-16 px-5" style="background: #0a1208; border-top: 1px solid rgba(122,171,130,0.08);">
      <div class="max-w-container mx-auto">
        <div class="text-center mb-10">
          <div class="eyebrow mb-2">Complete Your Setup</div>
          <h2 class="text-3xl font-black text-white tracking-tight">Frequently paired with</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-5 max-w-2xl mx-auto">
          {p.crossSells.map(cs => (
            <div class="rounded-2xl overflow-hidden flex flex-col" style="background: #0d1a10; border: 1px solid rgba(122,171,130,0.12);">
              <a href={`/shop/${cs.id}`} class="block overflow-hidden" style="aspect-ratio: 2/1;">
                <img src={cs.image} alt={cs.name} class="w-full h-full object-contain p-4 hover:scale-105 transition-transform duration-300" loading="lazy" />
              </a>
              <div class="p-5 flex flex-col flex-1">
                <div class="text-cream/40 text-xs font-semibold mb-1">{cs.tagline}</div>
                <h3 class="text-white font-black text-base leading-snug mb-3">{cs.name}</h3>
                <div class="text-xl font-black text-white mb-4">${cs.price.toFixed(2)}</div>
                <div class="flex gap-2 mt-auto">
                  <button
                    class="flex-1 py-3 rounded-lg font-black text-xs tracking-widest uppercase transition-all hover:scale-[1.02]"
                    style="background: linear-gradient(135deg, #d4b45a, #c9a84c); color: #070e08;"
                    data-id={cs.id}
                    data-name={cs.name}
                    data-price={cs.price}
                  >
                    Add to Cart
                  </button>
                  <a href={`/shop/${cs.id}`} class="px-4 py-3 rounded-lg font-bold text-xs text-cream/45 hover:text-cream/70 transition-colors" style="border: 1px solid rgba(122,171,130,0.18);">
                    Details
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-16 px-5" style="background: #0d1a10; border-top: 1px solid rgba(122,171,130,0.08);">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <div class="eyebrow mb-2">Questions</div>
        <h2 class="text-3xl font-black text-white tracking-tight">Frequently asked</h2>
      </div>
      <div class="space-y-3">
        {p.faq.map(f => (
          <details class="group rounded-xl overflow-hidden" style="background: rgba(122,171,130,0.03); border: 1px solid rgba(122,171,130,0.1);">
            <summary class="flex items-start justify-between gap-4 px-6 py-5 cursor-pointer list-none">
              <span class="text-white font-bold text-base leading-snug">{f.q}</span>
              <span class="text-gold text-xl flex-shrink-0 mt-0.5 group-open:rotate-45 transition-transform duration-200">+</span>
            </summary>
            <div class="px-6 pb-5">
              <p class="text-cream/65 text-sm leading-relaxed">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-20 px-5 text-center" style="background: linear-gradient(160deg, #0d1a10, #070e08);">
    <div class="max-w-xl mx-auto">
      <div class="eyebrow mb-4">Free · No Obligation · Austin TX</div>
      <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-5">
        Not sure this is the right system?
      </h2>
      <p class="text-cream/60 leading-relaxed mb-8">
        Every equipment order includes a free property consultation. We visit your yard, confirm your trap placement, and make sure your investment performs at its full potential.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <button
          data-id={p.id}
          data-name={p.name}
          data-price={p.price}
          class="btn-gold"
          style="display: inline-block;"
        >
          Add to Cart — ${p.price.toFixed(2)}
        </button>
        <a href="/book" class="btn-outline inline-block">Book Free Assessment</a>
      </div>
      <p class="text-cream/30 text-xs mt-5">or call <a href="tel:5125604129" class="underline hover:text-cream/55 transition-colors">512-560-4129</a></p>
    </div>
  </section>

  <CartDrawer />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Wire all add-to-cart buttons
      document.querySelectorAll('button[data-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          const el = btn as HTMLButtonElement;
          const { id, name, price } = el.dataset;
          if (!id || !name || !price) return;
          (window as any).addToCart(id, name, parseFloat(price));
          const orig = el.textContent!;
          el.textContent = '✓ Added to Cart';
          el.style.background = 'linear-gradient(135deg, #7dffaa, #5ddf8a)';
          setTimeout(() => {
            el.textContent = orig;
            el.style.background = 'linear-gradient(135deg, #d4b45a 0%, #c9a84c 50%, #b8952a 100%)';
          }, 1500);
        });
      });

      // Image gallery thumbnails
      document.querySelectorAll('.img-thumb').forEach(btn => {
        btn.addEventListener('click', () => {
          const src = (btn as HTMLButtonElement).dataset.src;
          const mainImg = document.getElementById('main-product-img') as HTMLImageElement;
          if (src && mainImg) mainImg.src = src;
          // Update active border
          document.querySelectorAll('.img-thumb').forEach(b => {
            (b as HTMLElement).style.borderColor = 'rgba(122,171,130,0.15)';
            (b as HTMLElement).style.borderWidth = '1px';
          });
          (btn as HTMLElement).style.borderColor = 'rgba(201,168,76,0.5)';
          (btn as HTMLElement).style.borderWidth = '2px';
        });
      });

      // Sticky mobile CTA bar
      const mainCta = document.getElementById('main-add-to-cart');
      const stickyBar = document.getElementById('sticky-cart-bar');
      if (mainCta && stickyBar) {
        const observer = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            stickyBar.style.transform = 'translateY(100%)';
          } else {
            stickyBar.style.transform = 'translateY(0)';
          }
        }, { threshold: 0 });
        observer.observe(mainCta);
      }
    });
  </script>

</Base>
