---
import Base from '../layouts/Base.astro';

const faqs = [
  {
    q: 'What is GreenGuard USA?',
    a: 'An Austin-based mosquito control company using CO₂-baited traps instead of pesticides. We rent professional-grade traps, deliver monthly CO₂ tanks, and maintain everything so you don\'t have to.',
  },
  {
    q: 'How do CO₂ mosquito traps work?',
    a: 'Mosquitoes find hosts by tracking the CO₂ in exhaled breath. Our traps release CO₂ at the same rate as a human, plus a secondary attractant. Females are pulled in by a counter-flow fan and trapped in a net.',
  },
  {
    q: 'Why is CO₂ more effective than sprays or zappers?',
    a: 'Sprays kill on contact and wear off in 2–4 weeks. They also kill bees and butterflies. Zappers attract by light, which mosquitoes ignore (they hunt by CO₂). CO₂ traps run 24/7 and target only the females that bite and lay eggs, breaking the breeding cycle.',
  },
  {
    q: 'What areas do you service?',
    a: 'Austin metro: Westlake Hills, Lakeway, Bee Cave, Dripping Springs, Steiner Ranch, Round Rock, Cedar Park, Pflugerville, Leander, Liberty Hill, Georgetown, Kyle, Buda, and surrounding communities.',
  },
  {
    q: 'How long until I see results?',
    a: '7–14 days for noticeable reduction in bites. 4–8 weeks for the breeding cycle to break and population to drop ~93% in field studies. Continuous operation is key: the trap runs 24/7.',
  },
  {
    q: 'Is it safe for kids and pets?',
    a: 'Yes. No pesticides, no toxins, no spray residue. The trap is enclosed and uses only CO₂ + a food-safe lure. Kids and pets can play near it.',
  },
  {
    q: 'Does it kill bees or butterflies?',
    a: 'No. CO₂ traps target only blood-seeking insects (mosquitoes, some midges). Pollinators are not attracted to CO₂ and ignore the trap entirely.',
  },
  {
    q: 'What if I have a creek or pond?',
    a: 'These are high mosquito-pressure properties. We typically recommend bi-weekly service or multiple traps placed along the perimeter. Free assessment first.',
  },
  {
    q: 'Do I need a contract?',
    a: 'No. Month-to-month. Cancel anytime with no penalty.',
  },
  {
    q: 'What\'s included in the monthly fee?',
    a: 'Trap rental, monthly CO₂ tank exchange, quarterly maintenance, lure replacement, and seasonal placement tuning. Texas sales tax (8.25%) is shown on every invoice.',
  },
];
---

<Base
  title="Mosquito Control FAQ | GreenGuard USA"
  description="Answers to common questions about CO₂ mosquito traps, service areas, and how trap-based control works."
>
  <!-- HERO -->
  <section class="bg-gradient-to-br from-bg-card via-bg to-accent-deep/40 py-16 px-5 text-center">
    <div class="max-w-2xl mx-auto">
      <div class="eyebrow mb-2">FAQ</div>
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight mb-4 leading-tight">
        Got questions? <span class="text-accent">We've got answers.</span>
      </h1>
      <p class="text-cream/80 text-base">
        Quick answers to the things most Austin homeowners ask before signing up.
      </p>
    </div>
  </section>

  <!-- FAQ LIST -->
  <section class="py-12 px-5">
    <div class="max-w-3xl mx-auto space-y-3">
      {faqs.map((f, i) => (
        <details class="card group">
          <summary class="cursor-pointer font-bold text-white flex justify-between items-start gap-3">
            <span>{f.q}</span>
            <span class="text-accent text-xl group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-cream/75 mt-3 leading-relaxed text-sm">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-5 bg-bg-panel text-center">
    <div class="max-w-xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Still have questions?</h2>
      <p class="text-cream/75 mb-6">Text or call. We answer within a business day.</p>
      <div class="flex gap-3 justify-center flex-wrap">
        <a href="tel:5125604129" class="btn-gold">512-560-4129</a>
        <a href="/contact" class="btn-outline">Send a message</a>
      </div>
    </div>
  </section>
</Base>
