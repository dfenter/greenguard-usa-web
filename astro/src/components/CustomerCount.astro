---
import { getCustomerCount, formatCount } from '../lib/customers';

const count = await getCustomerCount();
const display = formatCount(count);
---

<div class="inline-flex items-center gap-2.5 bg-bg-card/50 border border-accent/25 rounded-full px-4 py-2">
  <span class="relative flex h-2 w-2">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
  </span>
  <span class="text-cream/80 text-sm">
    Trusted by <strong class="text-accent font-extrabold">{display}</strong> Austin families
  </span>
</div>
