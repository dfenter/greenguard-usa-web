---
const year = new Date().getFullYear();
---

<footer class="bg-[#080f09] mt-20 pt-12 pb-5 px-5">
  <div class="max-w-container mx-auto grid grid-cols-2 md:grid-cols-4 gap-7 pb-7 border-b border-accent/10">
    <div class="col-span-2 md:col-span-1">
      <div class="text-lg font-black text-white">
        Green<span class="text-accent">Guard</span> USA
      </div>
      <div class="text-[0.74rem] text-accent tracking-widest uppercase mt-1.5 mb-2.5">
        Smart. Safe. Effective.
      </div>
      <p class="text-sm text-cream/50 leading-relaxed mb-2.5">
        Pesticide-free CO₂ mosquito control for the Austin area.
      </p>
      <a href="tel:5125604129" class="block text-sm text-cream/65 mb-1">512-560-4129</a>
      <a href="mailto:admin@greenguard-usa.com" class="block text-sm text-cream/65">admin@greenguard-usa.com</a>
    </div>

    <div>
      <div class="text-[0.67rem] tracking-wider uppercase text-cream/40 mb-3 font-bold">Services</div>
      <a href="/services" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">All Services</a>
      <a href="/co2delivery" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">CO₂ Delivery</a>
      <a href="/traprental" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Trap Rental</a>
      <a href="/barrier" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Barrier Treatment</a>
    </div>

    <div>
      <div class="text-[0.67rem] tracking-wider uppercase text-cream/40 mb-3 font-bold">Areas</div>
      <a href="/mosquito-control-westlake-hills" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Westlake Hills</a>
      <a href="/mosquito-control-lakeway" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Lakeway</a>
      <a href="/mosquito-control-bee-cave" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Bee Cave</a>
      <a href="/mosquito-control-cedar-park" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Cedar Park</a>
      <a href="/mosquito-control-round-rock" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Round Rock</a>
    </div>

    <div>
      <div class="text-[0.67rem] tracking-wider uppercase text-cream/40 mb-3 font-bold">Company</div>
      <a href="/about" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">About</a>
      <a href="/blog" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Blog</a>
      <a href="/results" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Results</a>
      <a href="/contact" class="block text-sm text-cream/60 mb-1.5 hover:text-accent">Contact</a>
    </div>
  </div>

  <div class="max-w-container mx-auto mt-4 flex flex-wrap justify-between items-center text-xs text-cream/40 gap-2">
    <span>© {year} GreenGuard USA · 1519 Parkway, Austin TX 78703</span>
    <span class="bg-accent-deep/50 border border-accent/20 rounded-xl px-3 py-0.5 text-[0.69rem] text-cream/55">
      EV Fleet · Pesticide-Free
    </span>
  </div>
</footer>
